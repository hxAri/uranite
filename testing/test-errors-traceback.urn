package testing

from uranite.errors.exception import Exception
from uranite.errors.traceback.traceback import Traceback
from uranite.errors.traceback.frame import Frame
from uranite.io.console import putsln, putsI64

public function raiseNested() -> Void:
    raise new Exception( "nested error", 2, None )

public function raiseFromHelper() -> Void:
    raiseNested()

public function main() -> I32:
    putsln( "Traceback Integration Tests" )

    try:
        raiseFromHelper()
    except Exception as caught:
        ?Traceback maybeTraceback = caught.getTraceback()
        if maybeTraceback is None:
            putsln( "FAIL: traceback is None" )
            return 1
        Traceback traceback = maybeTraceback
        I64 frameCount = traceback.length()
        putsln( "frame count:" )
        putsI64( frameCount )
        if frameCount < 1:
            putsln( "FAIL: expected at least 1 frame" )
            return 1
        putsln( "traceback captured OK" )

        I64 frameIndex = 0
        while frameIndex < frameCount:
            Frame frame = traceback.get( frameIndex )
            putsln( frame.functionName )
            putsI64( frame.line )
            frameIndex = frameIndex + 1

    putsln( "All traceback tests passed" )
    return 0
