package testing

from uranite.io.console import putsln
from uranite.io.filesystem import Pipe
from uranite.memory.memory import Memory
from uranite.testing.assertions import assertEqualI64, assertGreaterThan

public function main() -> I32:
    putsln( "=== IO Pipe Tests ===" )

    Pipe p = new Pipe()
    assertGreaterThan( p.getReadFd(), -1, "readFd valid" )
    assertGreaterThan( p.getWriteFd(), -1, "writeFd valid" )

    I64 written = p.writeString( "pipe data" )
    assertEqualI64( 9, written, "written 9 bytes" )

    Memory<I64> readBuf = new Memory<I64>( 16 )
    I64 n = p.readBytes( readBuf, 9 )
    assertEqualI64( 9, n, "read 9 bytes" )
    assertEqualI64( 112, readBuf.get( 0 ), "first byte p=112" )
    readBuf.free()
    p.close()
    putsln( "pipe OK" )

    putsln( "=== All IO pipe tests passed ===" )
    return 0
