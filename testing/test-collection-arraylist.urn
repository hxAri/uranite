package testing

from uranite.collection.array-list import ArrayList, ArrayListIterator
from uranite.io.console import putsln
from uranite.testing.assertions import assertEqualI64, assertFalse, assertTrue

public function main() -> I32:
    putsln( "=== ArrayList Tests ===" )

    ArrayList<Int> list = new ArrayList<Int>()
    list.add( 10 )
    list.add( 20 )
    list.add( 30 )
    list.add( 40 )
    list.add( 50 )
    assertEqualI64( 5, list.length, "length after 5 adds" )
    putsln( "add OK" )

    assertEqualI64( 10, list.get( 0 ), "get(0)" )
    assertEqualI64( 30, list.get( 2 ), "get(2)" )
    assertEqualI64( 50, list.get( 4 ), "get(4)" )
    putsln( "get OK" )

    list.set( 1, 25 )
    assertEqualI64( 25, list.get( 1 ), "set(1,25)" )
    putsln( "set OK" )

    assertEqualI64( 10, list.first, "first" )
    assertEqualI64( 50, list.last, "last" )
    putsln( "first/last OK" )

    assertEqualI64( 2, list.indexOf( 30 ), "indexOf(30)" )
    list.add( 30 )
    assertEqualI64( 5, list.lastIndexOf( 30 ), "lastIndexOf(30)" )
    putsln( "indexOf OK" )

    assertTrue( list.exists( 40 ), "exists(40)" )
    assertFalse( list.exists( 999 ), "not exists(999)" )
    assertFalse( list.empty, "not empty" )
    putsln( "exists/empty OK" )

    list.insert( 2, 27 )
    assertEqualI64( 27, list.get( 2 ), "insert(2,27)" )

    Int removed = list.removeAt( 2 )
    assertEqualI64( 27, removed, "removeAt(2)" )

    Int first = list.removeFirst()
    assertEqualI64( 10, first, "removeFirst" )

    Int last = list.removeLast()
    assertEqualI64( 30, last, "removeLast" )

    Boolean didRemove = list.removeElement( 25 )
    assertTrue( didRemove, "removeElement(25)" )
    putsln( "remove ops OK" )

    list.add( 99 )
    Boolean didRemove2 = list.remove( 99 )
    assertTrue( didRemove2, "remove(99)" )
    putsln( "remove collection OK" )

    # clear
    ArrayList<Int> clearList = new ArrayList<Int>()
    clearList.add( 1 )
    clearList.add( 2 )
    clearList.clear()
    assertEqualI64( 0, clearList.length, "clear length" )
    assertTrue( clearList.empty, "clear empty" )
    putsln( "clear OK" )

    # addAll
    ArrayList<Int> src = new ArrayList<Int>()
    src.add( 100 )
    src.add( 200 )
    ArrayList<Int> dest = new ArrayList<Int>()
    dest.addAll( src )
    assertEqualI64( 2, dest.length, "addAll length" )
    assertEqualI64( 100, dest.get( 0 ), "addAll get(0)" )
    assertEqualI64( 200, dest.get( 1 ), "addAll get(1)" )
    putsln( "addAll OK" )

    # swap
    dest.swap( 0, 1 )
    assertEqualI64( 200, dest.get( 0 ), "swap get(0)" )
    assertEqualI64( 100, dest.get( 1 ), "swap get(1)" )

    # reverse
    dest.reverse()
    assertEqualI64( 100, dest.get( 0 ), "reverse get(0)" )
    assertEqualI64( 200, dest.get( 1 ), "reverse get(1)" )
    putsln( "swap/reverse OK" )

    # fill
    ArrayList<Int> fillList = new ArrayList<Int>()
    fillList.add( 0 )
    fillList.add( 0 )
    fillList.add( 0 )
    fillList.fill( 42 )
    assertEqualI64( 42, fillList.get( 0 ), "fill get(0)" )
    assertEqualI64( 42, fillList.get( 1 ), "fill get(1)" )
    assertEqualI64( 42, fillList.get( 2 ), "fill get(2)" )
    putsln( "fill OK" )

    # resize
    fillList.resize( 2 )
    assertEqualI64( 2, fillList.length, "resize length" )
    putsln( "resize OK" )

    # sort
    ArrayList<Int> sortList = new ArrayList<Int>()
    sortList.add( 30 )
    sortList.add( 10 )
    sortList.add( 20 )
    sortList.sort()
    assertEqualI64( 10, sortList.get( 0 ), "sort [0]" )
    assertEqualI64( 20, sortList.get( 1 ), "sort [1]" )
    assertEqualI64( 30, sortList.get( 2 ), "sort [2]" )
    putsln( "sort OK" )

    # subSequence
    ArrayList<Int> sub = sortList.subSequence( 0, 2 )
    assertEqualI64( 2, sub.length, "subSequence length" )
    assertEqualI64( 10, sub.get( 0 ), "subSequence [0]" )
    assertEqualI64( 20, sub.get( 1 ), "subSequence [1]" )

    # slice
    ArrayList<Int> sliced = sortList.slice( 1, 3 )
    assertEqualI64( 2, sliced.length, "slice length" )
    assertEqualI64( 20, sliced.get( 0 ), "slice [0]" )
    assertEqualI64( 30, sliced.get( 1 ), "slice [1]" )
    putsln( "subSequence/slice OK" )

    # reversed property
    ArrayList<Int> rev = sortList.reversed
    assertEqualI64( 30, rev.get( 0 ), "reversed [0]" )
    assertEqualI64( 20, rev.get( 1 ), "reversed [1]" )
    assertEqualI64( 10, rev.get( 2 ), "reversed [2]" )

    # copy property
    ArrayList<Int> cp = sortList.copy
    assertEqualI64( 3, cp.length, "copy length" )
    assertEqualI64( 10, cp.get( 0 ), "copy [0]" )
    putsln( "reversed/copy OK" )

    # equals
    ArrayList<Int> eq1 = new ArrayList<Int>()
    eq1.add( 1 )
    eq1.add( 2 )
    ArrayList<Int> eq2 = new ArrayList<Int>()
    eq2.add( 1 )
    eq2.add( 2 )
    assertTrue( eq1.equals( eq2 ), "equals" )
    putsln( "equals OK" )

    # iterator
    ArrayList<Int> itList = new ArrayList<Int>()
    itList.add( 10 )
    itList.add( 20 )
    itList.add( 30 )
    ArrayListIterator<Int> it = itList.iterator
    I64 iterSum = 0
    while it.has:
        Int val = it.next
        iterSum = iterSum + val
    assertEqualI64( 60, iterSum, "iterator sum" )
    putsln( "iterator OK" )

    putsln( "=== All ArrayList tests passed ===" )
    return 0
