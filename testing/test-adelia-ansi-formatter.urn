package testing

from uranite.adelia.ansi-formatter import AnsiFormatter
from uranite.io.console import putsln
from uranite.testing.assertions import assertEqualStr, assertTrue

public function main() -> I32:
    putsln( "Adelia AnsiFormatter Tests" )
    String fg = AnsiFormatter.foreground( 255, 0, 0 )
    assertTrue( fg != "", "foreground not empty" )
    putsln( "foreground OK" )
    String bg = AnsiFormatter.background( 0, 255, 0 )
    assertTrue( bg != "", "background not empty" )
    putsln( "background OK" )
    String colored = AnsiFormatter.colorize( "hello", 255, 128, 0 )
    assertTrue( colored != "", "colorize not empty" )
    putsln( "colorize OK" )
    String highlighted = AnsiFormatter.highlight( "world", 0, 0, 255 )
    assertTrue( highlighted != "", "highlight not empty" )
    putsln( "highlight OK" )
    String styled = AnsiFormatter.style( "text", 255, 255, 255, 0, 0, 0 )
    assertTrue( styled != "", "style not empty" )
    putsln( "style OK" )
    String rst = AnsiFormatter.reset()
    assertTrue( rst != "", "reset not empty" )
    putsln( "reset OK" )
    String fgHex = AnsiFormatter.foregroundHex( 16711680 )
    assertTrue( fgHex != "", "foregroundHex not empty" )
    putsln( "foregroundHex OK" )
    String bgHex = AnsiFormatter.backgroundHex( 65280 )
    assertTrue( bgHex != "", "backgroundHex not empty" )
    putsln( "backgroundHex OK" )
    String coloredHex = AnsiFormatter.colorizeHex( "test", 255 )
    assertTrue( coloredHex != "", "colorizeHex not empty" )
    putsln( "colorizeHex OK" )
    putsln( "All AnsiFormatter tests passed" )
    return 0
