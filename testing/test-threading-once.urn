package testing

from uranite.io.console import putsln
from uranite.testing.assertions import assertFalse
from uranite.threading.once import Once

public function main() -> I32:
    putsln( "Threading Once Tests" )
    Once o = new Once()
    assertFalse( o.isCompleted(), "initially not completed" )
    putsln( "isCompleted OK" )
    o.destroy()
    putsln( "destroy OK" )
    putsln( "All once tests passed" )
    return 0
