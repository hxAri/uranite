package testing

from uranite.threading.future import {
    FutureBase, Future, FutureState,
    FUTURE_PENDING, FUTURE_FINISHED
}
from uranite.os.scheduler.scheduler import Scheduler
from uranite.testing.assertions import {
    assertEqualI64, assertTrue, assertFalse
}
from uranite.io.console import putsln

public function main() -> I32:
    putsln( "=== Threading Future Tests ===" )

    Scheduler sched = new Scheduler()

    # FutureBase initial state
    FutureBase base = new FutureBase( sched )
    assertFalse( base.isDone(), "initially not done" )
    putsln( "initial state OK" )

    # completeRaw
    base.completeRaw( 42 )
    assertTrue( base.isDone(), "done after complete" )
    assertEqualI64( 42, base.getRawResult(), "result 42" )
    putsln( "completeRaw OK" )

    base.destroy()
    putsln( "destroy OK" )

    # Future wrapper
    FutureBase base2 = new FutureBase( sched )
    Future<I64> future = new Future<I64>( base2 )
    assertFalse( future.isDone(), "future not done" )
    future.destroy()
    putsln( "Future wrapper OK" )

    putsln( "=== All future tests passed ===" )
    return 0
