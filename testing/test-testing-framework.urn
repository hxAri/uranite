package testing

from uranite.io.console import putsln
from uranite.testing.assertions import {
    assertBetween,
    assertEqualF64,
    assertEqualI64,
    assertEqualStr,
    assertFalse,
    assertGreaterThan,
    assertLessThan,
    assertNotEqualI64,
    assertNotEqualStr,
    assertTrue
}
from uranite.testing.result import TestResult
from uranite.testing.runner import TestRunner
from uranite.testing.test-case import TestCase

public function main() -> I32:
    putsln( "Testing Framework Tests" )
    assertTrue( True, "true should be true" )
    assertFalse( False, "false should be false" )
    assertEqualI64( 42, 42, "42 == 42" )
    assertNotEqualI64( 1, 2, "1 != 2" )
    assertEqualStr( "hello", "hello", "hello == hello" )
    assertNotEqualStr( "a", "b", "a != b" )
    assertGreaterThan( 10, 5, "10 > 5" )
    assertLessThan( 3, 7, "3 < 7" )
    assertBetween( 5, 0, 10, "5 in [0,10]" )
    putsln( "standalone assertions OK" )
    TestCase tc = new TestCase( "basic" )
    tc.assertTrue( True, "assert in testcase" )
    tc.assertEqualI64( 10, 10, "equal ints" )
    tc.assertEqualStr( "abc", "abc", "equal strings" )
    tc.assertGreaterThan( 100, 50, "100 > 50" )
    putsln( "TestCase OK" )
    TestResult passResult = new TestResult( "test1", 0, "" )
    TestResult failResult = new TestResult( "test2", 1, "something failed" )
    putsln( "TestResult OK" )
    TestRunner runner = new TestRunner()
    runner.recordPass( "add_test" )
    runner.recordPass( "sub_test" )
    runner.recordFail( "div_test", "division error" )
    runner.report()
    assertFalse( runner.allPassed(), "not all passed" )
    putsln( "TestRunner OK" )
    putsln( "All testing framework tests passed" )
    return 0
