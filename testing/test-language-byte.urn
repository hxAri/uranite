package testing

from uranite.io.console import putsln
from uranite.language.byte import Byte
from uranite.testing.assertions import assertEqualI64

public function main() -> I32:
    putsln( "Byte Tests" )
    Byte a = new Byte( 170 )
    Byte b = new Byte( 85 )
    assertEqualI64( 170, a.getValue() as I64, "getValue" )
    putsln( "getValue OK" )
    Byte andResult = a.bitwiseAnd( b )
    assertEqualI64( 0, andResult.getValue() as I64, "bitwiseAnd" )
    Byte orResult = a.bitwiseOr( b )
    assertEqualI64( 255, orResult.getValue() as I64, "bitwiseOr" )
    Byte xorResult = a.bitwiseXor( b )
    assertEqualI64( 255, xorResult.getValue() as I64, "bitwiseXor" )
    putsln( "bitwise OK" )
    Byte one = new Byte( 1 )
    Byte shifted = one.shiftLeft( 4 )
    assertEqualI64( 16, shifted.getValue() as I64, "shiftLeft(1,4)" )
    Byte sixteen = new Byte( 16 )
    Byte rshifted = sixteen.shiftRight( 2 )
    assertEqualI64( 4, rshifted.getValue() as I64, "shiftRight(16,2)" )
    putsln( "shift OK" )
    putsln( "All Byte tests passed" )
    return 0
