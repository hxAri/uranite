package testing

from uranite.operators.multipliable import Multipliable
from uranite.testing.assertions import assertEqualI64
from uranite.io.console import putsln

public class Val implements Multipliable<Val>:
    public Int value

    public function Val( self, Int value ) -> Void:
        self.value = value

    public function multiply( self, Val other ) -> Val:
        return new Val( self.value * other.value )

public function main() -> I32:
    putsln( "=== Multipliable Tests ===" )

    Val a = new Val( 7 )
    Val b = new Val( 6 )

    Val c = a.multiply( b )
    assertEqualI64( 42, c.value, "7*6=42" )

    Val zero = new Val( 0 )
    Val d = a.multiply( zero )
    assertEqualI64( 0, d.value, "multiply by zero" )

    Val one = new Val( 1 )
    Val e = a.multiply( one )
    assertEqualI64( 7, e.value, "multiply by one" )

    Val neg = new Val( -3 )
    Val f = a.multiply( neg )
    assertEqualI64( -21, f.value, "multiply negative" )
    putsln( "multiply OK" )

    putsln( "=== All Multipliable tests passed ===" )
    return 0
