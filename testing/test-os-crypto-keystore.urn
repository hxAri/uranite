package testing

from uranite.os.crypto.keystore import KeyType, KeyState, KeyStore
from uranite.testing.assertions import {
    assertEqualI64, assertTrue, assertFalse
}
from uranite.io.console import putsln

public function main() -> I32:
    putsln( "=== OS Crypto Keystore Tests ===" )

    assertEqualI64( 1, KeyType.Symmetric as I64, "Symmetric" )
    assertEqualI64( 2, KeyType.Private as I64, "Private" )
    assertEqualI64( 3, KeyType.Public as I64, "Public" )
    assertEqualI64( 4, KeyType.Hmac as I64, "Hmac" )
    assertEqualI64( 1, KeyState.Active as I64, "Active" )
    assertEqualI64( 2, KeyState.Revoked as I64, "Revoked" )
    putsln( "enums OK" )

    KeyStore ks = new KeyStore( 4 )
    assertEqualI64( 4, ks.capacity, "capacity" )
    assertEqualI64( 0, ks.getCount(), "count 0" )

    I64 id1 = ks.store( 1, 100, 11, 22, 33, 44 )
    assertEqualI64( 0, id1, "store id1" )
    assertEqualI64( 1, ks.getCount(), "count 1" )
    assertEqualI64( 1, ks.getKeyType( 0 ), "keyType" )
    assertEqualI64( 1, ks.getKeyState( 0 ), "keyState active" )
    assertTrue( ks.isOwner( 0, 100 ), "isOwner true" )
    assertFalse( ks.isOwner( 0, 999 ), "isOwner false" )
    putsln( "store OK" )

    I64 id2 = ks.store( 2, 200, 55, 66, 77, 88 )
    assertEqualI64( 1, id2, "store id2" )

    Boolean revOk = ks.revoke( 0 )
    assertTrue( revOk, "revoke success" )
    assertEqualI64( 2, ks.getKeyState( 0 ), "revoked state" )
    putsln( "revoke OK" )

    Boolean destOk = ks.destroyKey( 0 )
    assertTrue( destOk, "destroyKey success" )
    assertEqualI64( 0, ks.getKeyState( 0 ), "destroyed state" )
    putsln( "destroyKey OK" )

    ks.destroy()

    putsln( "=== All keystore tests passed ===" )
    return 0
