package testing

from uranite.adelia.math-externs import {
    sqrt, fabs, fmod, floor, ceil, round, pow
}
from uranite.testing.assertions import assertEqualF64
from uranite.io.console import putsln

public function main() -> I32:
    putsln( "=== Adelia Math Externs Tests ===" )

    # sqrt
    assertEqualF64( 2.0, sqrt( 4.0 ), 0.0001, "sqrt(4)" )
    assertEqualF64( 0.0, sqrt( 0.0 ), 0.0001, "sqrt(0)" )
    putsln( "sqrt OK" )

    # fabs
    assertEqualF64( 3.14, fabs( -3.14 ), 0.0001, "fabs(-3.14)" )
    assertEqualF64( 3.14, fabs( 3.14 ), 0.0001, "fabs(3.14)" )
    assertEqualF64( 0.0, fabs( 0.0 ), 0.0001, "fabs(0)" )
    putsln( "fabs OK" )

    # fmod
    assertEqualF64( 1.5, fmod( 10.5, 3.0 ), 0.0001, "fmod(10.5,3)" )
    assertEqualF64( -1.5, fmod( -10.5, 3.0 ), 0.0001, "fmod(-10.5,3)" )
    putsln( "fmod OK" )

    # floor
    assertEqualF64( 3.0, floor( 3.7 ), 0.0001, "floor(3.7)" )
    assertEqualF64( -4.0, floor( -3.7 ), 0.0001, "floor(-3.7)" )
    assertEqualF64( 5.0, floor( 5.0 ), 0.0001, "floor(5.0)" )
    putsln( "floor OK" )

    # ceil
    assertEqualF64( 4.0, ceil( 3.2 ), 0.0001, "ceil(3.2)" )
    assertEqualF64( -3.0, ceil( -3.2 ), 0.0001, "ceil(-3.2)" )
    putsln( "ceil OK" )

    # round
    assertEqualF64( 4.0, round( 3.5 ), 0.0001, "round(3.5)" )
    assertEqualF64( 3.0, round( 3.4 ), 0.0001, "round(3.4)" )
    assertEqualF64( -4.0, round( -3.5 ), 0.0001, "round(-3.5)" )
    putsln( "round OK" )

    # pow
    assertEqualF64( 1024.0, pow( 2.0, 10.0 ), 0.0001, "pow(2,10)" )
    assertEqualF64( 1.0, pow( 3.0, 0.0 ), 0.0001, "pow(3,0)" )
    assertEqualF64( 0.5, pow( 2.0, -1.0 ), 0.0001, "pow(2,-1)" )
    putsln( "pow OK" )

    putsln( "=== All math externs tests passed ===" )
    return 0
