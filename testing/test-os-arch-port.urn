package testing

from uranite.os.arch.x86-64.port import {
    outb, inb, outw, inw, outl, inl, ioWait
}
from uranite.testing.assertions import assertEqualI64
from uranite.io.console import putsln

public function main() -> I32:
    putsln( "=== OS Arch Port Tests ===" )

    assertEqualI64( 1, 1, "port functions imported" )
    putsln( "imports OK" )

    putsln( "=== All port tests passed ===" )
    return 0
