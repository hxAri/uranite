package testing

from uranite.io.console import putsln
from uranite.language.boolean import Boolean
from uranite.testing.assertions import assertFalse, assertTrue

public function main() -> I32:
    putsln( "Boolean Tests" )
    Boolean t = new Boolean( True )
    Boolean f = new Boolean( False )
    assertTrue( t.getValue(), "getValue true" )
    assertFalse( f.getValue(), "getValue false" )
    putsln( "getValue OK" )
    Boolean negT = t.negate()
    Boolean negF = f.negate()
    assertFalse( negT.getValue(), "negate true" )
    assertTrue( negF.getValue(), "negate false" )
    putsln( "negate OK" )
    Boolean andTT = t.logicalAnd( t )
    Boolean andTF = t.logicalAnd( f )
    Boolean andFF = f.logicalAnd( f )
    assertTrue( andTT.getValue(), "and(T,T)" )
    assertFalse( andTF.getValue(), "and(T,F)" )
    assertFalse( andFF.getValue(), "and(F,F)" )
    putsln( "logicalAnd OK" )
    Boolean orTT = t.logicalOr( t )
    Boolean orTF = t.logicalOr( f )
    Boolean orFF = f.logicalOr( f )
    assertTrue( orTT.getValue(), "or(T,T)" )
    assertTrue( orTF.getValue(), "or(T,F)" )
    assertFalse( orFF.getValue(), "or(F,F)" )
    putsln( "logicalOr OK" )
    putsln( "All Boolean tests passed" )
    return 0
