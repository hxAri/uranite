package testing

from uranite.crypto.keystore import SecureKeyStore
from uranite.io.console import putsln
from uranite.testing.assertions import assertEqualI64, assertTrue

public function main() -> I32:
    putsln( "=== Crypto Keystore Tests ===" )

    SecureKeyStore store = new SecureKeyStore( 16 )
    assertEqualI64( 0, store.getCount(), "empty initially" )
    putsln( "SecureKeyStore constructed OK" )

    I64 slot = store.storeKey( 1, 42, 111, 222, 333, 444 )
    assertEqualI64( 1, store.getCount(), "count after store" )
    assertTrue( store.isOwner( slot, 42 ), "owner check" )
    putsln( "storeKey OK" )

    Boolean revoked = store.revokeKey( slot )
    assertTrue( revoked, "revoke OK" )
    putsln( "revokeKey OK" )

    store.destroy()
    putsln( "destroy OK" )

    putsln( "=== All Crypto Keystore Tests Passed ===" )
    return 0
