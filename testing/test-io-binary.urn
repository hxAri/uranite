package testing

from uranite.io.binary-reader import BinaryReader
from uranite.io.binary-writer import BinaryWriter
from uranite.io.console import putsln
from uranite.io.file import File, createFile, openFile
from uranite.sys.process import exit
from uranite.testing.assertions import assertEqualI64

public function main() -> I32:
    putsln( "IO Binary Tests" )
    File wf = createFile( "/tmp/uranite-test-binary.bin", 420 )
    BinaryWriter bw = new BinaryWriter( wf.getFd(), False )
    bw.writeU8( 42 )
    bw.writeI16( -1000 )
    bw.writeI32( 123456 )
    bw.writeI64( 9876543210 )
    bw.close()
    wf.close()
    File rf = openFile( "/tmp/uranite-test-binary.bin" )
    BinaryReader br = new BinaryReader( rf.getFd(), False )
    assertEqualI64( 42, br.readU8(), "readU8" )
    assertEqualI64( -1000, br.readI16(), "readI16" )
    assertEqualI64( 123456, br.readI32(), "readI32" )
    assertEqualI64( 9876543210, br.readI64(), "readI64" )
    br.close()
    rf.close()
    putsln( "binary read/write OK" )
    putsln( "All IO binary tests passed" )
    exit( 0 )
    return 0
