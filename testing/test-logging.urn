package testing

from uranite.io.console import putsln
from uranite.logging.formatter import LogFormatter, defaultFormatter, detailedFormatter, simpleFormatter
from uranite.logging.handler import ConsoleHandler, consoleHandler, consoleHandlerWithLevel
from uranite.logging.level import LogLevel
from uranite.logging.logger import Logger, getDebugLogger, getLogger
from uranite.testing.assertions import assertEqualStr, assertFalse, assertGreaterThan, assertTrue

public function main() -> I32:
    putsln( "Logging Tests" )
    assertEqualStr( "Trace", LogLevel.Trace.name, "Trace name" )
    assertEqualStr( "Debug", LogLevel.Debug.name, "Debug name" )
    assertEqualStr( "Info", LogLevel.Info.name, "Info name" )
    assertEqualStr( "Warn", LogLevel.Warn.name, "Warn name" )
    assertEqualStr( "Error", LogLevel.Error.name, "Error name" )
    assertEqualStr( "Fatal", LogLevel.Fatal.name, "Fatal name" )
    putsln( "LogLevel.name OK" )
    Logger log = getLogger( "test" )
    Logger dlog = getDebugLogger( "debug-test" )
    putsln( "getLogger/getDebugLogger OK" )
    assertTrue( log.isEnabled( LogLevel.Info ), "Info enabled" )
    log.setLevel( LogLevel.Debug )
    assertTrue( log.isEnabled( LogLevel.Debug ), "Debug enabled after setLevel" )
    putsln( "isEnabled/setLevel OK" )
    log.info( "test info message" )
    log.warn( "test warn message" )
    log.debug( "test debug message" )
    putsln( "log output OK" )
    LogFormatter fmt = defaultFormatter()
    String fmtResult = fmt.format( LogLevel.Info, "test", "hello" )
    assertTrue( fmtResult != "", "formatted not empty" )
    putsln( "LogFormatter OK" )
    ConsoleHandler ch = consoleHandler()
    ch.handle( LogLevel.Info, "handler-test", "handler output" )
    putsln( "ConsoleHandler OK" )
    ConsoleHandler ch2 = consoleHandlerWithLevel( LogLevel.Warn )
    ch2.handle( LogLevel.Debug, "filtered", "should not appear" )
    ch2.handle( LogLevel.Warn, "filtered", "should appear" )
    putsln( "ConsoleHandler level filter OK" )
    putsln( "All logging tests passed" )
    return 0
