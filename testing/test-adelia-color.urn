package testing

from uranite.adelia.cmyk import CMYK
from uranite.adelia.color import Color
from uranite.adelia.hsl import HSL
from uranite.adelia.hsv import HSV
from uranite.adelia.rgb import RGB
from uranite.io.console import putsln
from uranite.testing.assertions import assertEqualF64, assertEqualI64, assertFalse, assertTrue

public function main() -> I32:
    putsln( "Adelia Color Tests" )
    Color color = new Color( 19273 )
    assertEqualI64( 0, color.red, "red" )
    assertEqualI64( 75, color.green, "green" )
    assertEqualI64( 73, color.blue, "blue" )
    assertEqualI64( 19273, color.hexValue, "hexValue" )
    putsln( "constructor OK" )
    RGB rgb = color.toRgb
    assertEqualI64( 0, rgb.red, "toRgb red" )
    assertEqualI64( 75, rgb.green, "toRgb green" )
    assertEqualI64( 73, rgb.blue, "toRgb blue" )
    putsln( "toRgb OK" )
    HSL hsl = color.toHsl
    assertTrue( hsl.hue >= 0.0, "toHsl hue >= 0" )
    putsln( "toHsl OK" )
    HSV hsv = color.toHsv
    assertTrue( hsv.value >= 0.0, "toHsv value >= 0" )
    putsln( "toHsv OK" )
    CMYK cmyk = color.toCmyk
    assertTrue( cmyk.key >= 0.0, "toCmyk key >= 0" )
    putsln( "toCmyk OK" )
    String cssHex = color.cssHex
    assertTrue( cssHex != "", "cssHex not empty" )
    putsln( "cssHex OK" )
    String cssRgb = color.cssRgb
    assertTrue( cssRgb != "", "cssRgb not empty" )
    putsln( "cssRgb OK" )
    String cssHsl = color.cssHsl
    assertTrue( cssHsl != "", "cssHsl not empty" )
    putsln( "cssHsl OK" )
    String ansFg = color.ansiForeground
    assertTrue( ansFg != "", "ansiFg not empty" )
    String ansBg = color.ansiBackground
    assertTrue( ansBg != "", "ansBg not empty" )
    putsln( "ansi OK" )
    String colorized = color.ansiColorize( "hello" )
    assertTrue( colorized != "", "colorized not empty" )
    putsln( "ansiColorize OK" )
    Color comp = color.complementary
    assertTrue( comp.hexValue >= 0, "complementary hex >= 0" )
    putsln( "complementary OK" )
    Color safe = color.webSafe
    assertTrue( safe.hexValue >= 0, "webSafe hex >= 0" )
    putsln( "webSafe OK" )
    Color same = new Color( 19273 )
    assertEqualF64( 0.0, color.distanceTo( same ), 0.0001, "distanceTo self" )
    putsln( "distanceTo OK" )
    assertTrue( color.equals( same ), "equals same" )
    Color red = new Color( 16711680 )
    assertFalse( color.equals( red ), "equals diff" )
    putsln( "equals OK" )
    String str = color.toString()
    assertTrue( str != "", "toString not empty" )
    putsln( "toString OK" )
    Color fromRgb = Color.fromRgb( 255, 128, 0 )
    assertEqualI64( 255, fromRgb.red, "fromRgb red" )
    assertEqualI64( 128, fromRgb.green, "fromRgb green" )
    assertEqualI64( 0, fromRgb.blue, "fromRgb blue" )
    putsln( "fromRgb OK" )
    Color fromHsl = Color.fromHsl( 0.0, 1.0, 0.5 )
    assertEqualI64( 255, fromHsl.red, "fromHsl red" )
    putsln( "fromHsl OK" )
    Color fromHsv = Color.fromHsv( 120.0, 1.0, 1.0 )
    assertEqualI64( 0, fromHsv.red, "fromHsv red" )
    assertEqualI64( 255, fromHsv.green, "fromHsv green" )
    putsln( "fromHsv OK" )
    Color fromCmyk = Color.fromCmyk( 0.0, 1.0, 1.0, 0.0 )
    assertEqualI64( 255, fromCmyk.red, "fromCmyk red" )
    assertEqualI64( 0, fromCmyk.green, "fromCmyk green" )
    putsln( "fromCmyk OK" )
    putsln( "All Color tests passed" )
    return 0
