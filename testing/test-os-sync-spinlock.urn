package testing

from uranite.io.console import putsln
from uranite.os.sync.spinlock import Spinlock
from uranite.testing.assertions import assertFalse

public function main() -> I32:
    putsln( "OS Sync Spinlock Tests" )
    Spinlock lock = new Spinlock()
    assertFalse( lock.isLocked(), "not locked" )
    putsln( "Spinlock OK" )
    putsln( "All spinlock tests passed" )
    return 0
