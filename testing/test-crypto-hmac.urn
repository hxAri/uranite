package testing

from uranite.crypto.hmac import hmacSha256, hmacSha512
from uranite.encoding.binary import readI8, writeI8
from uranite.io.console import putsln
from uranite.memory.allocator import alloc, dealloc
from uranite.testing.assertions import assertEqualI64, assertNotEqualI64, assertTrue

public function main() -> I32:
    putsln( "=== Crypto HMAC Tests ===" )

    # HMAC-SHA-256 with RFC 4231 Test Case 2:
    # Key = "Jefe" (0x4a656665), Data = "what do ya want for nothing?" (28 bytes)
    # Expected: 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843
    I64 keyAddress = alloc( 4 )
    writeI8( keyAddress, 0, 0x4a )
    writeI8( keyAddress, 1, 0x65 )
    writeI8( keyAddress, 2, 0x66 )
    writeI8( keyAddress, 3, 0x65 )

    I64 dataAddress = alloc( 28 )
    # "what do ya want for nothing?"
    I64 messageBytes = alloc( 28 )
    writeI8( messageBytes, 0, 0x77 )
    writeI8( messageBytes, 1, 0x68 )
    writeI8( messageBytes, 2, 0x61 )
    writeI8( messageBytes, 3, 0x74 )
    writeI8( messageBytes, 4, 0x20 )
    writeI8( messageBytes, 5, 0x64 )
    writeI8( messageBytes, 6, 0x6f )
    writeI8( messageBytes, 7, 0x20 )
    writeI8( messageBytes, 8, 0x79 )
    writeI8( messageBytes, 9, 0x61 )
    writeI8( messageBytes, 10, 0x20 )
    writeI8( messageBytes, 11, 0x77 )
    writeI8( messageBytes, 12, 0x61 )
    writeI8( messageBytes, 13, 0x6e )
    writeI8( messageBytes, 14, 0x74 )
    writeI8( messageBytes, 15, 0x20 )
    writeI8( messageBytes, 16, 0x66 )
    writeI8( messageBytes, 17, 0x6f )
    writeI8( messageBytes, 18, 0x72 )
    writeI8( messageBytes, 19, 0x20 )
    writeI8( messageBytes, 20, 0x6e )
    writeI8( messageBytes, 21, 0x6f )
    writeI8( messageBytes, 22, 0x74 )
    writeI8( messageBytes, 23, 0x68 )
    writeI8( messageBytes, 24, 0x69 )
    writeI8( messageBytes, 25, 0x6e )
    writeI8( messageBytes, 26, 0x67 )
    writeI8( messageBytes, 27, 0x3f )

    I64 hmac256Output = alloc( 32 )
    hmacSha256( keyAddress, 4, messageBytes, 28, hmac256Output )
    assertEqualI64( 0x5b, readI8( hmac256Output, 0 ), "HMAC-SHA256 byte 0" )
    assertEqualI64( -36, readI8( hmac256Output, 1 ), "HMAC-SHA256 byte 1 (0xdc)" )
    assertEqualI64( -63, readI8( hmac256Output, 2 ), "HMAC-SHA256 byte 2 (0xc1)" )
    assertEqualI64( 0x46, readI8( hmac256Output, 3 ), "HMAC-SHA256 byte 3" )
    putsln( "HMAC-SHA-256 RFC 4231 test case 2 OK" )

    I64 hmac256Again = alloc( 32 )
    hmacSha256( keyAddress, 4, messageBytes, 28, hmac256Again )
    I64 byteIndex = 0
    while byteIndex < 32:
        assertEqualI64( readI8( hmac256Output, byteIndex ), readI8( hmac256Again, byteIndex ), "deterministic" )
        byteIndex = byteIndex + 1
    putsln( "HMAC-SHA-256 deterministic OK" )

    I64 hmac512Output = alloc( 64 )
    hmacSha512( keyAddress, 4, messageBytes, 28, hmac512Output )
    assertTrue( hmac512Output > 0, "HMAC-SHA-512 produces output" )
    assertNotEqualI64( readI8( hmac256Output, 0 ), readI8( hmac512Output, 0 ), "SHA-256 vs SHA-512 differ" )
    putsln( "HMAC-SHA-512 OK" )

    dealloc( keyAddress )
    dealloc( dataAddress )
    dealloc( messageBytes )
    dealloc( hmac256Output )
    dealloc( hmac256Again )
    dealloc( hmac512Output )

    putsln( "=== All Crypto HMAC Tests Passed ===" )
    return 0
