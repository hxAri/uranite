# Uranite Formal Grammar (PEG)
# Inspired by Python's PEG grammar (PEP 617)
# Refined for Uranite Specification (2026)

@ast_node_base 'ast::Node'

# ==========================================
# Top-level rules
# ==========================================

program:
    | [package_decl] [statements] ENDMARKER 

package_decl:
    | 'package' name=dotted_name NEWLINE 

dotted_name:
    | IDENTIFIER ('.' IDENTIFIER)*

statements:
    | statement+

statement:
    | compound_stmt
    | simple_stmt

simple_stmt:
    | (import_stmt | extern_stmt | type_alias_stmt | var_decl | assignment | expression_stmt | return_stmt | break_stmt | continue_stmt | delete_stmt | raise_stmt | defer_stmt | yield_stmt | pass_stmt | asm_stmt) NEWLINE
    | NEWLINE

compound_stmt:
    | function_def
    | class_def
    | struct_def
    | enum_def
    | interface_def
    | trait_def
    | implement_def
    | if_stmt
    | while_stmt
    | for_stmt
    | match_stmt
    | switch_stmt
    | try_stmt
    | with_stmt
    | unsafe_block
    | export_block

# ==========================================
# Declarations
# ==========================================

import_stmt:
    | access_modifier? 'import' dotted_name ['as' IDENTIFIER]
    | access_modifier? 'from' dotted_name 'import' ('*' | '{' ','.import_item+ '}' | import_item)

import_item:
    | IDENTIFIER ['as' IDENTIFIER]

extern_stmt:
    | 'extern' 'function' IDENTIFIER '(' [params] ')' ['->' type] ';'

function_def:
    | modifiers 'function' IDENTIFIER [generic_params] '(' [params] ')' ['->' type] ['raises' '|'.type+] [':' block]

class_def:
    | modifiers 'class' IDENTIFIER [generic_params] ['extends' type] ['implements' ','.type+] [':' block | ';']

struct_def:
    | modifiers 'struct' IDENTIFIER [generic_params] [':' block | ';']

enum_def:
    | modifiers 'enum' IDENTIFIER ['backed' type] ':' INDENT enum_variant+ DEDENT

enum_variant:
    | 'unit' IDENTIFIER [expression]

interface_def:
    | modifiers 'interface' IDENTIFIER [generic_params] ['extends' ','.type+] [':' block | ';']

trait_def:
    | modifiers 'trait' IDENTIFIER [generic_params] ':' block

implement_def:
    | 'implements' [generic_params] type 'for' type ':' block

type_alias_stmt:
    | modifiers 'type' IDENTIFIER [generic_params] '=' type

# ==========================================
# OOP & Modifiers
# ==========================================

modifiers:
    | access_modifier? oop_modifier*

access_modifier:
    | 'public' | 'private' | 'protect'

oop_modifier:
    | 'virtual' | 'override' | 'abstract' | 'static' | 'final' | 'Readonly' | 'const' | 'async' | 'property' | 'native'

# ==========================================
# Control Flow
# ==========================================

if_stmt:
    | 'if' expression ':' block elif_clause* [else_clause]

elif_clause:
    | 'elif' expression ':' block

else_clause:
    | 'else' ':' block

while_stmt:
    | 'while' expression ':' block

for_stmt:
    | 'for' var_decl ';' expression ';' expression ':' block
    | 'for' [type] IDENTIFIER 'in' expression ':' block

match_stmt:
    | 'match' expression ':' INDENT match_case+ DEDENT

match_case:
    | pattern '=>' (block | simple_stmt)

switch_stmt:
    | 'switch' expression ':' INDENT switch_case+ DEDENT

switch_case:
    | 'case' pattern ':' block

pattern:
    | IDENTIFIER ['.' IDENTIFIER]
    | literal
    | '*'

try_stmt:
    | 'try' ':' block except_clause+ [finally_clause]

except_clause:
    | 'except' [type ['as' IDENTIFIER]] ':' block

finally_clause:
    | 'finally' ':' block

with_stmt:
    | 'with' expression ':' block

unsafe_block:
    | 'unsafe' ':' block

# ==========================================
# Small Statements
# ==========================================

return_stmt:
    | 'return' [expression]

break_stmt:
    | 'break'

continue_stmt:
    | 'continue'

delete_stmt:
    | 'delete' expression

raise_stmt:
    | 'raise' expression

defer_stmt:
    | 'defer' (block | statement)

yield_stmt:
    | 'yield' ['from'] expression

pass_stmt:
    | 'pass'

const_decl:
    | 'const' type IDENTIFIER '=' expression

var_decl:
    | modifiers? type IDENTIFIER ['=' expression]

assignment:
    | primary augassign expression
    | primary '=' expression

augassign:
    | '+=' | '-=' | '*=' | '/=' | '%=' | '&=' | '|=' | '^=' | '<<=' | '>>='

expression_stmt:
    | expression

# ==========================================
# Expressions
# ==========================================

expression:
    | disjunction
    | match_expr
    | lambda_expr

disjunction:
    | conjunction ('or' conjunction)*

conjunction:
    | inversion ('and' inversion)*

inversion:
    | 'not' inversion
    | comparison

comparison:
    | range (compare_op range)*

compare_op:
    | '==' | '!=' | '<=' | '>=' | '<' | '>' | 'is' 'not' | 'is' | 'not' 'in' | 'in' | 'instanceof' | 'subclassof'

range:
    | bitwise_or (range_op bitwise_or)*

range_op:
    | '..' | '...'

bitwise_or:
    | bitwise_xor ('|' bitwise_xor)*

bitwise_xor:
    | bitwise_and ('^' bitwise_and)*

bitwise_and:
    | shift ('&' shift)*

shift:
    | sum (('<<' | '>>') sum)*

sum:
    | term (('+' | '-') term)*

term:
    | factor (('*' | '/' | '%') factor)*

factor:
    | ('addressof' | 'move') primary
    | ('+' | '-' | '~') factor
    | power

power:
    | await_expr
    | primary ['**' factor]

await_expr:
    | 'await' primary

primary:
    | primary '.' IDENTIFIER
    | primary '(' [args] ')'
    | primary '[' expression ']'
    | primary '++'
    | primary '--'
    | atom

atom:
    | IDENTIFIER
    | literal
    | '(' expression ')'
    | '[' [','.expression*] ']'
    | '{' [','.dict_item*] '}'
    | comprehension
    | 'self'
    | 'parent'
    | 'new' type '(' [args] ')'
    | 'True'
    | 'False'
    | 'None'

dict_item:
    | expression ':' expression

comprehension:
    | '[' expression 'for' IDENTIFIER 'in' expression ['if' expression] ']'
    | '{' expression ':' expression 'for' IDENTIFIER 'in' expression ['if' expression] '}'
    | '{' expression 'for' IDENTIFIER 'in' expression ['if' expression] '}'

match_expr:
    | 'match' expression 'in' '{' ','.match_arm+ '}'

match_arm:
    | pattern '=>' expression

lambda_expr:
    | 'lambda' [params] ':' expression
    | 'fn' '(' [params] ')' ['->' type] ':' block

# ==========================================
# Inline Assembly
# ==========================================

asm_stmt:
    | 'asm' 'volatile' LIT_STRING ':' asm_output ':' asm_input ':' asm_clobber

asm_output:
    | 'output' '(' ','.asm_operand+ ')' | ε

asm_input:
    | 'input' '(' ','.asm_operand+ ')' | ε

asm_clobber:
    | 'clobber' '(' ','.LIT_STRING+ ')' | ε

asm_operand:
    | LIT_STRING IDENTIFIER

# ==========================================
# Export
# ==========================================

export_block:
    | 'export' '{' ','.IDENTIFIER+ '}'

# ==========================================
# Types
# ==========================================

type:
    | union_type

union_type:
    | intersection_type ('|' intersection_type)*

intersection_type:
    | base_type ('&' base_type)*

base_type:
    | IDENTIFIER [generic_args]
    | '?' base_type
    | base_type '[]'
    | '(' type ')'
    | 'Callable' '<' type ',' '<' ','.type* '>' '>'
    | 'Meta' '<' type '>'

# ==========================================
# Helpers
# ==========================================

block:
    | NEWLINE INDENT statements DEDENT
    | simple_stmt

params:
    | ','.param+ [',' '...']
    | '...'

param:
    | modifiers? type IDENTIFIER ['=' expression]

args:
    | ','.expression+ [',' '...']
    | '...'

generic_params:
    | '<' ','.generic_param+ '>'

generic_param:
    | IDENTIFIER [':' ','.type+]

generic_args:
    | '<' [','.type+] '>'

# ==========================================
# Terminals (Lexer tokens)
# ==========================================

IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/
LIT_INTEGER: /[0-9]+|0x[0-9a-fA-F]+|0b[01]+|0o[0-7]+/
LIT_FLOAT: /[0-9]+\.[0-9]+/
LIT_STRING: /"([^"\\]|\\.)*"/ | /"""(.|\n)*?"""/
LIT_CHAR: /'([^'\\]|\\.)'/
NEWLINE: /\n/
INDENT: /<INDENT>/
DEDENT: /<DEDENT>/
ENDMARKER: /<EOF>/
