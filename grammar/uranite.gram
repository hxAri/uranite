# Uranite Formal Grammar (PEG)
# Inspired by Python's PEG grammar (PEP 617)
# Refined for Uranite Specification (2026)

@ast_node_base 'ast::Node'

# ==========================================
# Top-level rules
# ==========================================

program:
    | [package_decl] [statements] ENDMARKER

package_decl:
    | 'package' package_name NEWLINE

package_name:
    | package_segment ('.' package_segment)*

package_segment:
    | (IDENTIFIER | KEYWORD) ('-' (IDENTIFIER | KEYWORD | LIT_INTEGER))*

dotted_name:
    | IDENTIFIER ('.' IDENTIFIER)*

statements:
    | statement+

statement:
    | compound_stmt
    | simple_stmt

simple_stmt:
    | (import_stmt | extern_stmt | type_alias_stmt | const_decl | var_decl | assignment | expression_stmt | return_stmt | break_stmt | continue_stmt | delete_stmt | raise_stmt | defer_stmt | yield_stmt | pass_stmt | asm_stmt) NEWLINE
    | NEWLINE

compound_stmt:
    | function_def
    | class_def
    | struct_def
    | enum_def
    | interface_def
    | trait_def
    | implement_def
    | if_stmt
    | while_stmt
    | for_stmt
    | match_stmt
    | switch_stmt
    | try_stmt
    | unsafe_block
    | export_block

# ==========================================
# Declarations
# ==========================================

import_stmt:
    | access_modifier? 'import' import_path ['as' IDENTIFIER]
    | access_modifier? 'from' import_path 'import' ('*' | '{' NEWLINE? INDENT? import_item (',' NEWLINE? import_item)* NEWLINE? DEDENT? '}' | import_item (',' import_item)*)

import_path:
    | package_segment ('.' package_segment)*

import_item:
    | IDENTIFIER ['as' IDENTIFIER]

extern_stmt:
    | 'extern' 'function' IDENTIFIER '(' [params] ')' ['->' type] ';'

function_def:
    | modifiers 'function' IDENTIFIER [generic_params] '(' [params] ')' ['->' type] ['raises' '|'.type+] (':' block | ';')

class_def:
    | modifiers 'class' IDENTIFIER [generic_params] ['extends' type] ['implements' ','.type+] (':' block | ';')

struct_def:
    | modifiers 'struct' IDENTIFIER [generic_params] (':' block | ';')

enum_def:
    | modifiers 'enum' IDENTIFIER ['backed' type] ':' INDENT enum_body DEDENT

enum_body:
    | (enum_variant | enum_method | enum_field)+

enum_variant:
    | 'unit' IDENTIFIER [expression]

enum_method:
    | modifiers ('function' | 'property') IDENTIFIER [generic_params] '(' [params] ')' ['->' type] ['raises' '|'.type+] (':' block | ';')

enum_field:
    | modifiers type IDENTIFIER ['=' expression] NEWLINE

interface_def:
    | modifiers 'interface' IDENTIFIER [generic_params] ['extends' ','.type+] (':' block | ';')

trait_def:
    | modifiers 'trait' IDENTIFIER [generic_params] ':' block

implement_def:
    | 'implements' [generic_params] type 'for' type ':' block

type_alias_stmt:
    | modifiers 'type' IDENTIFIER [generic_params] '=' type

# ==========================================
# OOP & Modifiers
# ==========================================

modifiers:
    | access_modifier? oop_modifier*

access_modifier:
    | 'public' | 'private' | 'protect'

oop_modifier:
    | 'virtual' | 'override' | 'abstract' | 'static' | 'final' | 'Readonly' | 'const' | 'async' | 'property' | 'native'

# ==========================================
# Control Flow
# ==========================================

if_stmt:
    | 'if' expression ':' block elif_clause* [else_clause]

elif_clause:
    | 'elif' expression ':' block

else_clause:
    | 'else' ':' block

while_stmt:
    | 'while' expression ':' block

for_stmt:
    | 'for' [type] IDENTIFIER '=' expression ';' expression ';' for_update ':' block
    | 'for' [type] IDENTIFIER 'in' expression ':' block

for_update:
    | expression (augassign expression | '++' | '--')?

match_stmt:
    | 'match' expression ':' INDENT match_case+ DEDENT

match_case:
    | pattern '=>' (block | simple_stmt)

switch_stmt:
    | 'switch' expression ':' INDENT switch_case+ DEDENT

switch_case:
    | 'case' (pattern | '*') ':' block

pattern:
    | IDENTIFIER ('.' IDENTIFIER)*
    | literal
    | '*'

try_stmt:
    | 'try' ':' block except_clause+ [finally_clause]

except_clause:
    | 'except' [type ['as' IDENTIFIER]] ':' block

finally_clause:
    | 'finally' ':' block

unsafe_block:
    | 'unsafe' ':' block

# ==========================================
# Small Statements
# ==========================================

return_stmt:
    | 'return' [expression]

break_stmt:
    | 'break'

continue_stmt:
    | 'continue'

delete_stmt:
    | 'delete' expression

raise_stmt:
    | 'raise' expression

defer_stmt:
    | 'defer' (block | statement)

yield_stmt:
    | 'yield' ['from'] expression

pass_stmt:
    | 'pass'

const_decl:
    | 'const' type IDENTIFIER '=' expression

var_decl:
    | modifiers? type IDENTIFIER ['=' expression]

assignment:
    | primary augassign expression
    | primary '=' expression

augassign:
    | '+=' | '-=' | '*=' | '/=' | '%=' | '&=' | '|=' | '^=' | '<<=' | '>>='

expression_stmt:
    | expression

# ==========================================
# Expressions
# ==========================================

expression:
    | disjunction
    | match_expr
    | lambda_expr

disjunction:
    | conjunction ('or' conjunction)*

conjunction:
    | inversion ('and' inversion)*

inversion:
    | 'not' inversion
    | comparison

comparison:
    | range_expr (compare_op range_expr)*

compare_op:
    | '==' | '!=' | '<=' | '>=' | '<' | '>' | 'is' 'not' | 'is' | 'not' 'in' | 'in' | 'instanceof' | 'subclassof'

range_expr:
    | bitwise_or (range_op bitwise_or)?

range_op:
    | '..' | '...'

bitwise_or:
    | bitwise_xor ('|' bitwise_xor)*

bitwise_xor:
    | bitwise_and ('^' bitwise_and)*

bitwise_and:
    | shift ('&' shift)*

shift:
    | sum (('<<' | '>>') sum)*

sum:
    | term (('+' | '-') term)*

term:
    | factor (('*' | '/' | '%') factor)*

factor:
    | ('addressof' | 'move') primary
    | ('+' | '-' | '~') factor
    | power

power:
    | await_expr
    | primary ['**' factor]

await_expr:
    | 'await' expression

primary:
    | primary '.' IDENTIFIER
    | primary '(' [args] ')'
    | primary '[' expression ']'
    | primary '++'
    | primary '--'
    | atom

atom:
    | IDENTIFIER
    | literal
    | '(' expression ')'
    | '(' ')'
    | '(' expression ',' [','.expression*] ')'
    | '[' [expression ('for' [type] IDENTIFIER 'in' expression ['if' expression] | (',' expression)*)] ']'
    | 'self'
    | 'parent'
    | 'new' type '(' [','.expression*] ')'
    | 'True'
    | 'False'
    | 'None'

match_expr:
    | 'match' expression 'in' match_arm (',' match_arm)* [',' '*' '=>' expression]

match_arm:
    | expression '=>' expression

lambda_expr:
    | 'lambda' ','.lambda_param+ ':' expression
    | 'async'? 'function' '(' [params] ')' ['->' type] ':' (block | expression)
    | 'async'? 'lambda' ','.lambda_param+ ':' expression

lambda_param:
    | ['final'] type IDENTIFIER

# ==========================================
# Inline Assembly
# ==========================================

asm_stmt:
    | 'asm' ['volatile'] LIT_STRING ':' asm_output ':' asm_input ':' asm_clobber

asm_output:
    | 'output' '(' ','.asm_operand+ ')' | ε

asm_input:
    | 'input' '(' ','.asm_operand+ ')' | ε

asm_clobber:
    | 'clobber' '(' ','.LIT_STRING+ ')' | ε

asm_operand:
    | LIT_STRING IDENTIFIER

# ==========================================
# Export
# ==========================================

export_block:
    | 'export' '{' ','.IDENTIFIER+ '}'

# ==========================================
# Types
# ==========================================

type:
    | union_type

union_type:
    | intersection_type ('|' intersection_type)*

intersection_type:
    | base_type ('&' base_type)*

base_type:
    | IDENTIFIER [generic_args]
    | '?' base_type
    | base_type '[]'
    | '(' type ')'
    | 'Callable' '<' type ',' '<' ','.type* '>' '>'
    | 'Meta' '<' type '>'

# ==========================================
# Helpers
# ==========================================

block:
    | NEWLINE INDENT statements DEDENT
    | simple_stmt

params:
    | ','.param+

param:
    | 'self'
    | '&' 'self'
    | property_modifier? 'mut'? type IDENTIFIER ('[]' | '{}')? ['=' expression]

property_modifier:
    | ('public' | 'private' | 'protect') ['Readonly']

args:
    | ','.expression+

generic_params:
    | '<' ','.generic_param+ '>'

generic_param:
    | IDENTIFIER [':' ','.type+]

generic_args:
    | '<' [','.type+] '>'

literal:
    | LIT_INTEGER
    | LIT_FLOAT
    | LIT_STRING
    | LIT_CHAR

# ==========================================
# Terminals (Lexer tokens)
# ==========================================

IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/
KEYWORD: (any reserved keyword token)
LIT_INTEGER: /[0-9]+|0x[0-9a-fA-F]+|0b[01]+|0o[0-7]+/
LIT_FLOAT: /[0-9]+\.[0-9]+/
LIT_STRING: /"([^"\\]|\\.)*"/ | /"""(.|\n)*?"""/
LIT_CHAR: /'([^'\\]|\\.)'/
NEWLINE: /\n/
INDENT: /<INDENT>/
DEDENT: /<DEDENT>/
ENDMARKER: /<EOF>/

# ==========================================
# Lexer notes
# ==========================================

# Line continuation: backslash immediately before newline (\<newline>) is consumed
# by the lexer, joining physical lines into one logical line.
#
# Implicit continuation: newlines inside matched (), [], {} pairs are suppressed
# by the lexer (parenDepth tracking).
#
# Indentation: the lexer emits INDENT/DEDENT tokens based on leading whitespace
# changes (consistent spaces per level). Tabs and spaces cannot be mixed.
#
# Doccomments: triple-quoted strings (""" or ''') appearing after declarations
# are captured by the lexer as documentation strings.
#
# Comments: single-line comments start with '#' and extend to end of line.
