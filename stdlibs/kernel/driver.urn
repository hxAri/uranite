package uranite.kernel.driver

from uranite.os.driver.driver import Driver, DriverDescriptor, DriverRegistry, DriverState

public class DeviceDriverManager:

    """
    Manages the full driver lifecycle: registration, probing, and state
    tracking. Wraps DriverRegistry with a higher-level management API.
    """

    public DriverRegistry registry

    public function DeviceDriverManager( self, I64 capacity ) -> Void:

        """
        Construct a driver manager that can hold up to capacity driver registrations.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.registry = new DriverRegistry( capacity )

    public function registerDriver( self, I64 driverId, I64 vendorMatch, I64 deviceMatch, I64 classMatch ) -> Boolean:

        """
        Register a driver with matching criteria. Returns True on success.

        Parameters:
            driverId (I64):
                Unique driver identifier.
            vendorMatch (I64):
                Vendor ID to match against devices.
            deviceMatch (I64):
                Device ID to match against devices.
            classMatch (I64):
                Device class code to match.
        """

        return self.registry.registerDriver( driverId, vendorMatch, deviceMatch, classMatch )

    public function findDriverForDevice( self, I64 vendorId, I64 deviceId, I64 classCode ) -> I64:

        """
        Find a registered driver matching the given device identifiers.
        Returns driver ID or -1 if no match.
        """

        return self.registry.findDriverForDevice( vendorId, deviceId, classCode )

    public function bindDriver( self, I64 driverId, I64 bus, I64 slot, I64 func ) -> Boolean:

        """
        Bind a driver to a specific PCI device location.
        """

        return self.registry.bindDriver( driverId, bus, slot, func )

    public function getDriverState( self, I64 driverId ) -> I64:

        """ Return the current state of a registered driver. """

        return self.registry.getDriverState( driverId )

    public function getDriverCount( self ) -> I64:

        """ Return the number of registered drivers. """

        return self.registry.getCount()

    public function destroy( self ) -> Void:

        """
        Release all resources held by the driver manager.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.registry.destroy()

export {
    DeviceDriverManager,
    Driver,
    DriverDescriptor,
    DriverRegistry,
    DriverState
}
