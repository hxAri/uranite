package uranite.kernel.io

from uranite.os.io.buffer-cache import {
    BUFFER_VALID, BUFFER_DIRTY, BUFFER_LOCKED, BufferEntry, BufferCache
}
from uranite.os.io.dma import DmaDirection, DmaDescriptor, DmaChannel
from uranite.os.io.request import RequestType, RequestStatus, IoRequestQueue

public class BlockIoSubsystem:

    """
    Unified block I/O subsystem combining buffer cache for read caching,
    DMA channels for direct memory transfers, and request queues for
    asynchronous I/O scheduling.
    """

    public BufferCache cache
    public IoRequestQueue requestQueue

    public function BlockIoSubsystem( self, I64 cacheCapacity, I64 queueCapacity ) -> Void:
        self.cache = new BufferCache( cacheCapacity )
        self.requestQueue = new IoRequestQueue( queueCapacity )

    public function lookupCached( self, I64 deviceId, I64 blockNumber ) -> I64:

        """
        Look up a block in the buffer cache. Returns the cache slot index
        or -1 if not cached.
        """

        return self.cache.lookup( deviceId, blockNumber )

    public function submitRead( self, I64 deviceId, I64 blockNumber, I64 bufferAddress, I64 length, I64 tag ) -> I64:

        """
        Submit an asynchronous read request. Returns the request index
        for later status checking.
        """

        return self.requestQueue.submit( RequestType.Read, deviceId, blockNumber, bufferAddress, length, tag )

    public function submitWrite( self, I64 deviceId, I64 blockNumber, I64 bufferAddress, I64 length, I64 tag ) -> I64:

        """
        Submit an asynchronous write request. Returns the request index
        for later status checking.
        """

        return self.requestQueue.submit( RequestType.Write, deviceId, blockNumber, bufferAddress, length, tag )

    public function getDirtyCount( self ) -> I64:

        """ Return the number of dirty buffer cache entries awaiting writeback. """

        return self.cache.getDirtyCount()

    public function getCacheHits( self ) -> I64:

        """ Return the number of cache hits since creation. """

        return self.cache.getHits()

    public function getPendingRequests( self ) -> I64:

        """ Return the number of pending I/O requests. """

        return self.requestQueue.getPending()

    public function destroy( self ) -> Void:

        """
        Release all resources held by the block I/O subsystem.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.requestQueue.destroy()

export {
    BlockIoSubsystem,
    BUFFER_VALID, BUFFER_DIRTY, BUFFER_LOCKED, BufferEntry, BufferCache,
    DmaDirection, DmaDescriptor, DmaChannel,
    RequestType, RequestStatus, IoRequestQueue
}
