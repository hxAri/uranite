package uranite.kernel.hal

from uranite.os.hal.interrupt import InterruptTable, IrqEntry, MAX_IRQ_COUNT
from uranite.os.hal.mmio import {
    loadFence,
    memoryFence,
    mmioRead16,
    mmioRead32,
    mmioRead64,
    mmioRead8,
    mmioWrite16,
    mmioWrite32,
    mmioWrite64,
    mmioWrite8,
    storeFence
}

public class HardwareAbstraction:

    """
    Unified HAL combining MMIO register access with automatic memory
    barrier enforcement and interrupt table management.
    """

    public InterruptTable interrupts

    public function HardwareAbstraction( self ) -> Void:
        self.interrupts = new InterruptTable()

    public function readRegister8( self, I64 address ) -> I64:

        """ Read an 8-bit MMIO register with a load fence. """

        I64 value = mmioRead8( address )
        loadFence()
        return value

    public function writeRegister8( self, I64 address, I64 value ) -> Void:

        """ Write an 8-bit MMIO register with a store fence. """

        mmioWrite8( address, value )
        storeFence()

    public function readRegister32( self, I64 address ) -> I64:

        """ Read a 32-bit MMIO register with a load fence. """

        I64 value = mmioRead32( address )
        loadFence()
        return value

    public function writeRegister32( self, I64 address, I64 value ) -> Void:

        """ Write a 32-bit MMIO register with a store fence. """

        mmioWrite32( address, value )
        storeFence()

    public function readRegister64( self, I64 address ) -> I64:

        """ Read a 64-bit MMIO register with a load fence. """

        I64 value = mmioRead64( address )
        loadFence()
        return value

    public function writeRegister64( self, I64 address, I64 value ) -> Void:

        """ Write a 64-bit MMIO register with a store fence. """

        mmioWrite64( address, value )
        storeFence()

    public function registerIrq( self, I64 irqNumber, I64 handlerId ) -> Boolean:

        """ Register an interrupt handler for the given IRQ number. """

        return self.interrupts.registerHandler( irqNumber, handlerId )

    public function unregisterIrq( self, I64 irqNumber ) -> I64:

        """
        Unregister the interrupt handler for the given IRQ number.
        Returns the previous handler address, or 0 if none was registered.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        return self.interrupts.unregisterHandler( irqNumber )

export {
    HardwareAbstraction,
    InterruptTable,
    IrqEntry,
    MAX_IRQ_COUNT,
    loadFence,
    memoryFence,
    mmioRead16,
    mmioRead32,
    mmioRead64,
    mmioRead8,
    mmioWrite16,
    mmioWrite32,
    mmioWrite64,
    mmioWrite8,
    storeFence
}
