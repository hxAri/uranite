package uranite.kernel.bus

from uranite.os.bus.pci import {
    PCI_CONFIG_ADDRESS,
    PCI_CONFIG_DATA,
    PCI_NO_DEVICE,
    PciBus,
    PciDevice,
    pciAddress,
    pciRead16,
    pciRead32,
    pciRead8,
    pciWrite32
}

public class PciScanner:

    """
    High-level PCI bus scanner with device enumeration. Wraps the raw
    PCI configuration space access functions and PciBus device list into
    a single scan-and-query interface.
    """

    public PciBus bus

    public function PciScanner( self, I64 capacity ) -> Void:

        """
        Construct a PCI scanner that can hold up to capacity discovered devices.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.bus = new PciBus( capacity )

    public function scan( self ) -> Void:

        """
        Enumerate all devices on the PCI bus by probing every bus/device/function
        combination. Populates the internal device list.
        """

        self.bus.scan()

    public function getDeviceCount( self ) -> I64:

        """ Return the number of PCI devices discovered during the last scan. """

        return self.bus.getCount()

    public function findByVendorDevice( self, I64 vendorId, I64 deviceId ) -> I64:

        """
        Search for a PCI device by vendor and device ID. Returns the device
        index or -1 if not found.
        """

        return self.bus.findByVendorDevice( vendorId, deviceId )

    public function findByClass( self, I64 classCode, I64 subclass ) -> I64:

        """
        Search for a PCI device by class code and subclass. Returns the
        device index or -1 if not found.
        """

        return self.bus.findByClass( classCode, subclass )

    public function destroy( self ) -> Void:

        """
        Release all resources held by the scanner.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.bus.destroy()

export {
    PCI_CONFIG_ADDRESS,
    PCI_CONFIG_DATA,
    PCI_NO_DEVICE,
    PciBus,
    PciDevice,
    PciScanner,
    pciAddress,
    pciRead16,
    pciRead32,
    pciRead8,
    pciWrite32
}
