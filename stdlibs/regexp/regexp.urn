#
# Backtracking regex engine. Supports:
#   . (any char), * (zero+), + (one+), ? (zero/one),
#   [] character classes, [^] negated classes,
#   ^ (start), $ (end),
#   \d (digit), \w (word), \s (whitespace),
#   \D, \W, \S (negated), \. (literal dot),
#   | (alternation), () grouping.
#
