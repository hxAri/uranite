package uranite.operators.indexable

from uranite.language.boolean import Boolean

public interface Indexable<K, V>:
    
    """
    Interface for types that support bracket-style element access (obj[key]).
    Implementing types must define how to retrieve and store values by key.
    """
    
    public function get( self, K key ) -> V:
        
        """ Retrieve the value associated with the given key. """
    
    public function set( self, K key, V value ) -> Void:
        
        """ Store the given value at the given key, replacing any existing value. """
    
    public function remove( self, K key ) -> Void:
        
        """ Delete the value associated with the given key. """
    
    public function contains( self, K key ) -> Boolean:
        
        """ Check whether the given key exists in this container. """


export {
    Indexable
}
