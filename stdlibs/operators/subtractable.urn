package uranite.operators



interface Subtractable<T>:
    
    """
    Interface for types that support the subtraction (-) operator.
    Implementing types must define how to subtract one value from another of the same type.
    """
    
    public function subtract( self, T other ) -> T:
        
        """ Return the result of subtracting the other value from self. """
    
