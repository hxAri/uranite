package uranite.operators.equatable

interface Equatable<T>:
    
    """
    Interface for types that support equality comparison (== and !=).
    Implementing types must define structural or semantic equality for their values.
    """
    
    public function equals( self, T other ) -> Boolean:
        
        """ Return True if self is equal to the other value. """
    
    public function notEquals( self, T other ) -> Boolean:
        
        """ Return True if self is not equal to the other value. """
    
