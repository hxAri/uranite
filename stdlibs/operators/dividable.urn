package uranite.operators



interface Dividable<T>:
    
    """
    Interface for types that support the division (/) operator.
    Implementing types must define how self is divided by another value of the same type.
    """
    
    public function divide( self, T other ) -> T:
        
        """ Return the result of dividing self by the other value. """
