package uranite.operators.negatable

interface Negatable<T>:
    
    """
    Interface for types that support unary negation (-).
    Implementing types must define how to produce the negated form of a value.
    """
    
    public function negate( self ) -> T:
        
        """ Return the negated value of self. """
