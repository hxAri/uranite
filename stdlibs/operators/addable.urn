package uranite.operators.addable

interface Addable<T>:
    
    """
    Interface for types that support the addition (+) operator.
    Implementing types must define how two values of the same type are added together.
    """
    
    public function add( self, T other ) -> T:
        
        """ Return the result of adding the other value to self. """
