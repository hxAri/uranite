package uranite.operators

interface Comparable<T>:
    
    """
    Interface for types that support ordering comparisons (<, >, <=, >=).
    Implementing types must define a total ordering over their values.
    """
    
    public function compareTo( self, T other ) -> I32:
        
        """ Return a negative, zero, or positive I32 for less-than, equal, or greater-than respectively. """
    
    public function lessThan( self, T other ) -> Boolean:
        
        """ Return True if self is strictly less than other. """
    
    public function greaterThan( self, T other ) -> Boolean:
        
        """ Return True if self is strictly greater than other. """
    
    public function lessOrEqual( self, T other ) -> Boolean:
        
        """ Return True if self is less than or equal to other. """
    
    public function greaterOrEqual( self, T other ) -> Boolean:
        
        """ Return True if self is greater than or equal to other. """
