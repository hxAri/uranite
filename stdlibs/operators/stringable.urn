package uranite.operators



interface Stringable:
    
    """
    Interface for types that can produce a human-readable string representation.
    Implementing types must define how to convert their value to a String.
    """
    
    public function toString( self ) -> String:
        
        """ Return a human-readable string representation of this value. """
