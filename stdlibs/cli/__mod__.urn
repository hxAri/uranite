package uranite.cli

from uranite.collection.array-list import ArrayList


""" The number of command line arguments passed to the program. """
public const I64 argc = 0

""" The command line arguments passed to the program at startup. """
public const ArrayList<String> argv = new ArrayList<String>()


export {
    argc,
    argv
}
