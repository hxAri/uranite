package uranite.logging.styled-handler

from uranite.adelia.ansi-formatter import AnsiFormatter
from uranite.io.writer import STDERR_FD, writeFd, writeNewlineFd
from uranite.logging.formatter import LogFormatter, defaultFormatter
from uranite.logging.level import LogLevel

public class StyledConsoleHandler:

    """
    Console log handler with ANSI color styling via Adelia. Maps log
    levels to colors for visual severity differentiation:
      Trace  -> gray (128,128,128)
      Debug  -> cyan (0,188,212)
      Info   -> green (76,175,80)
      Warn   -> yellow (255,193,7)
      Error  -> red (244,67,54)
      Fatal  -> bright red (255,23,68)
    """

    public LogFormatter formatter
    public LogLevel minLevel
    public AnsiFormatter ansiFormatter

    public function StyledConsoleHandler( self ) -> Void:

        """
        Construct handler with default formatter and Trace minimum level.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.formatter = defaultFormatter()
        self.minLevel = LogLevel.Trace
        self.ansiFormatter = new AnsiFormatter()

    public function StyledConsoleHandler( self, LogFormatter formatter, LogLevel minimumLevel ) -> Void:

        """
        Construct handler with custom formatter and minimum level.

        Parameters:
            formatter (LogFormatter):
                Log message formatter.
            minimumLevel (LogLevel):
                Minimum severity level to emit.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.formatter = formatter
        self.minLevel = minimumLevel
        self.ansiFormatter = new AnsiFormatter()

    public function handle( self, LogLevel level, String name, String message ) -> Void:

        """
        Format and write a color-styled log line to stderr.

        Parameters:
            level (LogLevel):
                Severity level of this log entry.
            name (String):
                Logger name / source identifier.
            message (String):
                Log message content.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        if level < self.minLevel:
            return

        String formatted = self.formatter.format( level, name, message )
        String colored = self.colorForLevel( level, formatted )
        writeFd( STDERR_FD, colored )
        writeNewlineFd( STDERR_FD )

    public function setMinLevel( self, LogLevel level ) -> Void:

        """
        Update minimum severity level.

        Parameters:
            level (LogLevel):
                New minimum level.
        """

        self.minLevel = level

    public function setFormatter( self, LogFormatter formatter ) -> Void:

        """
        Replace the log message formatter.

        Parameters:
            formatter (LogFormatter):
                New formatter to use.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.formatter = formatter

    protect function colorForLevel( self, LogLevel level, String text ) -> String:

        """
        Apply ANSI color to text based on log severity level.

        Parameters:
            level (LogLevel):
                Severity level determining color.
            text (String):
                Text to colorize.

        Returns:
            String:
                ANSI-colored text.
        """

        if level == LogLevel.Trace:
            return self.ansiFormatter.colorize( text, 128, 128, 128 )
        if level == LogLevel.Debug:
            return self.ansiFormatter.colorize( text, 0, 188, 212 )
        if level == LogLevel.Info:
            return self.ansiFormatter.colorize( text, 76, 175, 80 )
        if level == LogLevel.Warn:
            return self.ansiFormatter.colorize( text, 255, 193, 7 )
        if level == LogLevel.Error:
            return self.ansiFormatter.colorize( text, 244, 67, 54 )
        if level == LogLevel.Fatal:
            return self.ansiFormatter.colorize( text, 255, 23, 68 )
        return text

export {
    StyledConsoleHandler
}
