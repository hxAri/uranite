package uranite.logging.level

public enum LogLevel backed I64:
    
    """
    Log severity levels ordered from least to most severe.
    
    Use variant.name to get the string representation (e.g., LogLevel.Info.name returns "Info").
    Use variant.value to get the backing I64 value (e.g., LogLevel.Info.value returns 2).
    Comparisons use backing values: LogLevel.Error >= LogLevel.Info is True.
    """
    
    unit Trace 0
    unit Debug 1
    unit Info 2
    unit Warn 3
    unit Error 4
    unit Fatal 5

export {
    LogLevel
}
