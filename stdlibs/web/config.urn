package uranite.web.config

public class ServerConfig:
    
    """
    Configuration for the HTTP server including network binding, connection
    limits, timeouts, and request size constraints. All timeout values are
    specified in seconds.
    """
    
    public I64 port
    """The TCP port number the server will listen on."""
    
    public String host
    """The hostname or IP address the server will bind to."""
    
    public I64 maxConnections
    """The maximum number of concurrent connections allowed. Defaults to 1024."""
    
    public I64 readTimeout
    """The timeout in seconds for reading a complete request. Defaults to 30."""
    
    public I64 writeTimeout
    """The timeout in seconds for writing a complete response. Defaults to 30."""
    
    public I64 maxRequestBodySize
    """The maximum allowed request body size in bytes. Defaults to 10485760 (10 MB)."""
    
    public I64 backlog
    """The maximum number of pending connections in the listen queue. Defaults to 128."""
    
    public function ServerConfig( self, I64 port, String host ) -> Void:
        
        """
        Create a new ServerConfig with the given port and host, using default
        values for all other settings.
        
        Parameters:
            port (I64):
                The TCP port number to listen on.
            host (String):
                The hostname or IP address to bind to.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        self.port = port
        self.host = host
        self.maxConnections = 1024
        self.readTimeout = 30
        self.writeTimeout = 30
        self.maxRequestBodySize = 10485760
        self.backlog = 128
    
    public function setMaxConnections( self, I64 max ) -> ServerConfig:
        
        """
        Set the maximum number of concurrent connections.
        
        Parameters:
            max (I64):
                The maximum connection count.
        
        Returns:
            This ServerConfig instance for method chaining.
        """
        
        self.maxConnections = max
        return self
    
    public function setReadTimeout( self, I64 secs ) -> ServerConfig:
        
        """
        Set the read timeout for incoming requests.
        
        Parameters:
            secs (I64):
                The read timeout in seconds.
        
        Returns:
            This ServerConfig instance for method chaining.
        """
        
        self.readTimeout = secs
        return self
    
    public function setWriteTimeout( self, I64 secs ) -> ServerConfig:
        
        """
        Set the write timeout for outgoing responses.
        
        Parameters:
            secs (I64):
                The write timeout in seconds.
        
        Returns:
            This ServerConfig instance for method chaining.
        """
        
        self.writeTimeout = secs
        return self
    
    public function setMaxRequestBodySize( self, I64 size ) -> ServerConfig:
        
        """
        Set the maximum allowed request body size.
        
        Parameters:
            size (I64):
                The maximum body size in bytes.
        
        Returns:
            This ServerConfig instance for method chaining.
        """
        
        self.maxRequestBodySize = size
        return self
    
    public function setBacklog( self, I64 backlog ) -> ServerConfig:
        
        """
        Set the listen backlog size for pending connections.
        
        Parameters:
            backlog (I64):
                The maximum number of pending connections in the listen queue.
        
        Returns:
            This ServerConfig instance for method chaining.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        self.backlog = backlog
        return self

export {
    ServerConfig
}
