package uranite.web.controller

from uranite.memory.memory import Memory
from uranite.web.request import HttpRequest
from uranite.web.response import HttpResponse
from uranite.web.route import Route

const I64 MAX_CONTROLLER_ROUTES = 64
"""Maximum number of routes that can be registered on a single controller."""

public class Controller:
    
    """
    Base class for HTTP controllers. Subclasses register routes in their
    constructor by calling the route method with an HTTP method, URL pattern,
    and handler function address. An optional URL prefix can be set to scope
    all routes under a common path.
    """
    
    public Memory<I64> controllerRoutes
    """Storage for the addresses of registered Route objects."""
    
    public I64 controllerRouteCount
    """The number of routes currently registered on this controller."""
    
    public String prefix
    """A URL path prefix prepended to all route patterns registered on this controller."""
    
    public function Controller( self ) -> Void:
        
        """
        Create a new Controller with no prefix and an empty route list.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        self.controllerRoutes = new Memory<I64>( MAX_CONTROLLER_ROUTES )
        self.controllerRouteCount = 0
        self.prefix = ""
    
    public function setPrefix( self, String prefix ) -> Controller:
        
        """
        Set the URL prefix for this controller. All routes registered after
        this call will have this prefix prepended to their pattern.
        
        Parameters:
            prefix (String):
                The URL path prefix to prepend to route patterns.
        
        Returns:
            This Controller instance for method chaining.
        """
        
        self.prefix = prefix
        return self
    
    public function route( self, String method, String pattern, Callable<Void, <HttpRequest, HttpResponse>> handler ) -> Void:

        """
        Register a route on this controller with a typed handler. The pattern
        is combined with the controller's prefix to form the full URL pattern.

        Parameters:
            method (String):
                The HTTP method this route responds to (e.g., "GET", "POST").
            pattern (String):
                The URL pattern for this route, which may include path parameters
                prefixed with a colon (e.g., "/users/:id").
            handler (Callable<Void, <HttpRequest, HttpResponse>>):
                The handler function invoked when this route matches.

        Complexity:
            Time: O(s) where s is number of segments in pattern
        """

        String fullPattern = self.prefix + pattern
        Route route = new Route( method, fullPattern, handler )
        I64 routeAddr = 0
        asm volatile "movq $1, $0" : output( "=r" routeAddr ) : input( "r" route ) : clobber()
        self.controllerRoutes.set( self.controllerRouteCount, routeAddr )
        self.controllerRouteCount = self.controllerRouteCount + 1

    protect function getRoute( self, I64 index ) -> I64:
        
        """
        Retrieve the address of the Route object at the given index.
        
        Parameters:
            index (I64):
                The zero-based index of the route to retrieve.
        
        Returns:
            The memory address of the Route object.
        """
        
        return self.controllerRoutes.get( index )
    
    public function routeCount( self ) -> I64:
        
        """
        Return the number of routes registered on this controller.
        
        Returns:
            The total number of registered routes.
        """
        
        return self.controllerRouteCount

    public function destroy( self ) -> Void:

        """
        Release the heap-allocated route storage buffer.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.controllerRoutes.free()

export {
    Controller,
    MAX_CONTROLLER_ROUTES
}
