# along with this program. If not, see <https://www.gnu.org/licenses/>.
#

package uranite.adelia.color-database

from uranite.adelia.color-distance import ColorDistance
from uranite.adelia.color-name-entry import ColorNameEntry
from uranite.adelia.rgb import RGB
from uranite.collection.array-list import ArrayList
from uranite.language.boolean import Boolean
from uranite.language.string import String

public class ColorDatabase:
    
    """
    In-memory database of named colors populated with the 140 standard CSS/HTML
    named colors plus additional distinctive named colors. All color data is
    stored inline in the constructor as sequential add operations on an ArrayList,
    requiring no external file or network access. The database provides exact
    lookup by hex code or name, and nearest-match lookup using the perceptual
    redmean distance algorithm to find the closest named color for any arbitrary
    hex value.
    """
    
    protect ArrayList<ColorNameEntry> entries
    
    public function ColorDatabase( self ) -> Void:
        
        """
        Construct a new color database and populate it with all named colors.
        The database is split into two population phases: basic CSS colors
        and extended named colors. After construction, the database is ready
        for immediate lookup operations.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        self.entries = new ArrayList<ColorNameEntry>()
        self.populateBasicColors()
        self.populateExtendedColors()
    
    private function populateBasicColors( self ) -> Void:
        
        """
        Populate the database with the 140 standard CSS/HTML named colors.
        These colors are defined by the CSS Color Module Level 4 specification
        and are universally supported by web browsers.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        self.entries.append( new ColorNameEntry( "Alice Blue", 0xF0F8FF ) )
        self.entries.append( new ColorNameEntry( "Antique White", 0xFAEBD7 ) )
