package uranite.adelia.adelia

from uranite.language import {
    Integer, 
    String, 
    Void
}

public final Readonly class Adelia:
    
    """
    Core Adelia entity representing a graphical object with a color attribute.
    This class is declared as final and readonly, meaning it cannot be subclassed
    and its fields cannot be modified after construction.
    """
    
    public I32 color
    
    public function Adelia( self, I32 color ) -> Void:
        
        """
        Construct a new Adelia instance with the given color value.
        
        Parameters:
            color (I32):
                The color value for this Adelia entity.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        self.color = color

export {
    Adelia
}
