package uranite.testing.result



public enum TestStatus backed I64:
    
    """
    Status of a completed test case.
    
    Use variant.name for string representation (e.g., TestStatus.Pass.name returns "Pass").
    """
    
    unit Pass 0
    unit Fail 1
    unit Error 2
    unit Skip 3

public class TestResult:
    public String name
    public TestStatus status
    public String message
    public I64 durationNanos
    
    public function TestResult( self, String name, TestStatus status, String message, I64 durationNanos ) -> Void:
        self.name = name
        self.status = status
        self.message = message
        self.durationNanos = durationNanos
    
    public function isPassed( self ) -> Boolean:
        return self.status == TestStatus.Pass
    
    public function isFailed( self ) -> Boolean:
        return self.status == TestStatus.Fail
    
    public function isError( self ) -> Boolean:
        return self.status == TestStatus.Error
    
    public function isSkipped( self ) -> Boolean:
        return self.status == TestStatus.Skip

export {
    TestResult,
    TestStatus
}
