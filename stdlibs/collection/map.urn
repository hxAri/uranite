package uranite.collection.map

from uranite.collection.collection import Collection
from uranite.collection.pair import Pair
from uranite.collection.sequence import Sequence
from uranite.collection.set import Set
from uranite.language.boolean import Boolean
from uranite.language.callable import Callable
from uranite.language.void import Void
from uranite.operators.indexable import Indexable

public interface Map<K, V> extends Collection<V>, Indexable<K, V>:
    
    """
    Key-value associative container mapping keys of type K to values of type V.
    
    Extends Collection and Indexable to provide key-based lookup, containment
    checks, and views over keys, values, and entries.
    """
    
    public function getOrDefault( K key, V defaultValue ) -> V:
        
        """ Retrieve the value for the given key, or return the default value if absent. """
    
    public function containsKey( K key ) -> Boolean:
        
        """ Check whether the given key exists in the map. """
    
    public function containsValue( V value ) -> Boolean:
        
        """ Check whether the given value exists in the map. """
    
    public property keys() -> Set<K>:
        
        """ Return a set containing all keys in the map. """
    
    public property values() -> Sequence<V>:
        
        """ Return a sequence containing all values in the map. """
    
    public property entries() -> Set<Pair<K, V>>:
        
        """ Return a set of all key-value pairs in the map. """
    
    public function forEach( Callable<Void,<K,V>> action ) -> Void:
        
        """ Execute the given action for each key-value pair in the map. """


export {
    Map
}
