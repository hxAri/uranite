package uranite.collection.generator

from uranite.iterators import Iterator



public interface Generator<T> extends Iterator<T>:
    
    """
    Lazy iterator that yields values on demand via coroutine-style execution.
    
    A Generator extends the Iterator protocol, allowing elements to be produced
    lazily rather than computed eagerly. This enables efficient processing of
    potentially infinite or expensive-to-compute sequences.
    """


export {
    Generator
}
