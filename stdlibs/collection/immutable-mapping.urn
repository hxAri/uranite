package uranite.collection.immutable-mapping

from uranite.collection.map import Map
from uranite.language.boolean import Boolean

public interface ImmutableMapping<K, V> extends Map<K, V>:
    
    public function get( self, K key ) -> V:
        
        """ Retrieve the value associated with the given key. """
    
    public function contains( self, K key ) -> Boolean:
        
        """ Check whether the given key exists in the mapping. """
    
    public function length( self ) -> I64:
        
        """ Return the number of entries in the mapping. """
    
    public function isEmpty( self ) -> Boolean:
        
        """ Check whether the mapping contains no entries. """


export {
    ImmutableMapping
}
