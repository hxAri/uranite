package uranite.collection.immutablesequence

from uranite.collection.sequence import Sequence
from uranite.language.callable import Callable

public interface ImmutableSequence<E> extends Sequence<E>:
    
    """
    Persistent sequence where all mutation operations return new copies
    rather than modifying the original, ensuring immutability.
    """
    
    public function with( self, Int index, E element ) -> ImmutableSequence<E>:
        
        """ Return a new sequence with the element at the given index replaced. """
    
    public function appended( self, E element ) -> ImmutableSequence<E>:
        
        """ Return a new sequence with the given element appended to the end. """
    
    public function prepended( self, E element ) -> ImmutableSequence<E>:
        
        """ Return a new sequence with the given element prepended to the front. """
    
    public function concatenated( self, Sequence<E> other ) -> ImmutableSequence<E>:
        
        """ Return a new sequence with the other sequence concatenated to the end. """
    
    public function filtered( self, Callable<Boolean,<E>> predicate ) -> ImmutableSequence<E>:
        
        """ Return a new sequence containing only elements that match the predicate. """
    
    public function dropped( self, Int count ) -> ImmutableSequence<E>:
        
        """ Return a new sequence with the first count elements removed. """
    
    public function taken( self, Int count ) -> ImmutableSequence<E>:
        
        """ Return a new sequence containing only the first count elements. """


export {
    ImmutableSequence
}
