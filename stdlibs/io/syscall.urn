    """
    
    SyscallResult syscallResult =syscall3( SYS_GETDENTS64, fd, bufPtr, bufSize )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "getdents64 failed" )
    return syscallResult.value()

public function sysStatfs( I64 pathPtr, I64 bufPtr ) -> Void:
    
    """
    Obtain filesystem statistics via the Linux statfs syscall.
    
    Parameters:
        pathPtr (I64):
            Pointer to the null-terminated path within the filesystem.
        bufPtr (I64):
            Pointer to the buffer to receive the statfs structure.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall2( SYS_STATFS, pathPtr, bufPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "statfs failed" )

public function sysFlock( I64 fd, I64 operation ) -> Void:
    
    """
    Apply or remove an advisory lock on a file via the Linux flock
    syscall.
    
    Parameters:
        fd (I64):
            The file descriptor to lock or unlock.
        operation (I64):
            The lock operation: LOCK_SH, LOCK_EX, LOCK_UN, optionally
            OR'd with LOCK_NB.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall2( SYS_FLOCK, fd, operation )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "flock failed" )

public function sysIoctl( I64 fd, I64 request, I64 argPtr ) -> I64:
    
    """
    Perform a device-specific I/O control operation via the Linux ioctl
    syscall.
    
    Parameters:
        fd (I64):
            The file descriptor of the device.
        request (I64):
            The ioctl request code.
        argPtr (I64):
            Pointer to the request-specific argument buffer.
    
    Returns:
        I64:
            The return value from the ioctl call.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall3( SYS_IOCTL, fd, request, argPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "ioctl failed" )
    return syscallResult.value()

public function sysPipe2( I64 pipefdPtr, I64 flags ) -> Void:
    
    """
    Create a pipe with flags via the Linux pipe2 syscall. The two file
    descriptors (read end, write end) are written to the memory at
    pipefdPtr.
    
    Parameters:
        pipefdPtr (I64):
            Pointer to an array of two I32 values to receive the read
            and write file descriptors.
        flags (I64):
            Flags such as O_CLOEXEC to set on the new file descriptors.
    
    Raises:
        IOError:
            If the syscall fails.
    
    Complexity:
        Time: O(1)
        Space: O(1)
    """
    
    SyscallResult syscallResult =syscall2( SYS_PIPE2, pipefdPtr, flags )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "pipe2 failed" )

