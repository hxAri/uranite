from uranite.os.syscall.invoke import {
    syscall0, syscall1, syscall2, syscall3, syscall4
}
from uranite.os.syscall.result import SyscallResult
from uranite.memory.memory import Memory
from uranite.io.errors import {
    IOError, FileNotFoundError, PermissionError,
    FileExistsError, IsADirectoryError, NotADirectoryError,
    DirectoryNotEmptyError, BrokenPipeError
}

const I64 SYS_READ = 0
"""Linux x86_64 syscall number for read (0)."""
const I64 SYS_WRITE = 1
"""Linux x86_64 syscall number for write (1)."""
const I64 SYS_OPEN = 2
"""Linux x86_64 syscall number for open (2)."""
const I64 SYS_CLOSE = 3
"""Linux x86_64 syscall number for close (3)."""
const I64 SYS_STAT = 4
"""Linux x86_64 syscall number for stat (4)."""
const I64 SYS_FSTAT = 5
"""Linux x86_64 syscall number for fstat (5)."""
const I64 SYS_LSTAT = 6
"""Linux x86_64 syscall number for lstat (6)."""
const I64 SYS_LSEEK = 8
"""Linux x86_64 syscall number for lseek (8)."""
const I64 SYS_IOCTL = 16
"""Linux x86_64 syscall number for ioctl (16)."""
const I64 SYS_ACCESS = 21
"""Linux x86_64 syscall number for access (21)."""
const I64 SYS_PIPE2 = 293
"""Linux x86_64 syscall number for pipe2 (293)."""
const I64 SYS_FTRUNCATE = 77
"""Linux x86_64 syscall number for ftruncate (77)."""
const I64 SYS_GETCWD = 79
"""Linux x86_64 syscall number for getcwd (79)."""
const I64 SYS_CHDIR = 80
"""Linux x86_64 syscall number for chdir (80)."""
const I64 SYS_RENAME = 82
"""Linux x86_64 syscall number for rename (82)."""
const I64 SYS_MKDIR = 83
"""Linux x86_64 syscall number for mkdir (83)."""
const I64 SYS_RMDIR = 84
"""Linux x86_64 syscall number for rmdir (84)."""
const I64 SYS_LINK = 86
"""Linux x86_64 syscall number for link (86)."""
const I64 SYS_UNLINK = 87
"""Linux x86_64 syscall number for unlink (87)."""
const I64 SYS_SYMLINK = 88
"""Linux x86_64 syscall number for symlink (88)."""
const I64 SYS_READLINK = 89
"""Linux x86_64 syscall number for readlink (89)."""
const I64 SYS_CHMOD = 90
"""Linux x86_64 syscall number for chmod (90)."""
const I64 SYS_FCHMOD = 91
"""Linux x86_64 syscall number for fchmod (91)."""
const I64 SYS_CHOWN = 92
"""Linux x86_64 syscall number for chown (92)."""
const I64 SYS_FCHOWN = 93
"""Linux x86_64 syscall number for fchown (93)."""
const I64 SYS_FSYNC = 74
"""Linux x86_64 syscall number for fsync (74)."""
const I64 SYS_FLOCK = 73
"""Linux x86_64 syscall number for flock (73)."""
const I64 SYS_GETDENTS64 = 217
"""Linux x86_64 syscall number for getdents64 (217)."""
const I64 SYS_STATFS = 137
"""Linux x86_64 syscall number for statfs (137)."""

const I64 O_RDONLY = 0
"""Open flag for read-only access."""
const I64 O_WRONLY = 1
"""Open flag for write-only access."""
const I64 O_RDWR = 2
"""Open flag for read-write access."""
const I64 O_CREAT = 64
"""Open flag to create the file if it does not exist."""
const I64 O_EXCL = 128
"""Open flag to fail if O_CREAT is set and the file already exists."""
const I64 O_TRUNC = 512
"""Open flag to truncate the file to zero length on open."""
const I64 O_APPEND = 1024
"""Open flag to append writes to the end of the file."""
const I64 O_CLOEXEC = 524288
"""Open flag to set close-on-exec for the file descriptor."""
const I64 O_DIRECTORY = 65536
"""Open flag to fail if the path is not a directory."""

const I64 SEEK_SET = 0
"""Seek origin: absolute position from file start."""
const I64 SEEK_CUR = 1
"""Seek origin: relative to current position."""
const I64 SEEK_END = 2
"""Seek origin: relative to end of file."""

const I64 LOCK_SH = 1
"""File lock operation: shared (read) lock."""
const I64 LOCK_EX = 2
"""File lock operation: exclusive (write) lock."""
const I64 LOCK_UN = 8
"""File lock operation: unlock."""
const I64 LOCK_NB = 4
"""File lock modifier: non-blocking, can be OR'd with LOCK_SH or LOCK_EX."""

const I64 F_OK = 0
"""Access check mode: test for existence."""
const I64 R_OK = 4
"""Access check mode: test for read permission."""
const I64 W_OK = 2
"""Access check mode: test for write permission."""
const I64 X_OK = 1
"""Access check mode: test for execute permission."""

const I64 S_IFMT = 61440
"""Bitmask for the file type field in st_mode (0xF000)."""
const I64 S_IFREG = 32768
"""File type constant for regular file (0x8000)."""
const I64 S_IFDIR = 16384
"""File type constant for directory (0x4000)."""
const I64 S_IFLNK = 40960
"""File type constant for symbolic link (0xA000)."""
const I64 S_IFIFO = 4096
"""File type constant for named pipe / FIFO (0x1000)."""
const I64 S_IFSOCK = 49152
"""File type constant for socket (0xC000)."""
const I64 S_IFCHR = 8192
"""File type constant for character device (0x2000)."""
const I64 S_IFBLK = 24576
"""File type constant for block device (0x6000)."""

const I64 TCGETS = 21505
"""Ioctl request code to get terminal attributes."""
const I64 TCSETS = 21506
"""Ioctl request code to set terminal attributes."""
const I64 TIOCGWINSZ = 21523
"""Ioctl request code to get terminal window size."""
const I64 ECHO_FLAG = 8
"""Terminal flag bit for echo mode."""
const I64 ICANON_FLAG = 2
"""Terminal flag bit for canonical (line-buffered) input mode."""

const I64 ENOENT = 2
"""Errno: no such file or directory."""
const I64 EACCES = 13
"""Errno: permission denied."""
const I64 EEXIST = 17
"""Errno: file already exists."""
const I64 EISDIR = 21
"""Errno: is a directory."""
const I64 ENOTDIR = 20
"""Errno: not a directory."""
const I64 ENOTEMPTY = 39
"""Errno: directory not empty."""
const I64 EPIPE = 32
"""Errno: broken pipe."""

public function stringToPtr( String content ) -> I64:

    """
    Convert a String value to its raw memory address by extracting the
    underlying pointer via inline assembly.

    Parameters:
        content (String):
            The string to extract the pointer from.

    Returns:
        I64:
            The raw memory address of the string data.
    """

    I64 address = 0
    asm volatile "movq $1, $0" : output( "=r" address ) : input( "r" content ) : clobber()
    return address

public function stringLen( String content ) -> I64:

    """
    Compute the length of a null-terminated string by scanning for the
    zero byte.

    Parameters:
        content (String):
            The string to measure.

    Returns:
        I64:
            The number of bytes before the null terminator.

    Complexity:
        Time: O(n) where n is the string length.
    """

    I64 contentAddress = stringToPtr( content )
    I64 byteCount = 0
    I64 currentByte = 1
    while currentByte != 0:
        currentByte = readByteAt( contentAddress, byteCount )
        if currentByte != 0:
            byteCount = byteCount + 1
    return byteCount

public function memoryToPtr( Memory<I64> m ) -> I64:
    
    """
    Convert a Memory<I64> value to its raw memory address by extracting
    the underlying pointer via inline assembly.
    
    Parameters:
        m (Memory<I64>):
            The memory object to extract the pointer from.
    
    Returns:
        I64:
            The raw memory address of the memory block.
    """
    
    I64 ptr = 0
    asm volatile "movq $1, $0" : output( "=r" ptr ) : input( "r" m ) : clobber()
    return ptr

public function readByteAt( I64 addr, I64 offset ) -> I64:
    
    """
    Read a single unsigned byte from memory at the given address plus
    offset and zero-extend it to I64.
    
    Parameters:
        addr (I64):
            The base memory address.
        offset (I64):
            The byte offset from the base address.
    
    Returns:
        I64:
            The byte value (0-255) at the effective address.
    """
    
    I64 result = 0
    I64 effective = addr + offset
    asm volatile "movzbq ($1), $0" : output( "=r" result ) : input( "r" effective ) : clobber()
    return result

public function readI16At( I64 addr, I64 offset ) -> I64:
    
    """
    Read an unsigned 16-bit integer from memory at the given address
    plus offset and zero-extend it to I64.
    
    Parameters:
        addr (I64):
            The base memory address.
        offset (I64):
            The byte offset from the base address.
    
    Returns:
        I64:
            The 16-bit value zero-extended to I64.
    """
    
    I64 result = 0
    I64 effective = addr + offset
    asm volatile "movzwq ($1), $0" : output( "=r" result ) : input( "r" effective ) : clobber()
    return result

public function readI32At( I64 addr, I64 offset ) -> I64:
    
    """
    Read a 32-bit integer from memory at the given address plus offset
    and zero-extend it to I64.
    
    Parameters:
        addr (I64):
            The base memory address.
        offset (I64):
            The byte offset from the base address.
    
    Returns:
        I64:
            The 32-bit value zero-extended to I64.
    """
    
    I64 result = 0
    I64 effective = addr + offset
    asm volatile "movl ($1), ${0:k}" : output( "=r" result ) : input( "r" effective ) : clobber()
    return result

public function readI64At( I64 addr, I64 offset ) -> I64:
    
    """
    Read a 64-bit integer from memory at the given address plus offset.
    
    Parameters:
        addr (I64):
            The base memory address.
        offset (I64):
            The byte offset from the base address.
    
    Returns:
        I64:
            The 64-bit value at the effective address.
    """
    
    I64 result = 0
    I64 effective = addr + offset
    asm volatile "movq ($1), $0" : output( "=r" result ) : input( "r" effective ) : clobber()
    return result

public function writeByteAt( I64 addr, I64 offset, I64 val ) -> Void:
    
    """
    Write the low byte of val to memory at the given address plus
    offset.
    
    Parameters:
        addr (I64):
            The base memory address.
        offset (I64):
            The byte offset from the base address.
        val (I64):
            The value whose low byte will be written.
    """
    
    I64 effective = addr + offset
    asm volatile "movb ${1:b}, ($0)" : : input( "r" effective, "q" val ) : clobber( "memory" )

public function writeI16At( I64 addr, I64 offset, I64 val ) -> Void:
    
    """
    Write the low 16 bits of val to memory at the given address plus
    offset.
    
    Parameters:
        addr (I64):
            The base memory address.
        offset (I64):
            The byte offset from the base address.
        val (I64):
            The value whose low 16 bits will be written.
    """
    
    I64 effective = addr + offset
    asm volatile "movw ${1:w}, ($0)" : : input( "r" effective, "r" val ) : clobber( "memory" )

public function writeI32At( I64 addr, I64 offset, I64 val ) -> Void:
    
    """
    Write the low 32 bits of val to memory at the given address plus
    offset.
    
    Parameters:
        addr (I64):
            The base memory address.
        offset (I64):
            The byte offset from the base address.
        val (I64):
            The value whose low 32 bits will be written.
    """
    
    I64 effective = addr + offset
    asm volatile "movl ${1:k}, ($0)" : : input( "r" effective, "r" val ) : clobber( "memory" )

public function writeI64At( I64 addr, I64 offset, I64 val ) -> Void:
    
    """
    Write a full 64-bit value to memory at the given address plus
    offset.
    
    Parameters:
        addr (I64):
            The base memory address.
        offset (I64):
            The byte offset from the base address.
        val (I64):
            The 64-bit value to write.
    """
    
    I64 effective = addr + offset
    asm volatile "movq $1, ($0)" : : input( "r" effective, "r" val ) : clobber( "memory" )

public function raiseFromErrno( I64 errCode, String context ) -> Void:
    
    """
    Translate a Linux errno value into the appropriate Uranite IOError
    subclass and raise it. Maps known errno values to specific error
    types such as FileNotFoundError, PermissionError, and others.
    Falls back to a generic IOError for unrecognized errno values.
    
    Parameters:
        errCode (I64):
            The Linux errno value returned by a failed syscall.
        context (String):
            A human-readable description of the operation that failed.
    
    Raises:
        FileNotFoundError:
            When errCode is ENOENT (2).
        PermissionError:
            When errCode is EACCES (13).
        FileExistsError:
            When errCode is EEXIST (17).
        IsADirectoryError:
            When errCode is EISDIR (21).
        NotADirectoryError:
            When errCode is ENOTDIR (20).
        DirectoryNotEmptyError:
            When errCode is ENOTEMPTY (39).
        BrokenPipeError:
            When errCode is EPIPE (32).
        IOError:
            For all other errno values.
    
    Complexity:
        Time: O(1)
        Space: O(1)
    """
    
    if errCode == ENOENT:
        raise new FileNotFoundError( context, errCode, None )
    elif errCode == EACCES:
        raise new PermissionError( context, errCode, None )
    elif errCode == EEXIST:
        raise new FileExistsError( context, errCode, None )
    elif errCode == EISDIR:
        raise new IsADirectoryError( context, errCode, None )
    elif errCode == ENOTDIR:
        raise new NotADirectoryError( context, errCode, None )
    elif errCode == ENOTEMPTY:
        raise new DirectoryNotEmptyError( context, errCode, None )
    elif errCode == EPIPE:
        raise new BrokenPipeError( context, errCode, None )
    else:
        raise new IOError( context, errCode, None )

public function sysOpen( I64 pathPtr, I64 flags, I64 mode ) -> I64:
    
    """
    Open a file via the Linux open syscall.
    
    Parameters:
        pathPtr (I64):
            Pointer to the null-terminated path string.
        flags (I64):
            Open flags (O_RDONLY, O_WRONLY, O_CREAT, etc.).
        mode (I64):
            File permission mode, used when O_CREAT is set.
    
    Returns:
        I64:
            The new file descriptor.
    
    Raises:
        IOError:
            If the syscall fails, with a subclass matching the errno.
    """
    
    SyscallResult syscallResult =syscall3( SYS_OPEN, pathPtr, flags, mode )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "open failed" )
    return syscallResult.value()

public function sysClose( I64 fd ) -> Void:
    
    """
    Close a file descriptor via the Linux close syscall.
    
    Parameters:
        fd (I64):
            The file descriptor to close.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall1( SYS_CLOSE, fd )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "close failed" )

public function sysRead( I64 fd, I64 bufPtr, I64 count ) -> I64:
    
    """
    Read bytes from a file descriptor via the Linux read syscall.
    
    Parameters:
        fd (I64):
            The file descriptor to read from.
        bufPtr (I64):
            Pointer to the destination buffer.
        count (I64):
            Maximum number of bytes to read.
    
    Returns:
        I64:
            The number of bytes actually read.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall3( SYS_READ, fd, bufPtr, count )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "read failed" )
    return syscallResult.value()

public function sysWrite( I64 fd, I64 bufPtr, I64 count ) -> I64:
    
    """
    Write bytes to a file descriptor via the Linux write syscall.
    
    Parameters:
        fd (I64):
            The file descriptor to write to.
        bufPtr (I64):
            Pointer to the source buffer.
        count (I64):
            Number of bytes to write.
    
    Returns:
        I64:
            The number of bytes actually written.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall3( SYS_WRITE, fd, bufPtr, count )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "write failed" )
    return syscallResult.value()

public function sysLseek( I64 fd, I64 offset, I64 whence ) -> I64:
    
    """
    Reposition the file offset of a file descriptor via the Linux
    lseek syscall.
    
    Parameters:
        fd (I64):
            The file descriptor to seek.
        offset (I64):
            The offset in bytes.
        whence (I64):
            The reference point: SEEK_SET, SEEK_CUR, or SEEK_END.
    
    Returns:
        I64:
            The resulting offset from the beginning of the file.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall3( SYS_LSEEK, fd, offset, whence )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "lseek failed" )
    return syscallResult.value()

public function sysStat( I64 pathPtr, I64 statBufPtr ) -> Void:
    
    """
    Obtain file status for a path via the Linux stat syscall. Follows
    symbolic links.
    
    Parameters:
        pathPtr (I64):
            Pointer to the null-terminated path string.
        statBufPtr (I64):
            Pointer to a 144-byte buffer to receive the stat structure.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall2( SYS_STAT, pathPtr, statBufPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "stat failed" )

public function sysFstat( I64 fd, I64 statBufPtr ) -> Void:
    
    """
    Obtain file status for an open file descriptor via the Linux fstat
    syscall.
    
    Parameters:
        fd (I64):
            The open file descriptor to stat.
        statBufPtr (I64):
            Pointer to a 144-byte buffer to receive the stat structure.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall2( SYS_FSTAT, fd, statBufPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "fstat failed" )

public function sysLstat( I64 pathPtr, I64 statBufPtr ) -> Void:
    
    """
    Obtain file status for a path via the Linux lstat syscall. Does
    not follow symbolic links.
    
    Parameters:
        pathPtr (I64):
            Pointer to the null-terminated path string.
        statBufPtr (I64):
            Pointer to a 144-byte buffer to receive the stat structure.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall2( SYS_LSTAT, pathPtr, statBufPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "lstat failed" )

public function sysFtruncate( I64 fd, I64 length ) -> Void:
    
    """
    Truncate or extend a file to a specified length via the Linux
    ftruncate syscall.
    
    Parameters:
        fd (I64):
            The file descriptor of the file to truncate.
        length (I64):
            The desired file size in bytes.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall2( SYS_FTRUNCATE, fd, length )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "ftruncate failed" )

public function sysFsync( I64 fd ) -> Void:
    
    """
    Synchronize a file's in-core state with its storage device via
    the Linux fsync syscall.
    
    Parameters:
        fd (I64):
            The file descriptor to synchronize.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall1( SYS_FSYNC, fd )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "fsync failed" )

public function sysMkdir( I64 pathPtr, I64 mode ) -> Void:
    
    """
    Create a directory via the Linux mkdir syscall.
    
    Parameters:
        pathPtr (I64):
            Pointer to the null-terminated directory path.
        mode (I64):
            The permission mode for the new directory.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall2( SYS_MKDIR, pathPtr, mode )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "mkdir failed" )

public function sysRmdir( I64 pathPtr ) -> Void:
    
    """
    Remove an empty directory via the Linux rmdir syscall.
    
    Parameters:
        pathPtr (I64):
            Pointer to the null-terminated directory path.
    
