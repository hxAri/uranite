    SyscallResult syscallResult =syscall1( SYS_RMDIR, pathPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "rmdir failed" )

public function sysUnlink( I64 pathPtr ) -> Void:
    
    """
    Delete a file (remove a directory entry) via the Linux unlink
    syscall.
    
    Parameters:
        pathPtr (I64):
            Pointer to the null-terminated file path.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall1( SYS_UNLINK, pathPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "unlink failed" )

public function sysRename( I64 oldPtr, I64 newPtr ) -> Void:
    
    """
    Rename a file or directory via the Linux rename syscall.
    
    Parameters:
        oldPtr (I64):
            Pointer to the null-terminated old path.
        newPtr (I64):
            Pointer to the null-terminated new path.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall2( SYS_RENAME, oldPtr, newPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "rename failed" )

public function sysLink( I64 oldPtr, I64 newPtr ) -> Void:
    
    """
    Create a hard link via the Linux link syscall.
    
    Parameters:
        oldPtr (I64):
            Pointer to the null-terminated existing path.
        newPtr (I64):
            Pointer to the null-terminated new link path.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall2( SYS_LINK, oldPtr, newPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "link failed" )

public function sysSymlink( I64 targetPtr, I64 linkPtr ) -> Void:
    
    """
    Create a symbolic link via the Linux symlink syscall.
    
    Parameters:
        targetPtr (I64):
            Pointer to the null-terminated target path.
        linkPtr (I64):
            Pointer to the null-terminated symbolic link path.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall2( SYS_SYMLINK, targetPtr, linkPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "symlink failed" )

public function sysReadlink( I64 pathPtr, I64 bufPtr, I64 bufSize ) -> I64:
    
    """
    Read the target of a symbolic link via the Linux readlink syscall.
    
    Parameters:
        pathPtr (I64):
            Pointer to the null-terminated symlink path.
        bufPtr (I64):
            Pointer to the buffer to receive the link target.
        bufSize (I64):
            The size of the destination buffer in bytes.
    
    Returns:
        I64:
            The number of bytes placed in the buffer (not null-terminated
            by the syscall).
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall3( SYS_READLINK, pathPtr, bufPtr, bufSize )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "readlink failed" )
    return syscallResult.value()

public function sysChmod( I64 pathPtr, I64 mode ) -> Void:
    
    """
    Change file permissions via the Linux chmod syscall.
    
    Parameters:
        pathPtr (I64):
            Pointer to the null-terminated file path.
        mode (I64):
            The new permission mode bits.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall2( SYS_CHMOD, pathPtr, mode )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "chmod failed" )

public function sysFchmod( I64 fd, I64 mode ) -> Void:
    
    """
    Change file permissions for an open file descriptor via the Linux
    fchmod syscall.
    
    Parameters:
        fd (I64):
            The file descriptor to modify.
        mode (I64):
            The new permission mode bits.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall2( SYS_FCHMOD, fd, mode )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "fchmod failed" )

public function sysChown( I64 pathPtr, I64 uid, I64 gid ) -> Void:
    
    """
    Change file ownership via the Linux chown syscall.
    
    Parameters:
        pathPtr (I64):
            Pointer to the null-terminated file path.
        uid (I64):
            The new owner user ID.
        gid (I64):
            The new owner group ID.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall3( SYS_CHOWN, pathPtr, uid, gid )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "chown failed" )

public function sysFchown( I64 fd, I64 uid, I64 gid ) -> Void:
    
    """
    Change file ownership for an open file descriptor via the Linux
    fchown syscall.
    
    Parameters:
        fd (I64):
            The file descriptor to modify.
        uid (I64):
            The new owner user ID.
        gid (I64):
            The new owner group ID.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall3( SYS_FCHOWN, fd, uid, gid )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "fchown failed" )

public function sysAccess( I64 pathPtr, I64 mode ) -> Boolean:
    
    """
    Check file accessibility via the Linux access syscall. Unlike other
    syscall wrappers, this does not raise on failure but returns a
    Boolean indicating whether the check passed.
    
    Parameters:
        pathPtr (I64):
            Pointer to the null-terminated file path.
        mode (I64):
            The access mode to check (F_OK, R_OK, W_OK, X_OK).
    
    Returns:
        Boolean:
            True if the access check passed, False otherwise.
    """
    
    SyscallResult syscallResult =syscall2( SYS_ACCESS, pathPtr, mode )
    return syscallResult.isOk()

public function sysGetcwd( I64 bufPtr, I64 size ) -> I64:
    
    """
    Get the current working directory via the Linux getcwd syscall.
    
    Parameters:
        bufPtr (I64):
            Pointer to the buffer to receive the null-terminated path.
        size (I64):
            The size of the buffer in bytes.
    
    Returns:
        I64:
            The length of the path written to the buffer.
    
    Raises:
        IOError:
            If the syscall fails.
    """
    
    SyscallResult syscallResult =syscall2( SYS_GETCWD, bufPtr, size )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "getcwd failed" )
    return syscallResult.value()

public function sysChdir( I64 pathPtr ) -> Void:
    
    """
    Change the current working directory via the Linux chdir syscall.
    
    Parameters:
        pathPtr (I64):
