const I64 O_RDONLY = 0
"""Open flag for read-only access."""
const I64 O_WRONLY = 1
"""Open flag for write-only access."""
const I64 O_RDWR = 2
"""Open flag for read-write access."""
const I64 O_CREAT = 64
"""Open flag to create the file if it does not exist."""
const I64 O_EXCL = 128
"""Open flag to fail if O_CREAT is set and the file already exists."""
const I64 O_TRUNC = 512
"""Open flag to truncate the file to zero length on open."""
const I64 O_APPEND = 1024
"""Open flag to append writes to the end of the file."""
const I64 O_CLOEXEC = 524288
"""Open flag to set close-on-exec for the file descriptor."""
const I64 O_DIRECTORY = 65536
"""Open flag to fail if the path is not a directory."""

const I64 SEEK_SET = 0
"""Seek origin: absolute position from file start."""
const I64 SEEK_CUR = 1
"""Seek origin: relative to current position."""
const I64 SEEK_END = 2
"""Seek origin: relative to end of file."""

const I64 LOCK_SH = 1
"""File lock operation: shared (read) lock."""
const I64 LOCK_EX = 2
"""File lock operation: exclusive (write) lock."""
const I64 LOCK_UN = 8
"""File lock operation: unlock."""
const I64 LOCK_NB = 4
"""File lock modifier: non-blocking, can be OR'd with LOCK_SH or LOCK_EX."""

const I64 F_OK = 0
"""Access check mode: test for existence."""
const I64 R_OK = 4
"""Access check mode: test for read permission."""
const I64 W_OK = 2
"""Access check mode: test for write permission."""
const I64 X_OK = 1
"""Access check mode: test for execute permission."""

const I64 S_IFMT = 61440
"""Bitmask for the file type field in st_mode (0xF000)."""
const I64 S_IFREG = 32768
"""File type constant for regular file (0x8000)."""
const I64 S_IFDIR = 16384
"""File type constant for directory (0x4000)."""
const I64 S_IFLNK = 40960
"""File type constant for symbolic link (0xA000)."""
const I64 S_IFIFO = 4096
"""File type constant for named pipe / FIFO (0x1000)."""
const I64 S_IFSOCK = 49152
"""File type constant for socket (0xC000)."""
const I64 S_IFCHR = 8192
"""File type constant for character device (0x2000)."""
const I64 S_IFBLK = 24576
"""File type constant for block device (0x6000)."""

const I64 TCGETS = 21505
"""Ioctl request code to get terminal attributes."""
const I64 TCSETS = 21506
"""Ioctl request code to set terminal attributes."""
const I64 TIOCGWINSZ = 21523
"""Ioctl request code to get terminal window size."""
const I64 ECHO_FLAG = 8
"""Terminal flag bit for echo mode."""
const I64 ICANON_FLAG = 2
"""Terminal flag bit for canonical (line-buffered) input mode."""

const I64 ENOENT = 2
"""Errno: no such file or directory."""
const I64 EACCES = 13
"""Errno: permission denied."""
const I64 EEXIST = 17
"""Errno: file already exists."""
const I64 EISDIR = 21
"""Errno: is a directory."""
const I64 ENOTDIR = 20
"""Errno: not a directory."""
const I64 ENOTEMPTY = 39
"""Errno: directory not empty."""
const I64 EPIPE = 32
"""Errno: broken pipe."""

public function stringLen( String content ) -> I64:

    """
    Compute the length of a null-terminated string by scanning for the
    zero byte.

    Parameters:
        content (String):
            The string to measure.

    Returns:
        I64:
            The number of bytes before the null terminator.

    Complexity:
        Time: O(n) where n is the string length.
    """

    I64 contentAddress = stringToPtr( content )
    I64 byteCount = 0
    I64 currentByte = 1
    while currentByte != 0:
        currentByte = readByteAt( contentAddress, byteCount )
        if currentByte != 0:
            byteCount = byteCount + 1
    return byteCount

public function raiseFromErrno( I64 errCode, String context ) -> Void:

    """
    Translate a Linux errno value into the appropriate Uranite IOError
    subclass and raise it. Falls back to a generic IOError for
    unrecognized errno values.

    Parameters:
        errCode (I64):
            The Linux errno value returned by a failed syscall.
        context (String):
            A human-readable description of the operation that failed.

    Raises:
        FileNotFoundError, PermissionError, FileExistsError,
        IsADirectoryError, NotADirectoryError, DirectoryNotEmptyError,
        BrokenPipeError, or IOError depending on errCode.

    Complexity:
        Time: O(1)
        Space: O(1)
    """

    if errCode == ENOENT:
        raise new FileNotFoundError( context, errCode, None )
    elif errCode == EACCES:
        raise new PermissionError( context, errCode, None )
    elif errCode == EEXIST:
        raise new FileExistsError( context, errCode, None )
    elif errCode == EISDIR:
        raise new IsADirectoryError( context, errCode, None )
    elif errCode == ENOTDIR:
        raise new NotADirectoryError( context, errCode, None )
    elif errCode == ENOTEMPTY:
        raise new DirectoryNotEmptyError( context, errCode, None )
    elif errCode == EPIPE:
        raise new BrokenPipeError( context, errCode, None )
    else:
        raise new IOError( context, errCode, None )

public function sysOpen( I64 pathPtr, I64 flags, I64 mode ) -> I64:

    """
    Open a file. Uses the open syscall on x86-64 and openat on aarch64.

    Raises:
        IOError:
            If the syscall fails, with a subclass matching the errno.
    """

    SyscallResult syscallResult = scOpen( pathPtr, flags, mode )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "open failed" )
    return syscallResult.value()

public function sysClose( I64 fd ) -> Void:

    """
    Close a file descriptor.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = syscall1( SYS_CLOSE, fd )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "close failed" )

public function sysRead( I64 fd, I64 bufPtr, I64 count ) -> I64:

    """
    Read bytes from a file descriptor.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = syscall3( SYS_READ, fd, bufPtr, count )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "read failed" )
    return syscallResult.value()

public function sysWrite( I64 fd, I64 bufPtr, I64 count ) -> I64:

    """
    Write bytes to a file descriptor.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = syscall3( SYS_WRITE, fd, bufPtr, count )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "write failed" )
    return syscallResult.value()

public function sysLseek( I64 fd, I64 offset, I64 whence ) -> I64:

    """
    Reposition the file offset of a file descriptor.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = syscall3( SYS_LSEEK, fd, offset, whence )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "lseek failed" )
    return syscallResult.value()

public function sysStat( I64 pathPtr, I64 statBufPtr ) -> Void:

    """
    Obtain file status for a path, following symbolic links. Uses stat on
    x86-64 and newfstatat on aarch64.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = scStat( pathPtr, statBufPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "stat failed" )

public function sysFstat( I64 fd, I64 statBufPtr ) -> Void:

    """
    Obtain file status for an open file descriptor.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = syscall2( SYS_FSTAT, fd, statBufPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "fstat failed" )

public function sysLstat( I64 pathPtr, I64 statBufPtr ) -> Void:

    """
    Obtain file status for a path without following symbolic links. Uses
    lstat on x86-64 and newfstatat with AT_SYMLINK_NOFOLLOW on aarch64.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = scLstat( pathPtr, statBufPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "lstat failed" )

public function sysFtruncate( I64 fd, I64 length ) -> Void:

    """
    Truncate or extend a file to a specified length.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = syscall2( SYS_FTRUNCATE, fd, length )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "ftruncate failed" )

public function sysFsync( I64 fd ) -> Void:

    """
    Synchronize a file's in-core state with its storage device.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = syscall1( SYS_FSYNC, fd )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "fsync failed" )

public function sysMkdir( I64 pathPtr, I64 mode ) -> Void:

    """
    Create a directory. Uses mkdir on x86-64 and mkdirat on aarch64.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = scMkdir( pathPtr, mode )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "mkdir failed" )

public function sysRmdir( I64 pathPtr ) -> Void:

    """
    Remove an empty directory. Uses rmdir on x86-64 and unlinkat with
    AT_REMOVEDIR on aarch64.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = scRmdir( pathPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "rmdir failed" )

public function sysUnlink( I64 pathPtr ) -> Void:

    """
    Delete a file. Uses unlink on x86-64 and unlinkat on aarch64.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = scUnlink( pathPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "unlink failed" )

public function sysRename( I64 oldPtr, I64 newPtr ) -> Void:

    """
    Rename a file or directory. Uses rename on x86-64 and renameat on aarch64.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = scRename( oldPtr, newPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "rename failed" )

public function sysLink( I64 oldPtr, I64 newPtr ) -> Void:

    """
    Create a hard link. Uses link on x86-64 and linkat on aarch64.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = scLink( oldPtr, newPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "link failed" )

public function sysSymlink( I64 targetPtr, I64 linkPtr ) -> Void:

    """
    Create a symbolic link. Uses symlink on x86-64 and symlinkat on aarch64.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = scSymlink( targetPtr, linkPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "symlink failed" )

public function sysReadlink( I64 pathPtr, I64 bufPtr, I64 bufSize ) -> I64:

    """
    Read the target of a symbolic link. Uses readlink on x86-64 and
    readlinkat on aarch64.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = scReadlink( pathPtr, bufPtr, bufSize )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "readlink failed" )
    return syscallResult.value()

public function sysChmod( I64 pathPtr, I64 mode ) -> Void:

    """
    Change file permissions. Uses chmod on x86-64 and fchmodat on aarch64.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = scChmod( pathPtr, mode )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "chmod failed" )

public function sysFchmod( I64 fd, I64 mode ) -> Void:

    """
    Change file permissions for an open file descriptor.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = syscall2( SYS_FCHMOD, fd, mode )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "fchmod failed" )

public function sysChown( I64 pathPtr, I64 uid, I64 gid ) -> Void:

    """
    Change file ownership. Uses chown on x86-64 and fchownat on aarch64.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = scChown( pathPtr, uid, gid )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "chown failed" )

public function sysFchown( I64 fd, I64 uid, I64 gid ) -> Void:

    """
    Change file ownership for an open file descriptor.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = syscall3( SYS_FCHOWN, fd, uid, gid )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "fchown failed" )

public function sysAccess( I64 pathPtr, I64 mode ) -> Boolean:

    """
    Check file accessibility. Uses access on x86-64 and faccessat on aarch64.
    Returns a Boolean rather than raising.

    Returns:
        Boolean:
            True if the access check passed, False otherwise.
    """

    SyscallResult syscallResult = scAccess( pathPtr, mode )
    return syscallResult.isOk()

public function sysGetcwd( I64 bufPtr, I64 size ) -> I64:

    """
    Get the current working directory.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = syscall2( SYS_GETCWD, bufPtr, size )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "getcwd failed" )
    return syscallResult.value()

public function sysChdir( I64 pathPtr ) -> Void:

    """
    Change the current working directory.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = syscall1( SYS_CHDIR, pathPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "chdir failed" )

public function sysGetdents64( I64 fd, I64 bufPtr, I64 bufSize ) -> I64:

    """
    Read directory entries.

    Returns:
        I64:
            Bytes read into the buffer, or 0 at end of directory.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = syscall3( SYS_GETDENTS64, fd, bufPtr, bufSize )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "getdents64 failed" )
    return syscallResult.value()

public function sysStatfs( I64 pathPtr, I64 bufPtr ) -> Void:

    """
    Obtain filesystem statistics.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = syscall2( SYS_STATFS, pathPtr, bufPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "statfs failed" )

public function sysFlock( I64 fd, I64 operation ) -> Void:

    """
    Apply or remove an advisory lock on a file.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = syscall2( SYS_FLOCK, fd, operation )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "flock failed" )

public function sysIoctl( I64 fd, I64 request, I64 argPtr ) -> I64:

    """
    Perform a device-specific I/O control operation.

    Returns:
        I64:
            The return value from the ioctl call.

    Raises:
        IOError:
            If the syscall fails.
    """

    SyscallResult syscallResult = syscall3( SYS_IOCTL, fd, request, argPtr )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "ioctl failed" )
    return syscallResult.value()

public function sysPipe2( I64 pipefdPtr, I64 flags ) -> Void:

    """
    Create a pipe with flags. The two file descriptors (read end, write end)
    are written to the memory at pipefdPtr.

    Raises:
        IOError:
            If the syscall fails.

    Complexity:
        Time: O(1)
        Space: O(1)
    """

    SyscallResult syscallResult = syscall2( SYS_PIPE2, pipefdPtr, flags )
    if syscallResult.isError():
        raiseFromErrno( syscallResult.errorCode(), "pipe2 failed" )

