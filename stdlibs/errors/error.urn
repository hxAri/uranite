package uranite.errors.error

from uranite.errors.throwable import Throwable
from uranite.errors.traceback import Traceback

public Readonly class Error implements Throwable:
    
    """
    Unrecoverable error that applications should not catch.
    
    Errors represent serious problems that a reasonable application should not
    attempt to recover from, such as out-of-memory conditions or internal
    compiler failures. They implement the Throwable interface for use with
    the raise mechanism.
    """
    
    protect I64 code
    protect String file
    protect I64 line
    protect String message
    protect ?Throwable previous
    protect ?Traceback traceback = None
    
    public function Error( self, String message, I64 code, ?Throwable previous ) -> Void:
        
        """
        Create a new error with a message, error code, and optional chained cause.
        
        Parameters:
            message (String):
                A human-readable description of the error condition.
            code (I64):
                A numeric error code identifying the type of error.
            previous (?Throwable):
                An optional previous throwable that caused this error, or None.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        self.code = code
        self.file = ""
        self.line = 0
        self.message = message
        self.previous = previous
    
    public function getCode( self ) -> I64:
        return self.code
    
    public function getFile( self ) -> String:
        return self.file
    
    public function getLine( self ) -> I64:
        return self.line
    
    public function getMessage( self ) -> String:
        return self.message
    
    public function getPrevious( self ) -> ?Throwable:
        return self.previous
    
    public function getTraceback( self ) -> ?Traceback:
        return self.traceback
    
    public function toString( self ) -> String:
        return self.message
