package uranite.errors.runtime



extern function __uranite_release_traceback_of( I64 throwableObjectAddress ) -> Void;
""" Release the heap-allocated traceback attached to the throwable stored at the given object address, freeing the frame buffer, every captured frame record, and the traceback container itself. Has no effect when the throwable carries no traceback or when the address is zero. """

export {
    __uranite_release_traceback_of
}
