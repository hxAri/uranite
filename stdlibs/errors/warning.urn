package uranite.errors.warning

from uranite.errors.throwable import Throwable
from uranite.errors.traceback import Traceback

public Readonly class Warning implements Throwable:
    
    """
    Non-fatal condition that may require attention but is less severe than an Error.
    
    Warnings represent situations that are not necessarily wrong but could indicate
    potential problems, such as deprecated API usage or suspicious but valid input.
    They implement the Throwable interface and can be raised and caught like exceptions.
    """
    
    protect I64 code
    protect String file
    protect I64 line
    protect String message
    protect ?Throwable previous
    protect ?Traceback traceback
    
    public function Warning( self, String message, I64 code, ?Throwable previous ) -> Void:
        
        """
        Create a new warning with a message, code, and optional chained cause.
        
        Parameters:
            message (String):
                A human-readable description of the warning condition.
            code (I64):
                A numeric code identifying the type of warning.
            previous (?Throwable):
                An optional previous throwable that caused this warning, or None.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        self.code = code
        self.file = ""
        self.line = 0
        self.message = message
        self.previous = previous
    
    public function getCode( self ) -> I64:
        return self.code
    
    public function getFile( self ) -> String:
        return self.file
    
    public function getLine( self ) -> I64:
        return self.line
    
    public function getMessage( self ) -> String:
        return self.message
    
    public function getPrevious( self ) -> ?Throwable:
        return self.previous
    
    public function getTraceback( self ) -> ?Traceback:
        return self.traceback
    
    public function toString( self ) -> String:
        return self.message
