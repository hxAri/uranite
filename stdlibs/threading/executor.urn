#
# High-level thread pool executor with typed futures. Workers dispatch
# calls via asm indirect call through a shared channel. Pure OS-module
# threading, no C/C++ runtime.
#
# Descriptor layout in Memory<I64>(6):
#   [0] = arity (0-3)
#   [1] = fnAddr (function pointer as I64)
#   [2] = futureBaseAddr (FutureBase pointer as I64)
#   [3] = arg1 (raw I64, if arity >= 1)
#   [4] = arg2 (raw I64, if arity >= 2)
#   [5] = arg3 (raw I64, if arity >= 3)
#
# This program is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# any later version.
#
