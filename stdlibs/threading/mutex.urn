package uranite.threading.mutex

from uranite.language.callable import Callable
from uranite.os.scheduler.scheduler import Scheduler
from uranite.os.sync.mutex import KernelMutex
from uranite.os.task.task import BlockReason
from uranite.threading.atomic import AtomicBoolean
from uranite.threading.errors import ThreadPoisonError

public class MutexGuard<T>:
    
    """
    Scoped access token for a Mutex<T>. Obtained from Mutex.lock() or
    Mutex.tryLock(), a MutexGuard grants exclusive read and write access
    to the protected data. The guard must be explicitly released via
    release() to unlock the mutex -- there is no automatic RAII cleanup.
    """
    
    protect Mutex<T> mutex
    """Reference to the owning mutex for data access and unlock delegation."""
    
    protect I64 ownerId
    """Task identifier of the lock holder, used for ownership verification on unlock."""
    
    public function MutexGuard( self, Mutex<T> mutex, I64 ownerId ) -> Void:
        
        """
        Create a new guard bound to the given mutex and owner.
        
        Parameters:
            mutex (Mutex<T>):
                The mutex this guard provides access to.
            ownerId (I64):
                The task identifier that acquired the lock.
        """
        
        self.mutex = mutex
        self.ownerId = ownerId
    
    public function get( self ) -> T:
        
        """
        Read the protected data.
        
        Returns:
            T:
                The current value of the data protected by the mutex.
        """
        
        return self.mutex.getData()
    
    public function set( self, T value ) -> Void:
        
        """
        Write a new value to the protected data.
        
        Parameters:
            value (T):
                The new value to store.
        """
        
        self.mutex.setData( value )
    
    public function release( self ) -> Void:
        
        """
        Release the lock, allowing other tasks to acquire the mutex.
        After calling release, this guard must not be used again.
        
        Complexity:
            Time: O(n)
            Space: O(1)
        """
        
        self.mutex.unlockInternal( self.ownerId )

public class Mutex<T>:
    
    """
    Data-protecting mutual exclusion lock. Owns the protected data -- the
    value is only accessible through a MutexGuard obtained from lock() or
    tryLock(). Supports poison detection: if a thread panics while holding
    the lock, subsequent lock attempts will raise a ThreadPoisonError.
    
    Built on KernelMutex from the OS sync module with cooperative blocking
    through the scheduler when contention occurs.
    """
    
    protect KernelMutex inner
    """Low-level kernel mutex providing the actual locking mechanism."""
    
    protect T data
    """The protected data value, only accessible through guards."""
    
    protect Scheduler scheduler
    """Scheduler used for cooperative blocking during lock contention."""
    
    protect AtomicBoolean poisoned
    """Atomic flag indicating whether the mutex has been poisoned."""
    
    public function Mutex( self, T value, Scheduler scheduler ) -> Void:
        
        """
        Create a new mutex protecting the given initial value.
        
        Parameters:
            value (T):
                The initial value to protect.
            scheduler (Scheduler):
                The scheduler to use for cooperative blocking when the mutex
                is contended.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        self.inner = new KernelMutex()
        self.data = value
        self.scheduler = scheduler
        self.poisoned = new AtomicBoolean( False )
    
    public function lock( self ) -> MutexGuard<T>:
        
        """
        Acquire the mutex, blocking the current task until the lock is
        available. Uses cooperative blocking through the scheduler,
        yielding the current task when the lock cannot be immediately
        acquired.
        
        Returns:
            MutexGuard<T>:
                A guard granting exclusive access to the protected data.
        
        Raises:
            ThreadPoisonError:
                If the mutex was poisoned by a panicked lock holder.

        Complexity:
            Time: O(1) amortized, unbounded under contention
            Space: O(1)
        """

        if self.poisoned.load():
            raise new ThreadPoisonError( "Mutex is poisoned", 1, None )

        I64 taskId = 0
        if self.scheduler.getCurrentTask() != None:
            taskId = self.scheduler.getCurrentTask().id
        
        Boolean acquired = self.inner.acquire( taskId )
        while acquired == False:
            self.scheduler.getCurrentTask().block( BlockReason.Mutex )
            self.scheduler.blockCurrent()
            acquired = self.inner.acquire( taskId )
        
        if self.poisoned.load():
            self.inner.release( taskId )
            raise new ThreadPoisonError( "Mutex is poisoned", 1, None )
        
        return new MutexGuard<T>( self, taskId )
    
    public function tryLock( self ) -> ?MutexGuard<T>:
        
        """
        Attempt to acquire the mutex without blocking. Returns immediately
        whether or not the lock was acquired.
        
        Returns:
            ?MutexGuard<T>:
                A guard granting exclusive access if the lock was acquired,
                or None if the mutex is already held or poisoned.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        if self.poisoned.load():
            return None
        
        I64 taskId = 0
        if self.scheduler.getCurrentTask() != None:
            taskId = self.scheduler.getCurrentTask().id
        
        Boolean acquired = self.inner.acquire( taskId )
        if acquired == False:
            return None
        
        return new MutexGuard<T>( self, taskId )
    
    public function getData( self ) -> T:
        
        """
        Return the raw protected data. Intended for internal use by
        MutexGuard only -- callers should access data through the guard.
        
        Returns:
            T:
                The current value of the protected data.
        """
        
        return self.data
    
    public function setData( self, T value ) -> Void:
        
        """
        Replace the protected data. Intended for internal use by
        MutexGuard only -- callers should modify data through the guard.
        
        Parameters:
            value (T):
                The new value to store.
        """
        
        self.data = value
    
    public function unlockInternal( self, I64 taskId ) -> Void:
        
        """
        Release the kernel mutex and yield the current task to allow other
        waiters to acquire the lock. Called by MutexGuard.release().
        
        Parameters:
            taskId (I64):
                The task identifier of the current lock holder.
        """
        
        self.inner.release( taskId )
        self.scheduler.yields()
    
    public function poison( self ) -> Void:
        
        """
        Mark the mutex as poisoned. Subsequent lock attempts will raise a
        ThreadPoisonError. Typically called when a thread panics while holding
        the lock.
        """
        
        self.poisoned.store( True )
    
    public function isPoisoned( self ) -> Boolean:
        
        """
        Check whether the mutex has been poisoned.
        
        Returns:
            Boolean:
                True if the mutex was poisoned by a panicked holder.
        """
        
        return self.poisoned.load()
    
    public function withLock( self, Callable<Void, <T>> criticalSection ) -> Void:

        """
        Acquire the mutex, execute the critical section callback with the
        protected data, and release the lock. Guarantees unlock on all exit
        paths including exceptions.

        Parameters:
            criticalSection (Callable<Void, <T>>):
                A callback receiving the protected data value.

        Raises:
            ThreadPoisonError:
                If the mutex is poisoned.

        Complexity:
            Time: O(1) for lock/unlock, plus O(criticalSection)
            Space: O(1)
        """

        MutexGuard<T> guard = self.lock()
        criticalSection( guard.get() )
        guard.release()

    public function destroy( self ) -> Void:

        """
        Release resources held by the mutex's poison flag.

        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.poisoned.destroy()

export {
    Mutex,
    MutexGuard
}
