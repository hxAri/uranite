package uranite.compression

from uranite.compression.gzip import {
    BitReader,
    BitWriter,
    HuffmanTable,
    deflateFixed,
    gzipCompress,
    gzipDecompress,
    inflate
}
from uranite.compression.lz4 import {
    lz4CompressBlock,
    lz4DecompressBlock,
    lz4FrameCompress,
    lz4FrameDecompress,
    lz4MaxCompressedSize
}
from uranite.compression.snappy import {
    snappyCompress,
    snappyDecompress,
    snappyMaxCompressedLength,
    snappyXerialCompress,
    snappyXerialDecompress
}
from uranite.compression.zstd import parseFrameHeader, zstdCompress, zstdDecompress, zstdMaxCompressedSize

export {
    BitReader,
    BitWriter,
    HuffmanTable,
    deflateFixed,
    gzipCompress,
    gzipDecompress,
    inflate,
    lz4CompressBlock,
    lz4DecompressBlock,
    lz4FrameCompress,
    lz4FrameDecompress,
    lz4MaxCompressedSize,
    parseFrameHeader,
    snappyCompress,
    snappyDecompress,
    snappyMaxCompressedLength,
    snappyXerialCompress,
    snappyXerialDecompress,
    zstdCompress,
    zstdDecompress,
    zstdMaxCompressedSize
}
