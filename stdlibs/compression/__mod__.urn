package uranite.compression

from uranite.compression.snappy import {
    snappyCompress, snappyDecompress,
    snappyXerialCompress, snappyXerialDecompress,
    snappyMaxCompressedLength
}
from uranite.compression.lz4 import {
    lz4CompressBlock, lz4DecompressBlock,
    lz4FrameCompress, lz4FrameDecompress,
    lz4MaxCompressedSize
}
from uranite.compression.gzip import {
    inflate, deflateFixed,
    gzipCompress, gzipDecompress,
    BitReader, BitWriter, HuffmanTable
}
from uranite.compression.zstd import {
    zstdCompress, zstdDecompress,
    zstdMaxCompressedSize,
    parseFrameHeader
}

export {
    snappyCompress, snappyDecompress,
    snappyXerialCompress, snappyXerialDecompress,
    snappyMaxCompressedLength,
    lz4CompressBlock, lz4DecompressBlock,
    lz4FrameCompress, lz4FrameDecompress,
    lz4MaxCompressedSize,
    inflate, deflateFixed,
    gzipCompress, gzipDecompress,
    BitReader, BitWriter, HuffmanTable,
    zstdCompress, zstdDecompress,
    zstdMaxCompressedSize,
    parseFrameHeader
}
