public function postForm( String url, String body ) -> Response:

    """
    Send an HTTP POST with URL-encoded form data.

    Parameters:
        url (String):
            The full URL.
        body (String):
            The URL-encoded form data.

    Returns:
        Response:
            The server's response.
    """

    return request( "POST", url, body, "application/x-www-form-urlencoded" )

public function postForm( I64 ip, I64 port, String path, String body ) -> Response:

    """
    Send an HTTP POST with URL-encoded form data using a raw IP address.

    Parameters:
        ip (I64):
            The target server IP as a packed 32-bit integer.
        port (I64):
            The target server port number.
        path (String):
            The request URI path.
        body (String):
            The URL-encoded form data.

    Returns:
        Response:
            The server's response.
    
    Complexity:
        Time: O(1)
        Space: O(1)
    """

    return request( "POST", ip, port, path, body, "application/x-www-form-urlencoded" )

export {
    request,
    get, post, put, del, patch, postForm
}
