public function postForm( String url, String body ) -> Response:

    """
    Send an HTTP POST with URL-encoded form data.

    Parameters:
        url (String):
            The full URL.
        body (String):
            The URL-encoded form data.

    Returns:
        Response:
            The server's response.
    """

    return request( "POST", url, body, "application/x-www-form-urlencoded" )

protect function postForm( String host, I64 port, String path, String body ) -> Response:

    """
    Send an HTTP POST with URL-encoded form data using host and port directly.

    Parameters:
        host (String):
            IPv4 address as dotted-decimal string.
        port (I64):
            The target server port number.
        path (String):
            The request URI path.
        body (String):
            The URL-encoded form data.

    Returns:
        Response:
            The server's response.

    Complexity:
        Time: O(n) where n is request + response size
        Space: O(n)
    """

    return request( "POST", host, port, path, body, "application/x-www-form-urlencoded" )

export {
    del,
    get,
    patch,
    post,
    postForm,
    put,
    request
}
