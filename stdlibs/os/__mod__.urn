package uranite.os

from uranite.os.bus import PciBus, PciDevice
from uranite.os.driver import {
    Driver, 
    DriverDescriptor, 
    DriverRegistry, 
    DriverState
}
from uranite.os.hal import InterruptTable, IrqEntry
from uranite.os.identity import ProcessIdentity
from uranite.os.io import {
    BufferCache, 
    BufferEntry, 
    DmaChannel, 
    DmaDescriptor, 
    IoRequestQueue
}
from uranite.os.ipc import {
    Event, 
    Message, 
    Port, 
    SharedMemoryRegistry, 
    SharedRegion
}
from uranite.os.memory import {
    AddressSpace, 
    KernelHeap, 
    KernelObject, 
    ObjectOps, 
    ObjectType, 
    PhysicalMemoryManager
}
from uranite.os.scheduler import Scheduler
from uranite.os.security import {
    Capability, 
    CapabilityFlag, 
    HandleEntry, 
    HandleTable
}
from uranite.os.syscall import {
    SyscallDispatch, 
    SyscallError, 
    SyscallNumber, 
    SyscallResult
}
from uranite.os.sync import {
    KernelMutex, 
    ReadWriteLock, 
    Semaphore, 
    Spinlock
}
from uranite.os.task import Task, TaskState
from uranite.os.vfs import {
    FileDescriptor, 
    FileDescriptorTable, 
    FileSystem, 
    FileSystemType, 
    MountEntry, 
    MountTable, 
    VNode, 
    VNodeCache, 
    VNodeType
}

export {
    
    # Hardware Abstraction & Bus: Low-level interrupt and bus management
    InterruptTable,
    IrqEntry,
    PciBus,
    PciDevice,

    # Driver Framework: Infrastructure for device drivers
    Driver,
    DriverDescriptor,
    DriverRegistry,
    DriverState,

    # Identity: Process credentials and ownership
    ProcessIdentity,

    # I/O Subsystem: High-performance data transfer and DMA
    BufferCache,
    BufferEntry,
    DmaChannel,
    DmaDescriptor,
    IoRequestQueue,

    # IPC: Inter-Process Communication mechanisms
    Event,
    Message,
    Port,
    SharedMemoryRegistry,
    SharedRegion,

    # Memory Management: Logic for physical/virtual memory and object lifecycle
    AddressSpace,
    KernelHeap,
    KernelObject,
    ObjectOps,
    ObjectType,
    PhysicalMemoryManager,

    # Tasking & Scheduling: Execution units and CPU scheduling logic
    Scheduler,
    Task,
    TaskState,

    # Security: Capability-based access control and handle management
    Capability,
    CapabilityFlag,
    HandleEntry,
    HandleTable,

    # System Interface: Gateway for userland-to-kernel communication
    SyscallDispatch,
    SyscallError,
    SyscallNumber,
    SyscallResult,

    # Synchronization: Primitives for multi-core concurrency control
    KernelMutex,
    ReadWriteLock,
    Semaphore,
    Spinlock,

    # Virtual File System: Abstraction for storage and filesystems
    FileDescriptor,
    FileDescriptorTable,
    FileSystem,
    FileSystemType,
    MountEntry,
    MountTable,
    VNode,
    VNodeCache,
    VNodeType
    
}
