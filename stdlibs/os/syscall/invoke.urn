# along with this program. If not, see <https://www.gnu.org/licenses/>.
#

package uranite.os.syscall.invoke

from uranite.os.arch.native.syscall import {
    syscall0,
    syscall1,
    syscall2,
    syscall3,
    syscall4,
    syscall5,
    syscall6
}

export {
    syscall0,
    syscall1,
    syscall2,
    syscall3,
    syscall4,
    syscall5,
    syscall6
}
