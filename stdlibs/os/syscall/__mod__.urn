package uranite.os.syscall

from uranite.os.syscall.dispatch import SyscallDispatch
from uranite.os.syscall.error import SyscallError
from uranite.os.syscall.invoke import {
    syscall0,
    syscall1,
    syscall2,
    syscall3,
    syscall4,
    syscall5,
    syscall6
}
from uranite.os.syscall.number import SyscallNumber
from uranite.os.syscall.result import SyscallResult

export {
    SyscallDispatch,
    SyscallError,
    SyscallNumber,
    SyscallResult,
    syscall0,
    syscall1,
    syscall2,
    syscall3,
    syscall4,
    syscall5,
    syscall6
}
