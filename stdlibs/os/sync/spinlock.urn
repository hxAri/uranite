package uranite.os.sync.spinlock

from uranite.os.arch.cpu import disableInterrupts, enableInterrupts, readRflags

public class Spinlock:

    """
    Atomic spinlock using xchg instruction for mutual exclusion. Suitable
    for user-space code or kernel code where interrupt management is handled
    externally by the caller. Does not modify interrupt state. For kernel
    contexts requiring automatic interrupt safety, use SpinlockIrq instead.
    """

    protect I64 locked

    public function Spinlock( self ) -> Void:

        """
        Construct an unlocked spinlock with the locked flag initialized
        to zero.
        """

        self.locked = 0

    public function lock( self ) -> Void:

        """
        Acquire the spinlock by spinning in a loop using atomic xchg
        until the lock is acquired. The pause instruction hints the CPU
        to reduce power consumption during the spin wait.
        
        Complexity:
            Time: O(n)
            Space: O(1)
        """

        I64 expected = 1
        I64 old = 1
        I64 lockAddr = addressof self.locked
        while old != 0:
            asm volatile:
                x86-64 "xchg $0, ($2)" : output( "=r" old ) : input( "0" expected, "r" lockAddr ) : clobber( "memory" )
                aarch64 "1: ldaxr $0, [$2]; stlxr w16, $1, [$2]; cbnz w16, 1b" : output( "=&r" old ) : input( "r" expected, "r" lockAddr ) : clobber( "memory", "x16" )
            if old != 0:
                asm volatile:
                    x86-64 "pause"
                    aarch64 "yield"

    public function unlock( self ) -> Void:

        """
        Release the spinlock by clearing the lock flag with a memory
        barrier to ensure all writes performed while the lock was held
        are visible before release.
        """

        asm volatile "" : : : clobber( "memory" )
        self.locked = 0

    public function tryLock( self ) -> Boolean:

        """
        Attempt to acquire the spinlock without spinning. Performs a
        single atomic exchange and returns True if the lock was
        successfully acquired, False if already held.

        Complexity:
            Time: O(1)
            Space: O(1)
        """

        I64 expected = 1
        I64 old = 0
        I64 lockAddr = addressof self.locked
        asm volatile:
            x86-64 "xchg $0, ($2)" : output( "=r" old ) : input( "0" expected, "r" lockAddr ) : clobber( "memory" )
            aarch64 "1: ldaxr $0, [$2]; stlxr w16, $1, [$2]; cbnz w16, 1b" : output( "=&r" old ) : input( "r" expected, "r" lockAddr ) : clobber( "memory", "x16" )
        if old != 0:
            return False
        return True

    public function isLocked( self ) -> Boolean:

        """ Return whether the spinlock is currently held. """

        return self.locked != 0

public class SpinlockIrq:

    """
    Interrupt-safe spinlock for kernel-context use. Saves the processor
    interrupt state (RFLAGS IF bit) and disables maskable interrupts before
    acquiring the lock, then restores the previous interrupt state on
    release. This prevents deadlock when an interrupt handler running on the
    same CPU attempts to acquire a lock already held by the interrupted code
    path. Each SpinlockIrq instance stores its own saved flags, so nested
    locking across different instances is safe.
    """

    protect I64 locked
    protect I64 savedFlags

    public function SpinlockIrq( self ) -> Void:

        """
        Construct an unlocked interrupt-safe spinlock with the locked flag
        and saved RFLAGS both initialized to zero.

        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.locked = 0
        self.savedFlags = 0

    public function lock( self ) -> Void:

        """
        Acquire the spinlock with interrupt protection. Reads the current
        RFLAGS register to capture the interrupt enable state, disables
        maskable interrupts via cli, then spins using atomic xchg until
        the lock is acquired. The saved RFLAGS value is stored for
        restoration when the lock is released.

        Complexity:
            Time: O(n)
            Space: O(1)
        """

        I64 flagsBeforeLock = readRflags()
        disableInterrupts()
        I64 expected = 1
        I64 old = 1
        I64 lockAddr = addressof self.locked
        while old != 0:
            asm volatile:
                x86-64 "xchg $0, ($2)" : output( "=r" old ) : input( "0" expected, "r" lockAddr ) : clobber( "memory" )
                aarch64 "1: ldaxr $0, [$2]; stlxr w16, $1, [$2]; cbnz w16, 1b" : output( "=&r" old ) : input( "r" expected, "r" lockAddr ) : clobber( "memory", "x16" )
            if old != 0:
                asm volatile:
                    x86-64 "pause"
                    aarch64 "yield"
        self.savedFlags = flagsBeforeLock

    public function unlock( self ) -> Void:

        """
        Release the spinlock and restore the interrupt state that was active
        before lock acquisition. A memory barrier ensures all writes performed
        while the lock was held are visible before release. Interrupts are
        re-enabled only if the IF flag (bit 9) was set in the saved RFLAGS
        register, preserving the caller's original interrupt disposition.
        """

        I64 flagsBeforeUnlock = self.savedFlags
        asm volatile "" : : : clobber( "memory" )
        self.locked = 0
        I64 interruptFlagMask = 512
        if ( flagsBeforeUnlock & interruptFlagMask ) != 0:
            enableInterrupts()

    public function tryLock( self ) -> Boolean:

        """
        Attempt to acquire the interrupt-safe spinlock without spinning.
        Saves RFLAGS and disables interrupts before the single atomic
        exchange attempt. If the lock is already held, restores the previous
        interrupt state before returning False. Returns True on successful
        acquisition.

        Complexity:
            Time: O(1)
            Space: O(1)
        """

        I64 flagsBeforeLock = readRflags()
        disableInterrupts()
        I64 expected = 1
        I64 old = 0
        I64 lockAddr = addressof self.locked
        asm volatile:
            x86-64 "xchg $0, ($2)" : output( "=r" old ) : input( "0" expected, "r" lockAddr ) : clobber( "memory" )
            aarch64 "1: ldaxr $0, [$2]; stlxr w16, $1, [$2]; cbnz w16, 1b" : output( "=&r" old ) : input( "r" expected, "r" lockAddr ) : clobber( "memory", "x16" )
        if old != 0:
            I64 interruptFlagMask = 512
            if ( flagsBeforeLock & interruptFlagMask ) != 0:
                enableInterrupts()
            return False
        self.savedFlags = flagsBeforeLock
        return True

    public function isLocked( self ) -> Boolean:

        """ Return whether the interrupt-safe spinlock is currently held. """

        return self.locked != 0

export {
    Spinlock,
    SpinlockIrq
}
