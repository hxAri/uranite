package uranite.os.sync.spinlock

public class Spinlock:

    """
    Atomic spinlock using xchg instruction. Works in both kernel and
    user space. Interrupt management is the caller's responsibility
    when used in kernel context.
    """

    protect I64 locked

    public function Spinlock( self ) -> Void:

        """
        Construct an unlocked spinlock with the locked flag initialized
        to zero.
        """

        self.locked = 0

    public function lock( self ) -> Void:

        """
        Acquire the spinlock by spinning in a loop using atomic xchg
        until the lock is acquired. The pause instruction hints the CPU
        to reduce power consumption during the spin wait.
        
        Complexity:
            Time: O(n)
            Space: O(1)
        """

        I64 expected = 1
        I64 old = 1
        I64 lockAddr = addressof self.locked
        while old != 0:
            asm volatile "xchg $0, ($2)" : output( "=r" old ) : input( "0" expected, "r" lockAddr ) : clobber( "memory" )
            if old != 0:
                asm volatile "pause"

    public function unlock( self ) -> Void:

        """
        Release the spinlock by clearing the lock flag with a memory
        barrier to ensure all writes performed while the lock was held
        are visible before release.
        """

        asm volatile "" : : : clobber( "memory" )
        self.locked = 0

    public function tryLock( self ) -> Boolean:

        """
        Attempt to acquire the spinlock without spinning. Performs a
        single atomic exchange and returns True if the lock was
        successfully acquired, False if already held.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        I64 expected = 1
        I64 old = 0
        I64 lockAddr = addressof self.locked
        asm volatile "xchg $0, ($2)" : output( "=r" old ) : input( "0" expected, "r" lockAddr ) : clobber( "memory" )
        if old != 0:
            return False
        return True

    public function isLocked( self ) -> Boolean:

        """ Return whether the spinlock is currently held. """

        return self.locked != 0

export {
    Spinlock
}
