package uranite.os.power

from uranite.os.power.power import {
    CPU_STATE_ACTIVE,
    CPU_STATE_DEEP_SLEEP,
    CPU_STATE_HALT,
    CPU_STATE_STOP_CLOCK,
    POWER_EVENT_REBOOT,
    POWER_EVENT_RESUME,
    POWER_EVENT_SHUTDOWN,
    POWER_EVENT_SUSPEND,
    PowerManager,
    SYSTEM_OFF,
    SYSTEM_RUNNING,
    SYSTEM_STANDBY,
    SYSTEM_SUSPEND
}

export {
    CPU_STATE_ACTIVE,
    CPU_STATE_DEEP_SLEEP,
    CPU_STATE_HALT,
    CPU_STATE_STOP_CLOCK,
    POWER_EVENT_REBOOT,
    POWER_EVENT_RESUME,
    POWER_EVENT_SHUTDOWN,
    POWER_EVENT_SUSPEND,
    PowerManager,
    SYSTEM_OFF,
    SYSTEM_RUNNING,
    SYSTEM_STANDBY,
    SYSTEM_SUSPEND
}
