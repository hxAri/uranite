package uranite.os.crypto.rng

from uranite.os.sync.spinlock import Spinlock

public class Csprng:
    
    """
    Cryptographically Secure Pseudo-Random Number Generator implementing the
    xoshiro256** algorithm. The internal state consists of four 64-bit words
    (s0 through s3) providing a period of 2^256 - 1. Can be seeded from hardware
    RNG via the RDRAND instruction or manually for testing. All state mutations
    are protected by a spinlock for thread-safe concurrent access.
    """
    
    public I64 s0
    public I64 s1
    public I64 s2
    public I64 s3
    public I64 initialized
    public Spinlock lock
    
    public function Csprng( self ) -> Void:
        
        """
        Construct an uninitialized CSPRNG with all state words set to zero.
        Call seedFromHardware() or seed() before generating random values,
        as the all-zero state is a fixed point of the xoshiro256** algorithm.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        self.s0 = 0
        self.s1 = 0
        self.s2 = 0
        self.s3 = 0
        self.initialized = 0
        self.lock = new Spinlock()
    
    public function seedFromHardware( self ) -> Boolean:
        
        """
        Seed the CSPRNG from the hardware random number generator using the
        RDRAND instruction. Each of the four state words is seeded independently
        with a hardware-generated random value. Returns True if the seeding
        completed successfully.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        I64 r0 = 0
        I64 r1 = 0
        I64 r2 = 0
        I64 r3 = 0
        asm volatile:
            x86-64 "rdrand $0" : output( "=r" r0 )
            aarch64 "mrs $0, S3_3_C2_C4_0" : output( "=r" r0 )
        asm volatile:
            x86-64 "rdrand $0" : output( "=r" r1 )
            aarch64 "mrs $0, S3_3_C2_C4_0" : output( "=r" r1 )
        asm volatile:
            x86-64 "rdrand $0" : output( "=r" r2 )
            aarch64 "mrs $0, S3_3_C2_C4_0" : output( "=r" r2 )
        asm volatile:
            x86-64 "rdrand $0" : output( "=r" r3 )
            aarch64 "mrs $0, S3_3_C2_C4_0" : output( "=r" r3 )
        self.s0 = r0
        self.s1 = r1
        self.s2 = r2
        self.s3 = r3
        self.initialized = 1
        return True
    
    public function seedFromGetrandom( self ) -> Boolean:

        """
        Seed the CSPRNG from the kernel entropy pool via the getrandom syscall.
        This works on any Linux kernel >= 3.17 regardless of hardware RNG support.
        Reads 32 bytes (four I64 state words) with flags=0 (blocking, /dev/urandom
        quality). Returns True on success, False if the syscall returns an error.

        Complexity:
            Time: O(1)
            Space: O(1)
        """

        I64 sysGetrandom = 0
        asm volatile:
            x86-64 "mov $$318, $0" : output( "=r" sysGetrandom )
            aarch64 "mov $0, #278" : output( "=r" sysGetrandom )
        I64 bufAddr = addressof self.s0
        I64 bufLen = 32
        I64 flags = 0
        I64 bytesRead = 0
        asm volatile:
            x86-64 "movq $1, %rax; movq $2, %rdi; movq $3, %rsi; movq $4, %rdx; syscall; movq %rax, $0" : output( "=r" bytesRead ) : input( "r" sysGetrandom, "r" bufAddr, "r" bufLen, "r" flags ) : clobber( "rax", "rdi", "rsi", "rdx", "rcx", "r11", "memory" )
            aarch64 "mov x8, $1; mov x0, $2; mov x1, $3; mov x2, $4; svc #0; mov $0, x0" : output( "=r" bytesRead ) : input( "r" sysGetrandom, "r" bufAddr, "r" bufLen, "r" flags ) : clobber( "x0", "x1", "x2", "x8", "memory" )
        if bytesRead == 32:
            self.initialized = 1
            return True
        return False

    public function seed( self, I64 seed0, I64 seed1, I64 seed2, I64 seed3 ) -> Void:

        """
        Manually seed the CSPRNG with four 64-bit values. This is intended
        for testing or for platforms that do not support the RDRAND instruction.
        The provided values should have high entropy to ensure good random output.

        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.s0 = seed0
        self.s1 = seed1
        self.s2 = seed2
        self.s3 = seed3
        self.initialized = 1
    
    public function next( self ) -> I64:
        
        """
        Generate the next 64-bit pseudo-random value using the xoshiro256**
        algorithm. The result is computed as rotl(s1 * 5, 7) * 9. The internal
        state is advanced atomically under the spinlock to ensure thread safety.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        self.lock.lock()
        I64 result = self.s1 * 5
        result = ( ( result << 7 ) | ( result >> 57 ) ) * 9
        I64 shifted = self.s1 << 17
        self.s2 = self.s2 ^ self.s0
        self.s3 = self.s3 ^ self.s1
        self.s1 = self.s1 ^ self.s2
        self.s0 = self.s0 ^ self.s3
        self.s2 = self.s2 ^ shifted
        self.s3 = ( self.s3 << 45 ) | ( self.s3 >> 19 )
        self.lock.unlock()
        return result
    
    public function nextBounded( self, I64 bound ) -> I64:
        
        """
        Generate a pseudo-random value uniformly distributed in the range
        [0, bound). Returns 0 if bound is less than or equal to zero.
        The value is derived from next() with modulo reduction.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        if bound <= 0:
            return 0
        I64 val = self.next()
        if val < 0:
            val = 0 - val
        return val % bound
    
    public function fillRandom( self, I64 count ) -> I64:
        
        """
        Generate the specified number of random bytes by calling next()
        repeatedly (each call produces 8 bytes). Returns the total number
        of bytes generated, which may exceed the requested count by up to 7.
        
        Complexity:
            Time: O(n)
            Space: O(1)
        """
        
        I64 generated = 0
        while generated < count:
            self.next()
            generated = generated + 8
        return generated
    
    public function isInitialized( self ) -> Boolean:
        
        """ Return whether this CSPRNG has been seeded and is ready for use. """
        
        return self.initialized != 0

export {
    Csprng
}
