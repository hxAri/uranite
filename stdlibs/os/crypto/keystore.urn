package uranite.os.crypto.keystore

from uranite.memory.memory import Memory
from uranite.os.sync.spinlock import Spinlock

public enum KeyType backed I64:
    
    """ Enumerates the categories of cryptographic keys supported by the key store. """
    
    unit Symmetric 1
    unit Private 2
    unit Public 3
    unit Hmac 4

public enum KeyState backed I64:
    
    """ Enumerates the lifecycle states of a cryptographic key in the store. """
    
    unit Destroyed 0
    unit Active 1
    unit Revoked 2

public class KeyStore:
    
    """
    Kernel-space cryptographic key store that holds keys in protected memory.
    Keys are stored as four I64 values (up to 256 bits of key material) and
    are identified by slot index. Each key tracks its type, lifecycle state,
    and owning process ID. All mutations are protected by a spinlock for
    interrupt-safe concurrent access.
    """
    
    public Memory<I64> keyData0
    public Memory<I64> keyData1
    public Memory<I64> keyData2
    public Memory<I64> keyData3
    public Memory<I64> keyTypes
    public Memory<I64> keyStates
    public Memory<I64> ownerIds
    public I64 capacity
    public I64 count
    public I64 nextId
    public Spinlock lock
    
    public function KeyStore( self, I64 maxKeys ) -> Void:
        
        """
        Construct a key store with capacity for the specified maximum number
        of keys. Allocates parallel arrays for key data, types, states, and
        owner IDs, initializing all slots to the destroyed state with zeroed
        key material.
        
        Complexity:
            Time: O(n)
            Space: O(n)
        """
        
        self.capacity = maxKeys
        self.count = 0
        self.nextId = 0
        self.lock = new Spinlock()
        self.keyData0 = new Memory<I64>( maxKeys )
        self.keyData1 = new Memory<I64>( maxKeys )
        self.keyData2 = new Memory<I64>( maxKeys )
        self.keyData3 = new Memory<I64>( maxKeys )
        self.keyTypes = new Memory<I64>( maxKeys )
        self.keyStates = new Memory<I64>( maxKeys )
        self.ownerIds = new Memory<I64>( maxKeys )
        I64 slotIndex = 0
        while slotIndex < maxKeys:
            self.keyData0.set( slotIndex, 0 )
            self.keyData1.set( slotIndex, 0 )
            self.keyData2.set( slotIndex, 0 )
            self.keyData3.set( slotIndex, 0 )
            self.keyTypes.set( slotIndex, 0 )
            self.keyStates.set( slotIndex, 0 )
            self.ownerIds.set( slotIndex, 0 )
            slotIndex = slotIndex + 1
    
    public function store( self, I64 keyType, I64 ownerId, I64 d0, I64 d1, I64 d2, I64 d3 ) -> I64:
        
        """
        Store a new cryptographic key in the first available destroyed slot.
        The key material is provided as four I64 values (d0 through d3), along
        with the key type and owning process ID. Returns a unique key ID on
        success, or -1 if the store is full and no slots are available.
        
        Complexity:
            Time: O(n)
            Space: O(1)
        """
        
        self.lock.lock()
        if self.count >= self.capacity:
            self.lock.unlock()
            return 0 - 1
        I64 slotIndex = 0
        while slotIndex < self.capacity:
            if self.keyStates.get( slotIndex ) == 0:
                I64 id = self.nextId
                self.nextId = self.nextId + 1
                self.keyData0.set( slotIndex, d0 )
                self.keyData1.set( slotIndex, d1 )
                self.keyData2.set( slotIndex, d2 )
                self.keyData3.set( slotIndex, d3 )
                self.keyTypes.set( slotIndex, keyType )
                self.keyStates.set( slotIndex, 1 )
                self.ownerIds.set( slotIndex, ownerId )
                self.count = self.count + 1
                self.lock.unlock()
                return id
            slotIndex = slotIndex + 1
        self.lock.unlock()
        return 0 - 1
    
    protect function findSlot( self, I64 slot ) -> Boolean:
        
        """
        Check whether the given slot index is valid and contains an active key.
        Returns True if the slot is within bounds and its state is active,
        False otherwise.
        """
        
        if slot < 0 or slot >= self.capacity:
            return False
        return self.keyStates.get( slot ) == 1
    
    public function revoke( self, I64 slot ) -> Boolean:
        
        """
        Revoke the key at the given slot, marking it as unusable for
        cryptographic operations without zeroizing its material. The key
        material remains in memory until destroyKey() is called. Returns
        True if the key was active and successfully revoked, False otherwise.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        if slot < 0 or slot >= self.capacity:
            return False
        if self.keyStates.get( slot ) != 1:
            return False
        self.keyStates.set( slot, 2 )
        return True
    
    public function destroyKey( self, I64 slot ) -> Boolean:
        
        """
        Destroy the key at the given slot by zeroizing all key material,
        clearing the key type, state, and owner ID, and freeing the slot
        for reuse. This operation is protected by a spinlock to prevent
        concurrent access during zeroization. Returns True if the key was
        successfully destroyed, False if the slot was already empty or invalid.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        if slot < 0 or slot >= self.capacity:
            return False
        if self.keyStates.get( slot ) == 0:
            return False
        self.lock.lock()
        self.keyData0.set( slot, 0 )
        self.keyData1.set( slot, 0 )
        self.keyData2.set( slot, 0 )
        self.keyData3.set( slot, 0 )
        self.keyTypes.set( slot, 0 )
        self.keyStates.set( slot, 0 )
        self.ownerIds.set( slot, 0 )
        self.count = self.count - 1
        self.lock.unlock()
        return True
    
    public function isOwner( self, I64 slot, I64 ownerId ) -> Boolean:
        
        """
        Check if the specified process owns the key at the given slot.
        Returns True if the slot is valid and the owner ID matches,
        False otherwise.
        """
        
        if slot < 0 or slot >= self.capacity:
            return False
        return self.ownerIds.get( slot ) == ownerId
    
    public function getKeyType( self, I64 slot ) -> I64:
        
        """ Return the key type at the given slot, or 0 if the slot is out of range. """
        
        if slot < 0 or slot >= self.capacity:
            return 0
        return self.keyTypes.get( slot )
    
    public function getKeyState( self, I64 slot ) -> I64:
        
        """ Return the key state at the given slot, or 0 if the slot is out of range. """
        
        if slot < 0 or slot >= self.capacity:
            return 0
        return self.keyStates.get( slot )
    
    public function getCount( self ) -> I64:
        
        """ Return the number of keys currently stored in the key store. """
        
        return self.count
    
    public function destroy( self ) -> Void:
        
        """
        Securely destroy the entire key store by zeroizing all key material
        across all slots before freeing the underlying memory arrays. This
        ensures no residual key data remains in memory after the store is
        deallocated.
        
        Complexity:
            Time: O(n)
            Space: O(1)
        """
        
        I64 slotIndex = 0
        while slotIndex < self.capacity:
            self.keyData0.set( slotIndex, 0 )
            self.keyData1.set( slotIndex, 0 )
            self.keyData2.set( slotIndex, 0 )
            self.keyData3.set( slotIndex, 0 )
            slotIndex = slotIndex + 1
        self.keyData0.free()
        self.keyData1.free()
        self.keyData2.free()
        self.keyData3.free()
        self.keyTypes.free()
        self.keyStates.free()
        self.ownerIds.free()

export {
    KeyState,
    KeyStore,
    KeyType
}
