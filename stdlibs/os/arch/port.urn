package uranite.os.arch.port

public function inb( I64 port ) -> I64:

    """
    Read an 8-bit value from the given port/address.

    Parameters:
        port (I64):
            The I/O port (x86-64) or MMIO address (AArch64).

    Returns:
        I64:
            The 8-bit value read (zero-extended).
    """

    I64 result = 0
    asm volatile:
        x86-64 "inb %dx, %al" : output( "={eax}" result ) : input( "{edx}" port )
        aarch64 "ldrb ${0:w}, [$1]" : output( "=r" result ) : input( "r" port ) : clobber( "memory" )
    return result

public function outb( I64 port, I64 value ) -> Void:

    """
    Write an 8-bit value to the given port/address.

    Parameters:
        port (I64):
            The I/O port (x86-64) or MMIO address (AArch64).
        value (I64):
            The 8-bit value to write.
    """

    asm volatile:
        x86-64 "outb %al, %dx" : : input( "{eax}" value, "{edx}" port )
        aarch64 "strb ${0:w}, [$1]" : : input( "r" value, "r" port ) : clobber( "memory" )

public function inw( I64 port ) -> I64:

    """
    Read a 16-bit value from the given port/address.

    Parameters:
        port (I64):
            The I/O port (x86-64) or MMIO address (AArch64).

    Returns:
        I64:
            The 16-bit value read (zero-extended).
    """

    I64 result = 0
    asm volatile:
        x86-64 "inw %dx, %ax" : output( "={eax}" result ) : input( "{edx}" port )
        aarch64 "ldrh ${0:w}, [$1]" : output( "=r" result ) : input( "r" port ) : clobber( "memory" )
    return result

public function outw( I64 port, I64 value ) -> Void:

    """
    Write a 16-bit value to the given port/address.

    Parameters:
        port (I64):
            The I/O port (x86-64) or MMIO address (AArch64).
        value (I64):
            The 16-bit value to write.
    """

    asm volatile:
        x86-64 "outw %ax, %dx" : : input( "{eax}" value, "{edx}" port )
        aarch64 "strh ${0:w}, [$1]" : : input( "r" value, "r" port ) : clobber( "memory" )

public function inl( I64 port ) -> I64:

    """
    Read a 32-bit value from the given port/address.

    Parameters:
        port (I64):
            The I/O port (x86-64) or MMIO address (AArch64).

    Returns:
        I64:
            The 32-bit value read (zero-extended).
    """

    I64 result = 0
    asm volatile:
        x86-64 "inl %dx, %eax" : output( "={eax}" result ) : input( "{edx}" port )
        aarch64 "ldr ${0:w}, [$1]" : output( "=r" result ) : input( "r" port ) : clobber( "memory" )
    return result

public function outl( I64 port, I64 value ) -> Void:

    """
    Write a 32-bit value to the given port/address.

    Parameters:
        port (I64):
            The I/O port (x86-64) or MMIO address (AArch64).
        value (I64):
            The 32-bit value to write.
    """

    asm volatile:
        x86-64 "outl %eax, %dx" : : input( "{eax}" value, "{edx}" port )
        aarch64 "str ${0:w}, [$1]" : : input( "r" value, "r" port ) : clobber( "memory" )

public function ioWait() -> Void:

    """
    I/O synchronization delay. On x86-64 this writes to the POST diagnostic
    port (0x80). On AArch64 this executes a DSB barrier.
    """

    asm volatile:
        x86-64 "outb %al, $0x80"
        aarch64 "dsb sy"

export {
    inb,
    inl,
    inw,
    ioWait,
    outb,
    outl,
    outw
}
