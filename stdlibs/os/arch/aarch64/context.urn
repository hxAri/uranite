#
# AArch64 (ARM64) coroutine context switching: saves and restores the callee-
# saved register set (X19-X28, FP/X29, LR/X30) and swaps SP between two context
# slots. Mirrors the public API of the x86-64 variant. Selected automatically
# via the compiler's "native" arch token (uranite.os.arch.native.context).
#
# NOTE: This AArch64 context switch is experimental and not exercised by the
# default test paths (hello-world and the unit suite use libc/syscall I/O only).
# It follows the standard AAPCS64 callee-saved layout; validate before relying on
# coroutine/fiber scheduling on AArch64.
#
# This program is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# any later version.
#
# You should have received a copy of the GNU General Public License
# along with this program. If not, see <https://www.gnu.org/licenses/>.
#

package uranite.os.arch.aarch64.context

from uranite.os.arch.native.memory import writeI64At

public function swapContext( I64 fromStackPtr, I64 toStackPtr ) -> Void:

    """
    Switch execution context by saving the AArch64 callee-saved registers
    (X19-X28, X29/FP, X30/LR) onto the current stack, storing SP at
    *fromStackPtr, loading SP from *toStackPtr, restoring the registers, then
    returning via the restored X30. A freshly prepared context resumes at the
    entry address placed by makeContext in its X30 slot.

    Parameters:
        fromStackPtr (I64):
            Pointer to the slot where the current SP is saved.
        toStackPtr (I64):
            Pointer to the slot from which the target SP is loaded.
    """

    asm volatile "sub sp, sp, #96\n\tstp x19, x20, [sp, #0]\n\tstp x21, x22, [sp, #16]\n\tstp x23, x24, [sp, #32]\n\tstp x25, x26, [sp, #48]\n\tstp x27, x28, [sp, #64]\n\tstp x29, x30, [sp, #80]\n\tmov x9, sp\n\tstr x9, [x0]\n\tldr x9, [x1]\n\tmov sp, x9\n\tldp x19, x20, [sp, #0]\n\tldp x21, x22, [sp, #16]\n\tldp x23, x24, [sp, #32]\n\tldp x25, x26, [sp, #48]\n\tldp x27, x28, [sp, #64]\n\tldp x29, x30, [sp, #80]\n\tadd sp, sp, #96\n\tret" : output() : input( "{x0}" fromStackPtr, "{x1}" toStackPtr ) : clobber( "x9", "memory", "cc" )

public function makeContext( I64 stackBase, I64 stackSize, I64 entryFn ) -> I64:

    """
    Prepare a new execution context on a stack region. Lays out the twelve
    callee-saved register slots (X19-X28, X29, X30) with X30 set to the entry
    function and the rest zeroed, returning the initial SP for swapContext.

    The frame is 96 bytes; slots are laid out at increasing offsets matching
    swapContext: SP+0..SP+80 hold X19..X29 and SP+88 holds X30 (the entry).

    Parameters:
        stackBase (I64):
            Base address of the allocated stack memory region.
        stackSize (I64):
            Size in bytes of the stack memory region.
        entryFn (I64):
            Address of the function to run when the context is first resumed.

    Returns:
        I64:
            The initial SP value (16-byte aligned) for the new context.

    Complexity:
        Time: O(1)
        Space: O(1)
    """

    I64 stackTop = stackBase + stackSize
    I64 aligned = stackTop - ( stackTop % 16 )
    I64 sp = aligned - 96
    writeI64At( sp, 0, 0 )
    writeI64At( sp, 8, 0 )
    writeI64At( sp, 16, 0 )
    writeI64At( sp, 24, 0 )
    writeI64At( sp, 32, 0 )
    writeI64At( sp, 40, 0 )
    writeI64At( sp, 48, 0 )
    writeI64At( sp, 56, 0 )
    writeI64At( sp, 64, 0 )
    writeI64At( sp, 72, 0 )
    writeI64At( sp, 80, 0 )
    writeI64At( sp, 88, entryFn )
    return sp

export {
    makeContext,
    swapContext
}
