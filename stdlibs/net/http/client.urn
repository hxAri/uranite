public function patch( I64 ip, I64 port, String path, String body, String contentType ) -> HttpResponse:
    """
    Send an HTTP PATCH request with the given body and content type.

    Parameters:
        ip (I64):
            IPv4 address as a 32-bit integer in network byte order.
        port (I64):
            TCP port number.
        path (String):
            Request target path.
        body (String):
            Request body content.
        contentType (String):
            Value for the Content-Type header.

    Returns:
        HttpResponse:
            The parsed HTTP response from the server.
    
    Complexity:
        Time: O(1)
        Space: O(1)
    """
    HttpRequest req = new HttpRequest( "PATCH", path )
    req.setBody( body )
    req.setContentType( contentType )
    return sendRequest( ip, port, req )

public function head( I64 ip, I64 port, String path ) -> HttpResponse:
    """
    Send an HTTP HEAD request. The response body will be empty per
    HTTP specification, but headers are fully populated.

    Parameters:
        ip (I64):
            IPv4 address as a 32-bit integer in network byte order.
        port (I64):
            TCP port number.
        path (String):
            Request target path.

    Returns:
        HttpResponse:
            The parsed HTTP response (body empty).
    
    Complexity:
        Time: O(1)
        Space: O(1)
    """
    HttpRequest req = new HttpRequest( "HEAD", path )
    return sendRequest( ip, port, req )

public function options( I64 ip, I64 port, String path ) -> HttpResponse:
    """
    Send an HTTP OPTIONS request to discover supported methods and
    capabilities of the server resource.

    Parameters:
        ip (I64):
            IPv4 address as a 32-bit integer in network byte order.
        port (I64):
            TCP port number.
        path (String):
            Request target path (use "*" for server-wide options).

    Returns:
        HttpResponse:
            The parsed HTTP response from the server.
    
    Complexity:
        Time: O(1)
        Space: O(1)
    """
    HttpRequest req = new HttpRequest( "OPTIONS", path )
    return sendRequest( ip, port, req )

export {
    sendRequest,
    readFull,
    get, post, put, del, patch, head, options,
    RECV_BUF_SIZE
}
