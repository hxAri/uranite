package uranite.language.integer

from uranite.language.int import Int

final class Integer extends Int:
    
    """
    General-purpose integer type, maps to I32 on most platforms.
    Extends Int and provides a platform-natural integer width for common use cases.
    """
    
    public function Integer( self, I32 value ) -> Void:
        
        """ Construct a new Integer from the given I32 value, widening to I64 internally. """
        
        self.value = value as I64
    
    public function toInteger( self ) -> I32:
        
        """ Return this value narrowed back to a 32-bit integer. """
        
        return self.value as I32
    
    public function toString( self ) -> String:
        
        """ Return the string representation of this Integer's numeric value. """
        
        return self.value as String
