package uranite.language.double

from uranite.language.float import Float

final class Double extends Float:
    
    """
    64-bit double-precision floating-point type.
    Extends Float and serves as an alias for F64, providing double-precision arithmetic.
    """
    
    public function Double( self, F64 value ) -> Void:
        
        """ Construct a new Double from the given F64 value. """
        
        self.value = value
    
    public function toDouble( self ) -> F64:
        
        """ Return the underlying F64 value of this Double. """
        
        return self.value
    
    public function toString( self ) -> String:
        
        """ Return the string representation of this Double's numeric value. """
        
        return self.value as String
