package uranite.language.f64

from uranite.language.float import Float

final class F64 extends Float:
    
    """
    64-bit double-precision floating-point number.
    Extends Float and provides full double-precision arithmetic.
    """
    
    public function F64( self, F64 value ) -> Void:
        
        """ Construct a new F64 from the given double-precision value. """
        
        self.value = value
    
    public function toF64( self ) -> F64:
        
        """ Return the underlying F64 value. """
        
        return self.value
    
    public function toString( self ) -> String:
        
        """ Return the string representation of this F64's numeric value. """
        
        return self.value as String
