package uranite.language.I32

from uranite.language.int import Int

final class I32 extends Int:
    
    """
    Signed 32-bit integer.
    Extends Int and stores the value internally as I64 for uniform arithmetic.
    """
    
    public function I32( self, I32 value ) -> Void:
        
        """ Construct a new I32 from the given 32-bit signed value, widening to I64 internally. """
        
        self.value = value as I64
    
    public function toI32( self ) -> I32:
        
        """ Return this value narrowed back to a signed 32-bit integer. """
        
        return self.value as I32
    
    public function toString( self ) -> String:
        
        """ Return the string representation of this I32's numeric value. """
        
        return self.value as String
