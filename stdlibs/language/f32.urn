package uranite.language.f32

from uranite.language.float import Float

final class F32 extends Float:
    
    """
    32-bit single-precision floating-point number.
    Extends Float and stores the value internally as F64 for uniform arithmetic.
    """
    
    public function F32( self, F32 value ) -> Void:
        
        """ Construct a new F32 from the given single-precision value, widening to F64 internally. """
        
        self.value = value as F64
    
    public function toF32( self ) -> F32:
        
        """ Return this value narrowed back to a 32-bit single-precision float. """
        
        return self.value as F32
    
    public function toString( self ) -> String:
        
        """ Return the string representation of this F32's numeric value. """
        
        return self.value as String
