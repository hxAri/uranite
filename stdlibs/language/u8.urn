package uranite.language.U8

from uranite.language.uint import UInt

final class U8 extends UInt:
    
    """
    Unsigned 8-bit integer (0 to 255).
    Extends UInt and stores the value internally as U64 for uniform arithmetic.
    """
    
    public function U8( self, U8 value ) -> Void:
        
        """ Construct a new U8 from the given 8-bit unsigned value, widening to U64 internally. """
        
        self.value = value as U64
    
    public function toU8( self ) -> U8:
        
        """ Return this value narrowed back to an unsigned 8-bit integer. """
        
        return self.value as U8
    
    public function toString( self ) -> String:
        
        """ Return the string representation of this U8's numeric value. """
        
        return self.value as String
