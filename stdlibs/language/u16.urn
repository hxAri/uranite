package uranite.language.U16

from uranite.language.uint import UInt

final class U16 extends UInt:
    
    """
    Unsigned 16-bit integer (0 to 65535).
    Extends UInt and stores the value internally as U64 for uniform arithmetic.
    """
    
    public function U16( self, U16 value ) -> Void:
        
        """ Construct a new U16 from the given 16-bit unsigned value, widening to U64 internally. """
        
        self.value = value as U64
    
    public function toU16( self ) -> U16:
        
        """ Return this value narrowed back to an unsigned 16-bit integer. """
        
        return self.value as U16
    
    public function toString( self ) -> String:
        
        """ Return the string representation of this U16's numeric value. """
        
        return self.value as String
