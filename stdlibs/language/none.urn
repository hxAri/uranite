package uranite.language.none



final class NoneType:
    
    """
    Type of the None singleton, representing the absence of a value.
    Used as the underlying type for nullable expressions that have no value.
    """
    
    public function toString( self ) -> String:
        
        """ Return the string "None" representing this absent value. """
        
        return "None"
    
    public function equals( self, ?NoneType other ) -> Boolean:
        
        """ Return True, since all NoneType instances are considered equal. """
        
        return True
