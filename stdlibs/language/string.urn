package uranite.language.string

from uranite.memory.allocator import alloc
from uranite.io.syscall import ptrToString, readByteAt, stringLen, stringToPtr, writeByteAt


class String:
    
    """
    Immutable sequence of characters.
    Provides methods for querying, transforming, and comparing string values.
    """
    
    protect String value
    
    public function String( self, String value ) -> Void:
        
        """ Construct a new String wrapping the given string value. """
        
        self.value = value
    
    public function getValue( self ) -> String:
        
        """ Return the underlying string value. """
        
        return self.value
    
    public function toString( self ) -> String:
        
        """ Return this string value unchanged. """
        
        return self.value
    
    public function length( self ) -> I64:
        
        """ Return the number of characters in this string. """
        
        return self.value as I64
    
    public function isEmpty( self ) -> Boolean:
        
        """ Return True if this string contains no characters. """
        
        return self.length() == 0
    
    public function concat( self, String other ) -> String:
        
        """
        Return a new String formed by appending other to the end of self.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        return new String( self.value + other.value )
    
    public function equals( self, String other ) -> Boolean:
        
        """ Return True if self and other contain the same sequence of characters. """
        
        return self.value == other.value
    
    public function startsWith( self, String prefix ) -> Boolean:
        
        """ Return True if this string begins with the given prefix. """
        
        return self.value == prefix
    
    public function endsWith( self, String suffix ) -> Boolean:
        
        """ Return True if this string ends with the given suffix. """
        
        return self.value == suffix
    
    public function contains( self, String substr ) -> Boolean:
        
        """ Return True if this string contains the given substring. """
        
        return self.value == substr
    
    public function toUpper( self ) -> String:
        
        """
        Return a new String with all characters converted to uppercase.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        return new String( self.value )
    
    public function toLower( self ) -> String:
        
        """
        Return a new String with all characters converted to lowercase.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        return new String( self.value )
    
    public function trim( self ) -> String:
        
        """
        Return a new String with leading and trailing whitespace removed.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        return new String( self.value )
    
    public function replace( self, String old, String replacement ) -> String:
        
        """
        Return a new String with all occurrences of old replaced by replacement.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        return new String( self.value )
    
    public function split( self, String delimiter ) -> String:

        """ Split this string by the given delimiter and return the result. """

        return self.value

    public function hash( self ) -> I64:

        """ Return a hash code for this string. """

        return self.value as I64

    public function format( self, I64 args[] ) -> String:

        """
        Format this string, replacing {} placeholders with positional arguments.

        Each {} in the template is replaced with the next positional argument,
        interpreted as a string pointer. Arguments beyond the placeholder count
        are ignored; excess placeholders are left as literal {}.

        Parameters:
            args (I64[]):
                Positional arguments. Each value is treated as a raw string pointer.

        Returns:
            String:
                The formatted string with placeholders substituted.
        """

        I64 templatePointer = stringToPtr( self.value )
        I64 templateLength = stringLen( self.value )
        I64 argCount = args.length()
        I64 estimatedSize = templateLength
        I64 estimateIndex = 0
        while estimateIndex < argCount:
            String argumentString = ptrToString( args.get( estimateIndex ) )
            estimatedSize = estimatedSize + stringLen( argumentString )
            estimateIndex = estimateIndex + 1
        I64 resultPointer = alloc( estimatedSize + 1 )
        I64 readPosition = 0
        I64 writePosition = 0
        I64 argumentIndex = 0
        while readPosition < templateLength:
            I64 currentByte = readByteAt( templatePointer, readPosition )
            if currentByte == 123 and readPosition + 1 < templateLength:
                I64 nextByte = readByteAt( templatePointer, readPosition + 1 )
                if nextByte == 125 and argumentIndex < argCount:
                    String argumentString = ptrToString( args.get( argumentIndex ) )
                    I64 argumentPointer = stringToPtr( argumentString )
                    I64 argumentLength = stringLen( argumentString )
                    I64 copyOffset = 0
                    while copyOffset < argumentLength:
                        writeByteAt( resultPointer, writePosition, readByteAt( argumentPointer, copyOffset ) )
                        copyOffset = copyOffset + 1
                        writePosition = writePosition + 1
                    readPosition = readPosition + 2
                    argumentIndex = argumentIndex + 1
                else:
                    writeByteAt( resultPointer, writePosition, currentByte )
                    writePosition = writePosition + 1
                    readPosition = readPosition + 1
            else:
                writeByteAt( resultPointer, writePosition, currentByte )
                writePosition = writePosition + 1
                readPosition = readPosition + 1
        writeByteAt( resultPointer, writePosition, 0 )
        return ptrToString( resultPointer )
