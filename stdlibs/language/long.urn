package uranite.language.long

from uranite.language.int import Int

final class Long extends Int:
    
    """
    64-bit signed integer type.
    Extends Int and serves as a named alias for I64, providing the full 64-bit signed range.
    """
    
    public function Long( self, I64 value ) -> Void:
        
        """ Construct a new Long from the given I64 value. """
        
        self.value = value
    
    public function toLong( self ) -> I64:
        
        """ Return the underlying I64 value. """
        
        return self.value
    
    public function toString( self ) -> String:
        
        """ Return the string representation of this Long's numeric value. """
        
        return self.value as String
