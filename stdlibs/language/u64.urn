package uranite.language.u64

from uranite.language.uint import UInt

final class U64 extends UInt:
    
    """
    Unsigned 64-bit integer.
    Extends UInt and provides the full range of 64-bit unsigned integer values.
    """
    
    public function U64( self, U64 value ) -> Void:
        
        """ Construct a new U64 from the given 64-bit unsigned value. """
        
        self.value = value
    
    public function toU64( self ) -> U64:
        
        """ Return the underlying U64 value. """
        
        return self.value
    
    public function toString( self ) -> String:
        
        """ Return the string representation of this U64's numeric value. """
        
        return self.value as String
