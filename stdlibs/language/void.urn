package uranite.language.Void



final class Void:
    
    """
    Represents the absence of a value.
    Used as the return type for functions and methods that do not produce a result.
    """
    
    public function toString( self ) -> String:
        
        """ Return the string "Void" representing this type. """
        
        return "Void"
