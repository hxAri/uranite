package uranite.language.char



final class Char:
    
    """
    Single Unicode character (32-bit).
    Provides character classification methods (alphabetic, digit, whitespace) and case conversion.
    """
    
    protect Char value
    
    public function Char( self, Char value ) -> Void:
        
        """ Construct a new Char wrapping the given character value. """
        
        self.value = value
    
    public function getValue( self ) -> Char:
        
        """ Return the underlying character value. """
        
        return self.value
    
    public function toString( self ) -> String:
        
        """ Return this character as a single-character String. """
        
        return self.value as String
    
    public function isAlpha( self ) -> Boolean:
        
        """ Return True if this character is an alphabetic letter (a-z or A-Z). """
        
        return ( self.value >= 'a' and self.value <= 'z' ) or ( self.value >= 'A' and self.value <= 'Z' )
    
    public function isDigit( self ) -> Boolean:
        
        """ Return True if this character is a decimal digit (0-9). """
        
        return self.value >= '0' and self.value <= '9'
    
    public function isAlphanumeric( self ) -> Boolean:
        
        """ Return True if this character is either alphabetic or a digit. """
        
        return self.isAlpha() or self.isDigit()
    
    public function isWhitespace( self ) -> Boolean:
        
        """ Return True if this character is a whitespace character (space, tab, newline, or carriage return). """
        
        return self.value == ' ' or self.value == '\t' or self.value == '\n' or self.value == '\r'
    
    public function toUpper( self ) -> Char:
        
        """
        Return a new Char converted to uppercase, or the same character if not a lowercase letter.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        if self.value >= 'a' and self.value <= 'z':
            return new Char( ( self.value as I32 - 32 ) as Char )
        return new Char( self.value )
    
    public function toLower( self ) -> Char:
        
        """
        Return a new Char converted to lowercase, or the same character if not an uppercase letter.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        if self.value >= 'A' and self.value <= 'Z':
            return new Char( ( self.value as I32 + 32 ) as Char )
        return new Char( self.value )
