package uranite.language.I64

from uranite.language.int import Int

final class I64 extends Int:
    
    """
    Signed 64-bit integer.
    Extends Int and provides the full range of 64-bit signed integer values.
    """
    
    public function I64( self, I64 value ) -> Void:
        
        """ Construct a new I64 from the given 64-bit signed value. """
        
        self.value = value
    
    public function toI64( self ) -> I64:
        
        """ Return the underlying I64 value. """
        
        return self.value
    
    public function toString( self ) -> String:
        
        """ Return the string representation of this I64's numeric value. """
        
        return self.value as String
