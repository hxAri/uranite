package uranite.language.boolean

final class Boolean:
    
    """
    Truth value type representing True or False.
    Provides logical operations such as negation, conjunction, and disjunction.
    """
    
    protect Boolean value
    
    public function Boolean( self, Boolean value ) -> Void:
        
        """ Construct a new Boolean wrapping the given truth value. """
        
        self.value = value
    
    public function getValue( self ) -> Boolean:
        
        """ Return the underlying truth value. """
        
        return self.value
    
    public function toString( self ) -> String:
        
        """ Return the string representation of this Boolean, either "True" or "False". """
        
        if self.value:
            return "True"
        return "False"
    
    public function negate( self ) -> Boolean:
        
        """
        Return a new Boolean with the opposite truth value.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        return new Boolean( not self.value )
    
    public function logicalAnd( self, Boolean other ) -> Boolean:
        
        """
        Return a new Boolean representing the logical conjunction of self and other.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        return new Boolean( self.value and other.value )
    
    public function logicalOr( self, Boolean other ) -> Boolean:
        
        """
        Return a new Boolean representing the logical disjunction of self and other.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        return new Boolean( self.value or other.value )
