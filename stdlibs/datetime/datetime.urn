package uranite.datetime.datetime

from uranite.os.syscall.invoke import syscall2
from uranite.os.syscall.result import SyscallResult
from uranite.memory.memory import Memory
from uranite.io.syscall import {
    memoryToPtr,
    readI64At,
    writeI64At,
    writeByteAt,
    readByteAt,
    stringToPtr,
    stringLen
}
from uranite.memory.allocator import alloc
from uranite.functions.builtin import ptrToString
from uranite.string.format import padZero, appendTo
from uranite.datetime.duration import Duration, SECS_PER_DAY
from uranite.datetime.errors import DateTimeError, InvalidDateError

const I64 SYS_CLOCK_GETTIME = 228
""" Linux syscall number for clock_gettime. """
const I64 CLOCK_REALTIME = 0
""" Clock ID for wall-clock time (affected by NTP adjustments). """
const I64 CLOCK_MONOTONIC = 1
""" Clock ID for monotonic time (steady, not affected by NTP). """

const I64 EPOCH_YEAR = 1970
""" The Unix epoch year (January 1, 1970). """
const I64 DAYS_PER_400Y = 146097
const I64 DAYS_PER_100Y = 36524
const I64 DAYS_PER_4Y = 1461

public function isLeapYear( I64 year ) -> Boolean:
    
    """
    Determine whether a given year is a leap year according to the
    Gregorian calendar rules: divisible by 4, except centuries unless
    also divisible by 400.
    
    Parameters:
        year (I64):
            The calendar year to check.
    
    Returns:
        Boolean:
            True if the year is a leap year, False otherwise.
    
    Complexity:
        Time: O(1)
    """
    
    if year % 4 != 0:
        return False
    if year % 100 != 0:
        return True
    return year % 400 == 0

public function daysInMonth( I64 year, I64 month ) -> I64:
    
    """
    Return the number of days in the given month for the given year.
    Accounts for leap years when month is February.
    
    Parameters:
        year (I64):
            The calendar year.
        month (I64):
            The month number (1-12).
    
    Returns:
        I64:
            The number of days in that month, or 0 if month is invalid.
    
    Complexity:
        Time: O(1)
    """
    
    if month == 1 or month == 3 or month == 5 or month == 7 or month == 8 or month == 10 or month == 12:
        return 31
    if month == 4 or month == 6 or month == 9 or month == 11:
        return 30
    if month == 2:
        if isLeapYear( year ):
            return 29
        return 28
    return 0

public function daysInYear( I64 year ) -> I64:
    
    """
    Return the number of days in the given year (365 or 366).
    
    Parameters:
        year (I64):
            The calendar year.
    
    Returns:
        I64:
            366 if the year is a leap year, 365 otherwise.
    
    Complexity:
        Time: O(1)
    """
    
    if isLeapYear( year ):
        return 366
    return 365

public function clockGettime( I64 clockId ) -> Memory<I64>:
    
    """
    Read the current time from the given kernel clock via the
    clock_gettime syscall. Returns a Memory buffer containing
    two I64 values: seconds at offset 0, nanoseconds at offset 8.
    
    Parameters:
        clockId (I64):
            The clock to read (CLOCK_REALTIME or CLOCK_MONOTONIC).
    
    Returns:
        Memory<I64>:
            A buffer with seconds and nanoseconds.
    
    Raises:
        DateTimeError:
            If the clock_gettime syscall fails.
    
    Complexity:
        Time: O(1)
        Space: O(1) for the two-element timespec buffer.
    """
    
    Memory<I64> timespec = new Memory<I64>( 2 )
    writeI64At( memoryToPtr( timespec ), 0, 0 )
    writeI64At( memoryToPtr( timespec ), 8, 0 )
    SyscallResult result = syscall2( SYS_CLOCK_GETTIME, clockId, memoryToPtr( timespec ) )
    if result.isError():
        raise new DateTimeError( "clock_gettime failed", result.errorCode(), None )
    return timespec

public function currentTimeNanos() -> I64:

    """
    Returns current wall-clock time as nanoseconds since Unix epoch.

    Returns:
        I64:
            Nanoseconds since 1970-01-01 00:00:00 UTC.

    Raises:
        DateTimeError:
            If the clock_gettime syscall fails.

    Complexity:
        Time: O(1)
        Space: O(1)
    """

    Memory<I64> timespec = clockGettime( CLOCK_REALTIME )
    I64 seconds = timespec.get( 0 )
    I64 nanoseconds = timespec.get( 1 )
    return seconds * 1000000000 + nanoseconds

public function currentTimeMillis() -> I64:

    """
    Returns current wall-clock time as milliseconds since Unix epoch.

    Returns:
        I64:
            Milliseconds since 1970-01-01 00:00:00 UTC.

    Raises:
        DateTimeError:
            If the clock_gettime syscall fails.

    Complexity:
        Time: O(1)
        Space: O(1)
    """

    Memory<I64> timespec = clockGettime( CLOCK_REALTIME )
    I64 seconds = timespec.get( 0 )
    I64 nanoseconds = timespec.get( 1 )
    return seconds * 1000 + nanoseconds / 1000000

public class DateTime:
    
    """
    Calendar date and time with nanosecond precision and UTC offset.
    
    Represents a point in time decomposed into year, month, day, hour,
    minute, second, nanosecond, and UTC offset. Supports conversion
    to/from Unix timestamps, calendar arithmetic via Duration, comparison,
    and pattern-based string formatting.
    """
    
    public I64 year
    """ The calendar year (e.g., 2026). """
    public I64 month
    """ The month number (1-12). """
    public I64 day
    """ The day of the month (1-31). """
    public I64 hour
    """ The hour of the day (0-23). """
    public I64 minute
    """ The minute of the hour (0-59). """
    public I64 second
    """ The second of the minute (0-59). """
    public I64 nanosecond
    """ The nanosecond within the second (0-999999999). """
    public I64 utcOffset
    """ The UTC offset in seconds (e.g., 25200 for +07:00). """
    
    public function DateTime( self, I64 year, I64 month, I64 day, I64 hour, I64 minute, I64 second, I64 nanosecond, I64 utcOffset ) -> Void:
        
        """
        Create a new DateTime with all components specified.
        
        Parameters:
            year (I64):
                The calendar year.
            month (I64):
                The month number (1-12).
            day (I64):
                The day of the month (1-31).
            hour (I64):
                The hour (0-23).
            minute (I64):
                The minute (0-59).
            second (I64):
                The second (0-59).
            nanosecond (I64):
                The nanosecond (0-999999999).
            utcOffset (I64):
                The UTC offset in seconds.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        self.year = year
        self.month = month
        self.day = day
        self.hour = hour
        self.minute = minute
        self.second = second
        self.nanosecond = nanosecond
        self.utcOffset = utcOffset
    
    public function toTimestamp( self ) -> I64:
        
        """
        Convert this DateTime to a Unix timestamp (seconds since epoch).
        The UTC offset is subtracted to produce UTC-relative time.
        
        Returns:
            I64:
                The Unix timestamp in seconds.
        
        Complexity:
            Time: O(y) where y is the number of years since 1970.
        """
        
        I64 days = 0
        I64 currentYear = EPOCH_YEAR
        while currentYear < self.year:
            days = days + daysInYear( currentYear )
            currentYear = currentYear + 1
        I64 currentMonth = 1
        while currentMonth < self.month:
            days = days + daysInMonth( self.year, currentMonth )
            currentMonth = currentMonth + 1
        days = days + self.day - 1
        return days * SECS_PER_DAY + self.hour * 3600 + self.minute * 60 + self.second - self.utcOffset
    
    public function dayOfWeek( self ) -> I64:
        
        """
        Calculate the day of the week for this DateTime.
        Sunday is 0, Monday is 1, ..., Saturday is 6.
        
        Returns:
            I64:
                The day of the week (0 = Sunday, 6 = Saturday).
        
        Complexity:
            Time: O(y) where y is the number of years since 1970.
        """
        
        I64 timestamp = self.toTimestamp()
        I64 days = timestamp / SECS_PER_DAY
        if timestamp < 0:
            days = days - 1
        I64 dayOfWeekValue = ( days + 4 ) % 7
        if dayOfWeekValue < 0:
            dayOfWeekValue = dayOfWeekValue + 7
        return dayOfWeekValue
    
    public function dayOfYear( self ) -> I64:
        
        """
        Calculate the day of the year for this DateTime (1-366).
        
        Returns:
            I64:
                The ordinal day within the year.
        
        Complexity:
            Time: O(month)
        """
        
        I64 result = 0
        I64 currentMonth = 1
        while currentMonth < self.month:
            result = result + daysInMonth( self.year, currentMonth )
            currentMonth = currentMonth + 1
        return result + self.day
    
    public function addDuration( self, Duration duration ) -> DateTime:
        
        """
        Return a new DateTime advanced by the given Duration.
        
        Parameters:
            duration (Duration):
                The duration to add.
        
        Returns:
            DateTime:
                A new DateTime offset forward by the duration.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        I64 timestamp = self.toTimestamp() + duration.totalSeconds()
        I64 nanos = self.nanosecond + duration.nanos
        if nanos >= 1000000000:
            timestamp = timestamp + 1
            nanos = nanos - 1000000000
        elif nanos < 0:
            timestamp = timestamp - 1
            nanos = nanos + 1000000000
        return fromTimestamp( timestamp, nanos, self.utcOffset )
    
    public function subtractDuration( self, Duration duration ) -> DateTime:
        
        """
        Return a new DateTime moved backward by the given Duration.
        
        Parameters:
            duration (Duration):
                The duration to subtract.
        
        Returns:
            DateTime:
                A new DateTime offset backward by the duration.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        I64 timestamp = self.toTimestamp() - duration.totalSeconds()
        I64 nanos = self.nanosecond - duration.nanos
        if nanos < 0:
            timestamp = timestamp - 1
            nanos = nanos + 1000000000
        elif nanos >= 1000000000:
            timestamp = timestamp + 1
            nanos = nanos - 1000000000
        return fromTimestamp( timestamp, nanos, self.utcOffset )
    
    public function diffSeconds( self, DateTime other ) -> I64:
        
        """
        Calculate the difference in seconds between this and another DateTime.
        
        Parameters:
            other (DateTime):
                The DateTime to compare against.
        
        Returns:
            I64:
                The number of seconds (self - other). Positive if self is later.
        """
        
        return self.toTimestamp() - other.toTimestamp()
    
    public function isBefore( self, DateTime other ) -> Boolean:
        
        """
        Check whether this DateTime is strictly before another.
        
        Parameters:
            other (DateTime):
                The DateTime to compare against.
        
        Returns:
            Boolean:
                True if this DateTime is earlier than other.
        """
        
        return self.toTimestamp() < other.toTimestamp()
    
    public function isAfter( self, DateTime other ) -> Boolean:
        
        """
        Check whether this DateTime is strictly after another.
        
        Parameters:
            other (DateTime):
                The DateTime to compare against.
        
        Returns:
            Boolean:
                True if this DateTime is later than other.
        """
        
        return self.toTimestamp() > other.toTimestamp()
    
    public function isEqual( self, DateTime other ) -> Boolean:
        
        """
        Check whether this DateTime represents the same instant as another.
        
        Parameters:
            other (DateTime):
                The DateTime to compare against.
        
        Returns:
            Boolean:
                True if both represent the same Unix timestamp.
        """
        
        return self.toTimestamp() == other.toTimestamp()
    
    public function format( self, String pattern ) -> String:
        
        """
        Format this DateTime using a simple pattern string.
        Supported tokens: YYYY (4-digit year), MM (2-digit month),
        DD (2-digit day), hh (2-digit hour), mm (2-digit minute),
        ss (2-digit second). All other characters pass through unchanged.
        
        Parameters:
            pattern (String):
                The format pattern string.
        
        Returns:
            String:
                The formatted date/time string.
        
        Complexity:
            Time: O(n) where n is the byte length of pattern.
            Space: O(n) for the output buffer.
        """
        
        I64 patternLength = stringLen( pattern )
        I64 patternPointer = stringToPtr( pattern )
        I64 buffer = alloc( patternLength * 4 + 32 )
        I64 position = 0
        I64 index = 0
        while index < patternLength:
            I64 character = readByteAt( patternPointer, index )
            if character == 89:
                String yearString = padZero( self.year, 4 )
                position = appendTo( buffer, position, yearString )
                index = index + 4
            elif character == 77 and index + 1 < patternLength and readByteAt( patternPointer, index + 1 ) == 77:
                String monthString = padZero( self.month, 2 )
                position = appendTo( buffer, position, monthString )
                index = index + 2
            elif character == 68 and index + 1 < patternLength and readByteAt( patternPointer, index + 1 ) == 68:
                String dayString = padZero( self.day, 2 )
                position = appendTo( buffer, position, dayString )
                index = index + 2
            elif character == 104 and index + 1 < patternLength and readByteAt( patternPointer, index + 1 ) == 104:
                String hourString = padZero( self.hour, 2 )
                position = appendTo( buffer, position, hourString )
                index = index + 2
            elif character == 109 and index + 1 < patternLength and readByteAt( patternPointer, index + 1 ) == 109:
                String minuteString = padZero( self.minute, 2 )
                position = appendTo( buffer, position, minuteString )
                index = index + 2
            elif character == 115 and index + 1 < patternLength and readByteAt( patternPointer, index + 1 ) == 115:
                String secondString = padZero( self.second, 2 )
                position = appendTo( buffer, position, secondString )
                index = index + 2
            else:
                writeByteAt( buffer, position, character )
                position = position + 1
                index = index + 1
        writeByteAt( buffer, position, 0 )
        return ptrToString( buffer )

public function padTwo( I64 value ) -> String:
    
    """
    Format an integer as a 2-digit zero-padded string.
    Kept for backward compatibility — prefer padZero(value, 2).
    
    Parameters:
        value (I64):
            The integer value to format.
    
    Returns:
        String:
            A 2-character zero-padded string.
    """
    
    return padZero( value, 2 )

public function padFour( I64 value ) -> String:
    
    """
    Format an integer as a 4-digit zero-padded string.
    Kept for backward compatibility — prefer padZero(value, 4).
    
    Parameters:
        value (I64):
            The integer value to format.
    
    Returns:
        String:
            A 4-character zero-padded string.
    """
    
    return padZero( value, 4 )

public function fromTimestamp( I64 timestamp, I64 nanos, I64 utcOffset ) -> DateTime:
    
    """
    Create a DateTime from a Unix timestamp, nanoseconds, and UTC offset.
    Decomposes the timestamp into year, month, day, hour, minute, second
    using iterative subtraction over years and months.
    
    Parameters:
        timestamp (I64):
            The Unix timestamp in seconds since epoch.
        nanos (I64):
            The nanosecond component (0-999999999).
        utcOffset (I64):
            The UTC offset in seconds to apply.
    
    Returns:
        DateTime:
            A new DateTime decomposed from the given timestamp.
    
    Complexity:
        Time: O(y) where y is the number of years since 1970.
    """
    
    I64 adjustedTimestamp = timestamp + utcOffset
    I64 days = adjustedTimestamp / SECS_PER_DAY
    I64 remainder = adjustedTimestamp % SECS_PER_DAY
    if remainder < 0:
        days = days - 1
        remainder = remainder + SECS_PER_DAY
    I64 hour = remainder / 3600
    remainder = remainder % 3600
    I64 minute = remainder / 60
    I64 second = remainder % 60
    I64 year = EPOCH_YEAR
    Boolean finding = True
    while finding:
        I64 yearDays = daysInYear( year )
        if days < yearDays:
            finding = False
        else:
            days = days - yearDays
            year = year + 1
    I64 month = 1
    finding = True
    while finding:
        I64 monthDays = daysInMonth( year, month )
        if days < monthDays:
            finding = False
        else:
            days = days - monthDays
            month = month + 1
    I64 day = days + 1
    return new DateTime( year, month, day, hour, minute, second, nanos, utcOffset )

public function now() -> DateTime:
    
    """
    Get the current wall-clock time as a DateTime with UTC offset 0.
    
    Returns:
        DateTime:
            The current time from CLOCK_REALTIME.
    
    Complexity:
        Time: O(y) where y is the number of years since 1970.
    """
    
    Memory<I64> timespec = clockGettime( CLOCK_REALTIME )
    I64 pointer = memoryToPtr( timespec )
    I64 seconds = readI64At( pointer, 0 )
    I64 nanos = readI64At( pointer, 8 )
    return fromTimestamp( seconds, nanos, 0 )

public function nowMonotonic() -> I64:
    
    """
    Get the current monotonic time as nanoseconds since an arbitrary
    fixed point. Suitable for measuring elapsed time, not wall-clock.
    
    Returns:
        I64:
            Monotonic time in nanoseconds.
    
    Complexity:
        Time: O(1)
    """
    
    Memory<I64> timespec = clockGettime( CLOCK_MONOTONIC )
    I64 pointer = memoryToPtr( timespec )
    I64 seconds = readI64At( pointer, 0 )
    I64 nanos = readI64At( pointer, 8 )
    return seconds * 1000000000 + nanos

public function utc( I64 year, I64 month, I64 day, I64 hour, I64 minute, I64 second ) -> DateTime:
    
    """
    Create a DateTime at UTC (offset 0) with the given components.
    
    Parameters:
        year (I64):
            The calendar year.
        month (I64):
            The month (1-12).
        day (I64):
            The day (1-31).
        hour (I64):
            The hour (0-23).
        minute (I64):
            The minute (0-59).
        second (I64):
            The second (0-59).
    
    Returns:
        DateTime:
            A new DateTime at UTC with nanosecond 0.
    
    Complexity:
        Time: O(1)
        Space: O(1)
    """
    
    return new DateTime( year, month, day, hour, minute, second, 0, 0 )

public function date( I64 year, I64 month, I64 day ) -> DateTime:

    """
    Create a date-only DateTime at midnight UTC with the given year, month, and day.

    Parameters:
        year (I64):
            The calendar year.
        month (I64):
            The month (1-12).
        day (I64):
            The day of the month (1-31).

    Returns:
        DateTime:
            A new DateTime at midnight UTC.

    Complexity:
        Time: O(1)
        Space: O(1)
    """

    return new DateTime( year, month, day, 0, 0, 0, 0, 0 )

export {
    DateTime,
    isLeapYear,
    daysInMonth,
    daysInYear,
    fromTimestamp,
    now,
    nowMonotonic,
    utc,
    date,
    padTwo,
    padFour,
    clockGettime,
    SYS_CLOCK_GETTIME,
    CLOCK_REALTIME,
    CLOCK_MONOTONIC,
    EPOCH_YEAR
}
