package uranite.datetime.errors

from uranite.errors.error import Error

public class DateTimeError extends Error:
    
    """
    Base error class for all date and time related failures such as
    invalid date components, timezone lookup failures, or arithmetic
    overflow in temporal calculations.
    """
    
    public function DateTimeError( self, String message, I64 code, ?Error cause ) -> Void:
        
        """
        Create a new DateTimeError.
        
        Parameters:
            message (String):
                A human-readable description of the error.
            code (I64):
                A numeric error code identifying the failure type.
            cause (?Error):
                An optional underlying error, or None.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        parent( message, code, cause )

public class DateParseError extends DateTimeError:
    
    """
    Raised when a date or time string cannot be parsed into a valid
    DateTime due to malformed input or an unrecognized format.
    """
    
    public function DateParseError( self, String message, I64 code, ?Error cause ) -> Void:
        
        """
        Create a new DateParseError.
        
        Parameters:
            message (String):
                A description of the parsing failure.
            code (I64):
                A numeric error code.
            cause (?Error):
                An optional underlying error, or None.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        parent( message, code, cause )

public class InvalidDateError extends DateTimeError:
    
    """
    Raised when date components form an invalid date, such as
    month 13, day 32, or February 30.
    """
    
    public function InvalidDateError( self, String message, I64 code, ?Error cause ) -> Void:
        
        """
        Create a new InvalidDateError.
        
        Parameters:
            message (String):
                A description of which date component is invalid.
            code (I64):
                A numeric error code.
            cause (?Error):
                An optional underlying error, or None.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        parent( message, code, cause )

export {
    DateParseError,
    DateTimeError,
    InvalidDateError
}
