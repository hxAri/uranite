package uranite.datetime.timezone

from uranite.convert.convert import intToString
from uranite.datetime.datetime import DateTime, fromTimestamp
from uranite.datetime.errors import DateTimeError

public const I64 UTC_OFFSET = 0
""" UTC offset in seconds (0). """
public const I64 GMT_OFFSET = 0
""" GMT offset in seconds (0). """
public const I64 EST_OFFSET = -18000
""" US Eastern Standard Time offset in seconds (-5 hours). """
public const I64 EDT_OFFSET = -14400
""" US Eastern Daylight Time offset in seconds (-4 hours). """
public const I64 CST_OFFSET = -21600
""" US Central Standard Time offset in seconds (-6 hours). """
public const I64 CDT_OFFSET = -18000
""" US Central Daylight Time offset in seconds (-5 hours). """
public const I64 MST_OFFSET = -25200
""" US Mountain Standard Time offset in seconds (-7 hours). """
public const I64 MDT_OFFSET = -21600
""" US Mountain Daylight Time offset in seconds (-6 hours). """
public const I64 PST_OFFSET = -28800
""" US Pacific Standard Time offset in seconds (-8 hours). """
public const I64 PDT_OFFSET = -25200
""" US Pacific Daylight Time offset in seconds (-7 hours). """
public const I64 AKST_OFFSET = -32400
""" Alaska Standard Time offset in seconds (-9 hours). """
public const I64 AKDT_OFFSET = -28800
""" Alaska Daylight Time offset in seconds (-8 hours). """
public const I64 HST_OFFSET = -36000
""" Hawaii Standard Time offset in seconds (-10 hours). """
public const I64 CET_OFFSET = 3600
""" Central European Time offset in seconds (+1 hour). """
public const I64 CEST_OFFSET = 7200
""" Central European Summer Time offset in seconds (+2 hours). """
public const I64 EET_OFFSET = 7200
""" Eastern European Time offset in seconds (+2 hours). """
public const I64 EEST_OFFSET = 10800
""" Eastern European Summer Time offset in seconds (+3 hours). """
public const I64 IST_OFFSET = 19800
""" India Standard Time offset in seconds (+5:30 hours). """
public const I64 CST_CHINA_OFFSET = 28800
""" China Standard Time offset in seconds (+8 hours). """
public const I64 JST_OFFSET = 32400
""" Japan Standard Time offset in seconds (+9 hours). """
public const I64 KST_OFFSET = 32400
""" Korea Standard Time offset in seconds (+9 hours). """
public const I64 AEST_OFFSET = 36000
""" Australian Eastern Standard Time offset in seconds (+10 hours). """
public const I64 AEDT_OFFSET = 39600
""" Australian Eastern Daylight Time offset in seconds (+11 hours). """
public const I64 NZST_OFFSET = 43200
""" New Zealand Standard Time offset in seconds (+12 hours). """
public const I64 NZDT_OFFSET = 46800
""" New Zealand Daylight Time offset in seconds (+13 hours). """
public const I64 WIB_OFFSET = 25200
""" Western Indonesia Time offset in seconds (+7 hours). """

public class Timezone:
    
    """
    Represents a timezone as a named abbreviation paired with a fixed
    UTC offset in seconds. Provides methods for formatting the offset,
    extracting hour and minute components, and converting DateTimes
    between timezones.
    """
    
    public String name
    """ The timezone abbreviation (e.g. "UTC", "EST", "JST"). """
    public I64 offset
    """ The UTC offset in seconds. Negative for west of UTC, positive for east. """
    
    public function Timezone( self, String name, I64 offset ) -> Void:
        
        """
        Create a new Timezone with the given abbreviation and UTC offset.
        
        Parameters:
            name (String):
                The timezone abbreviation.
            offset (I64):
                The offset from UTC in seconds.
        """
        
        self.name = name
        self.offset = offset
    
    public function abbreviation( self ) -> String:
        
        """
        Return the timezone abbreviation.
        
        Returns:
            The timezone name string (e.g. "UTC", "PST").
        """
        
        return self.name
    
    public function offsetHours( self ) -> I64:
        
        """
        Return the whole hours component of the UTC offset.
        
        Returns:
            The offset divided by 3600, truncated toward zero.
        """
        
        return self.offset / 3600
    
    public function offsetMinutes( self ) -> I64:
        
        """
        Return the remaining minutes component of the UTC offset after
        removing the whole hours. Always returns a non-negative value.
        
        Returns:
            The absolute value of the minutes remainder (0-59).
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        I64 totalMinutes = self.offset / 60
        I64 hours = totalMinutes / 60
        I64 mins = totalMinutes - hours * 60
        if mins < 0:
            mins = 0 - mins
        return mins
    
    public function formatOffset( self ) -> String:
        
        """
        Format the UTC offset as a string in the form "+HH:MM" or
        "-HH:MM". Returns "+00:00" for zero offsets.
        
        Returns:
            A formatted offset string such as "+05:30" or "-08:00".
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """
        
        if self.offset == 0:
            return "+00:00"
        I64 sign = 1
        I64 absOffset = self.offset
        if absOffset < 0:
            sign = -1
            absOffset = 0 - absOffset
        I64 hours = absOffset / 3600
        I64 mins = ( absOffset - hours * 3600 ) / 60
        String hStr = intToString( hours )
        if hours < 10:
            hStr = "0" + hStr
        String mStr = intToString( mins )
        if mins < 10:
            mStr = "0" + mStr
        if sign < 0:
            return "-" + hStr + ":" + mStr
        return "+" + hStr + ":" + mStr
    
    public function convertFrom( self, DateTime dt ) -> DateTime:
        
        """
        Convert a DateTime from its current timezone to this timezone
        by extracting the UTC timestamp and reinterpreting it with
        this timezone's offset.
        
        Parameters:
            dt (DateTime):
                The source DateTime to convert.
        
        Returns:
            A new DateTime adjusted to this timezone's offset.
        """
        
        I64 ts = dt.toTimestamp()
        return fromTimestamp( ts, dt.nanosecond, self.offset )

public function utcTimezone() -> Timezone:
    
    """
    Create a Timezone representing Coordinated Universal Time (UTC+00:00).
    
    Returns:
        A Timezone with abbreviation "UTC" and zero offset.
    
    Complexity:
        Time: O(1)
        Space: O(1)
    """
    
    return new Timezone( "UTC", UTC_OFFSET )

public function gmtTimezone() -> Timezone:
    
    """
    Create a Timezone representing Greenwich Mean Time (GMT+00:00).
    
    Returns:
        A Timezone with abbreviation "GMT" and zero offset.
    
    Complexity:
        Time: O(1)
        Space: O(1)
    """
    
    return new Timezone( "GMT", GMT_OFFSET )

