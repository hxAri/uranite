package uranite.async.context

from uranite.io.syscall import memoryToPtr, writeI64At
from uranite.memory.memory import Memory

public function swapContext( I64 fromStackPtr, I64 toStackPtr ) -> Void:
    
    """
    Switch execution context between two coroutines by saving and restoring
    callee-saved registers and swapping the stack pointer. Uses x86-64
    push/pop instructions to preserve RBX, RBP, R12-R15, then exchanges
    RSP between the two context slots.
    
    Parameters:
        fromStackPtr (I64):
            Pointer to the memory location where the current RSP will be saved.
        toStackPtr (I64):
            Pointer to the memory location from which the target RSP will be loaded.
    """
    
    asm volatile "pushq %rbx\n\tpushq %rbp\n\tpushq %r12\n\tpushq %r13\n\tpushq %r14\n\tpushq %r15\n\tmovq %rsp, (%rdi)\n\tmovq (%rsi), %rsp\n\tpopq %r15\n\tpopq %r14\n\tpopq %r13\n\tpopq %r12\n\tpopq %rbp\n\tpopq %rbx" : output() : input( "{rdi}" fromStackPtr, "{rsi}" toStackPtr ) : clobber( "memory", "cc" )

public function makeContext( I64 stackBase, I64 stackSize, I64 entryFn ) -> I64:
    
    """
    Prepare a new execution context on a given stack region. Writes the entry
    function address and zeroed callee-saved register slots onto the stack,
    returning a stack pointer value ready for use with swapContext.
    
    Parameters:
        stackBase (I64):
            Base address of the allocated stack memory region.
        stackSize (I64):
            Size in bytes of the stack memory region.
        entryFn (I64):
            Address of the function to execute when the context is first resumed.
    
    Returns:
        I64:
            The initial RSP value for the newly prepared context, pointing to
            the bottom of the saved register frame.
    
    Complexity:
        Time: O(1)
        Space: O(1)
    """
    
    I64 stackTop = stackBase + stackSize
    I64 aligned = stackTop - ( stackTop % 16 )
    I64 base = aligned - 8
    writeI64At( base, 0, entryFn )
    writeI64At( base, -8, 0 )
    writeI64At( base, -16, 0 )
    writeI64At( base, -24, 0 )
    writeI64At( base, -32, 0 )
    writeI64At( base, -40, 0 )
    writeI64At( base, -48, 0 )
    return base - 48

export {
    makeContext, 
    swapContext
}
