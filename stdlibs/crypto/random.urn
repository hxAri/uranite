package uranite.crypto.random

from uranite.functions.builtin import ptrToString
from uranite.io.syscall import {
    readByteAt,
    stringToPtr,
    sysClose,
    sysOpen,
    sysRead,
    writeByteAt
}
from uranite.memory.allocator import alloc, dealloc
from uranite.os.crypto.rng import Csprng

public class SecureRandom:

    """
    Cryptographically secure random number generator using hardware entropy
    sources (RDRAND/RDSEED on x86-64). Wraps the kernel Csprng with a
    safe, high-level API.
    """

    protect Csprng generator

    public function SecureRandom( self ) -> Void:

        """
        Construct and seed the random generator from hardware entropy.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.generator = new Csprng()
        self.generator.seedFromHardware()

    public function nextI64( self ) -> I64:

        """ Generate a random 64-bit integer. """

        return self.generator.next()

    public function nextBounded( self, I64 bound ) -> I64:

        """
        Generate a random integer in [0, bound). Uses modular reduction
        on the raw CSPRNG output.
        """

        return self.generator.nextBounded( bound )

    public function nextInRange( self, I64 minimum, I64 maximum ) -> I64:

        """
        Generate a random integer in [minimum, maximum). Delegates to
        nextBounded with the range width.
        """

        I64 range = maximum - minimum
        return minimum + self.generator.nextBounded( range )

    public function fillRandom( self, I64 count ) -> I64:

        """
        Generate count random bytes and return a pointer to the filled buffer.
        """

        return self.generator.fillRandom( count )

    public function isInitialized( self ) -> Boolean:

        """
        Return whether the generator has been successfully seeded.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        return self.generator.isInitialized()

public function randomBytes( I64 bufferAddress, I64 byteCount ) -> Void:

    """
    Fill a buffer with cryptographically secure random bytes using
    hardware-seeded xoshiro256** CSPRNG. Each generated 64-bit value
    provides 8 bytes; partial final values are written byte-by-byte.

    Parameters:
        bufferAddress (I64):
            Destination buffer address to fill with random data.
        byteCount (I64):
            Number of random bytes to write.

    Complexity:
        Time: O(n)
        Space: O(1)
    """

    Csprng generator = new Csprng()
    generator.seedFromHardware()

    I64 writeOffset = 0
    while writeOffset + 8 <= byteCount:
        I64 randomValue = generator.next()
        writeByteAt( bufferAddress, writeOffset, randomValue & 255 )
        writeByteAt( bufferAddress, writeOffset + 1, ( randomValue >> 8 ) & 255 )
        writeByteAt( bufferAddress, writeOffset + 2, ( randomValue >> 16 ) & 255 )
        writeByteAt( bufferAddress, writeOffset + 3, ( randomValue >> 24 ) & 255 )
        writeByteAt( bufferAddress, writeOffset + 4, ( randomValue >> 32 ) & 255 )
        writeByteAt( bufferAddress, writeOffset + 5, ( randomValue >> 40 ) & 255 )
        writeByteAt( bufferAddress, writeOffset + 6, ( randomValue >> 48 ) & 255 )
        writeByteAt( bufferAddress, writeOffset + 7, ( randomValue >> 56 ) & 255 )
        writeOffset = writeOffset + 8

    if writeOffset < byteCount:
        I64 tailValue = generator.next()
        while writeOffset < byteCount:
            writeByteAt( bufferAddress, writeOffset, tailValue & 255 )
            tailValue = tailValue >> 8
            writeOffset = writeOffset + 1

const I64 O_RDONLY = 0
"""Read-only flag for open syscall."""

public class DevRandom:

    """
    Reads from /dev/random, the blocking true-entropy device. On modern
    Linux kernels (5.6+), /dev/random blocks only until the entropy pool
    is initialized, then behaves like /dev/urandom. On older kernels it
    may block when the entropy pool is depleted.

    Use for key generation, seeding, and scenarios requiring maximum
    entropy guarantees.
    """

    protect I64 fileDescriptor

    public function DevRandom( self ) -> Void:

        """
        Open /dev/random for reading.

        Raises:
            Error:
                If /dev/random cannot be opened.

        Complexity:
            Time: O(1)
            Space: O(1)
        """

        I64 pathAddress = stringToPtr( "/dev/random" )
        self.fileDescriptor = sysOpen( pathAddress, O_RDONLY, 0 )

    public function readBytes( self, I64 byteCount ) -> I64:

        """
        Read exactly byteCount bytes of entropy and return the buffer address.
        Caller owns the returned memory and must deallocate it.

        Parameters:
            byteCount (I64):
                Number of random bytes to read.

        Returns:
            I64:
                Address of allocated buffer containing random bytes.

        Complexity:
            Time: O(n) where n is byteCount
            Space: O(n)
        """

        I64 bufferAddress = alloc( byteCount )
        I64 totalRead = 0
        while totalRead < byteCount:
            I64 bytesRead = sysRead( self.fileDescriptor, bufferAddress + totalRead, byteCount - totalRead )
            if bytesRead <= 0:
                totalRead = byteCount
            else:
                totalRead = totalRead + bytesRead
        return bufferAddress

    public function readI64( self ) -> I64:

        """
        Read 8 bytes of entropy and return as a single I64 value.

        Returns:
            I64:
                A random 64-bit integer from /dev/random.

        Complexity:
            Time: O(1)
            Space: O(1)
        """

        I64 bufferAddress = alloc( 8 )
        I64 totalRead = 0
        while totalRead < 8:
            I64 bytesRead = sysRead( self.fileDescriptor, bufferAddress + totalRead, 8 - totalRead )
            if bytesRead <= 0:
                totalRead = 8
            else:
                totalRead = totalRead + bytesRead
        I64 result = readByteAt( bufferAddress, 0 )
        result = result | ( readByteAt( bufferAddress, 1 ) << 8 )
        result = result | ( readByteAt( bufferAddress, 2 ) << 16 )
        result = result | ( readByteAt( bufferAddress, 3 ) << 24 )
        result = result | ( readByteAt( bufferAddress, 4 ) << 32 )
        result = result | ( readByteAt( bufferAddress, 5 ) << 40 )
        result = result | ( readByteAt( bufferAddress, 6 ) << 48 )
        result = result | ( readByteAt( bufferAddress, 7 ) << 56 )
        dealloc( bufferAddress )
        return result

    public function fillBuffer( self, I64 destinationAddress, I64 byteCount ) -> Void:

        """
        Read exactly byteCount bytes into the provided buffer.

        Parameters:
            destinationAddress (I64):
                Address of the buffer to fill.
            byteCount (I64):
                Number of random bytes to write.

        Complexity:
            Time: O(n) where n is byteCount
            Space: O(1)
        """

        I64 totalRead = 0
        while totalRead < byteCount:
            I64 bytesRead = sysRead( self.fileDescriptor, destinationAddress + totalRead, byteCount - totalRead )
            if bytesRead <= 0:
                totalRead = byteCount
            else:
                totalRead = totalRead + bytesRead

    public function close( self ) -> Void:

        """
        Close the /dev/random file descriptor.

        Complexity:
            Time: O(1)
            Space: O(1)
        """

        sysClose( self.fileDescriptor )

public class DevUrandom:

    """
    Reads from /dev/urandom, the non-blocking CSPRNG device. Never blocks
    after the kernel entropy pool is initialized (which happens very early
    in boot). Suitable for most cryptographic use cases including session
    tokens, nonces, and general random data.
    """

    protect I64 fileDescriptor

    public function DevUrandom( self ) -> Void:

        """
        Open /dev/urandom for reading.

        Raises:
            Error:
                If /dev/urandom cannot be opened.

        Complexity:
            Time: O(1)
            Space: O(1)
        """

        I64 pathAddress = stringToPtr( "/dev/urandom" )
        self.fileDescriptor = sysOpen( pathAddress, O_RDONLY, 0 )

    public function readBytes( self, I64 byteCount ) -> I64:

        """
        Read exactly byteCount bytes of random data and return the buffer
        address. Caller owns the returned memory and must deallocate it.

        Parameters:
            byteCount (I64):
                Number of random bytes to read.

        Returns:
            I64:
                Address of allocated buffer containing random bytes.

        Complexity:
            Time: O(n) where n is byteCount
            Space: O(n)
        """

        I64 bufferAddress = alloc( byteCount )
        I64 totalRead = 0
        while totalRead < byteCount:
            I64 bytesRead = sysRead( self.fileDescriptor, bufferAddress + totalRead, byteCount - totalRead )
            if bytesRead <= 0:
                totalRead = byteCount
            else:
                totalRead = totalRead + bytesRead
        return bufferAddress

    public function readI64( self ) -> I64:

        """
        Read 8 bytes of random data and return as a single I64 value.

        Returns:
            I64:
                A random 64-bit integer from /dev/urandom.

        Complexity:
            Time: O(1)
            Space: O(1)
        """

        I64 bufferAddress = alloc( 8 )
        I64 totalRead = 0
        while totalRead < 8:
            I64 bytesRead = sysRead( self.fileDescriptor, bufferAddress + totalRead, 8 - totalRead )
            if bytesRead <= 0:
                totalRead = 8
            else:
                totalRead = totalRead + bytesRead
        I64 result = readByteAt( bufferAddress, 0 )
        result = result | ( readByteAt( bufferAddress, 1 ) << 8 )
        result = result | ( readByteAt( bufferAddress, 2 ) << 16 )
        result = result | ( readByteAt( bufferAddress, 3 ) << 24 )
        result = result | ( readByteAt( bufferAddress, 4 ) << 32 )
        result = result | ( readByteAt( bufferAddress, 5 ) << 40 )
        result = result | ( readByteAt( bufferAddress, 6 ) << 48 )
        result = result | ( readByteAt( bufferAddress, 7 ) << 56 )
        dealloc( bufferAddress )
        return result

    public function fillBuffer( self, I64 destinationAddress, I64 byteCount ) -> Void:

        """
        Read exactly byteCount bytes into the provided buffer.

        Parameters:
            destinationAddress (I64):
                Address of the buffer to fill.
            byteCount (I64):
                Number of random bytes to write.

        Complexity:
            Time: O(n) where n is byteCount
            Space: O(1)
        """

        I64 totalRead = 0
        while totalRead < byteCount:
            I64 bytesRead = sysRead( self.fileDescriptor, destinationAddress + totalRead, byteCount - totalRead )
            if bytesRead <= 0:
                totalRead = byteCount
            else:
                totalRead = totalRead + bytesRead

    public function close( self ) -> Void:

        """
        Close the /dev/urandom file descriptor.

        Complexity:
            Time: O(1)
            Space: O(1)
        """

        sysClose( self.fileDescriptor )

public function randomHexString( I64 byteCount ) -> String:

    """
    Generate a cryptographically secure random hex string using hardware
    CSPRNG. Returns a lowercase hexadecimal string of length byteCount * 2.

    Parameters:
        byteCount (I64):
            Number of random bytes (output string is 2x this length).

    Returns:
        String:
            Lowercase hex string of random data.

    Complexity:
        Time: O(n) where n is byteCount
        Space: O(n)
    """

    I64 bufferAddress = alloc( byteCount )
    randomBytes( bufferAddress, byteCount )
    I64 hexLength = byteCount * 2
    I64 hexBuffer = alloc( hexLength + 1 )
    I64 byteIndex = 0
    while byteIndex < byteCount:
        I64 byteValue = readByteAt( bufferAddress, byteIndex )
        if byteValue < 0:
            byteValue = byteValue + 256
        I64 highNibble = byteValue / 16
        I64 lowNibble = byteValue % 16
        I64 hexOffset = byteIndex * 2
        if highNibble < 10:
            writeByteAt( hexBuffer, hexOffset, 48 + highNibble )
        else:
            writeByteAt( hexBuffer, hexOffset, 87 + highNibble )
        if lowNibble < 10:
            writeByteAt( hexBuffer, hexOffset + 1, 48 + lowNibble )
        else:
            writeByteAt( hexBuffer, hexOffset + 1, 87 + lowNibble )
        byteIndex = byteIndex + 1
    writeByteAt( hexBuffer, hexLength, 0 )
    dealloc( bufferAddress )
    return ptrToString( hexBuffer )

export {
    Csprng,
    DevRandom,
    DevUrandom,
    SecureRandom,
    randomBytes,
    randomHexString
}
