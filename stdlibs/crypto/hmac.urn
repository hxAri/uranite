package uranite.crypto.hmac

from uranite.crypto.sha256 import SHA256_BLOCK_SIZE, SHA256_DIGEST_SIZE, Sha256
from uranite.crypto.sha512 import SHA512_BLOCK_SIZE, SHA512_DIGEST_SIZE, Sha512
from uranite.functions.builtin import ptrToString
from uranite.io.syscall import readByteAt, stringLen, stringToPtr, writeByteAt
from uranite.memory.allocator import alloc, dealloc

const I64 IPAD_BYTE = 54
"""Inner padding byte 0x36."""

const I64 OPAD_BYTE = 92
"""Outer padding byte 0x5C."""

public function hmacSha256( I64 keyAddress, I64 keyLength, I64 dataAddress, I64 dataLength, I64 outputAddress ) -> Void:

    """
    Compute HMAC-SHA-256 per RFC 2104. If the key is longer than the
    block size (64 bytes), it is first hashed with SHA-256 to produce
    a 32-byte derived key.

    Parameters:
        keyAddress (I64):
            Base address of the HMAC key.
        keyLength (I64):
            Length of the key in bytes.
        dataAddress (I64):
            Base address of the message data.
        dataLength (I64):
            Length of the message in bytes.
        outputAddress (I64):
            Address to write the 32-byte HMAC result.

    Complexity:
        Time: O(n) where n is keyLength + dataLength
        Space: O(1) (fixed overhead for padding buffers)
    """

    I64 effectiveKeyAddress = keyAddress
    I64 effectiveKeyLength = keyLength
    I64 hashedKeyAddress = 0
    if keyLength > SHA256_BLOCK_SIZE:
        hashedKeyAddress = alloc( SHA256_DIGEST_SIZE )
        Sha256 keyHasher = new Sha256()
        keyHasher.update( keyAddress, keyLength )
        keyHasher.digest( hashedKeyAddress )
        keyHasher.destroy()
        effectiveKeyAddress = hashedKeyAddress
        effectiveKeyLength = SHA256_DIGEST_SIZE

    I64 innerPadAddress = alloc( SHA256_BLOCK_SIZE )
    I64 outerPadAddress = alloc( SHA256_BLOCK_SIZE )
    I64 padIndex = 0
    while padIndex < SHA256_BLOCK_SIZE:
        I64 keyByte = 0
        if padIndex < effectiveKeyLength:
            keyByte = readByteAt( effectiveKeyAddress, padIndex )
        writeByteAt( innerPadAddress, padIndex, ( keyByte ^ IPAD_BYTE ) & 255 )
        writeByteAt( outerPadAddress, padIndex, ( keyByte ^ OPAD_BYTE ) & 255 )
        padIndex = padIndex + 1

    I64 innerDigestAddress = alloc( SHA256_DIGEST_SIZE )
    Sha256 innerHasher = new Sha256()
    innerHasher.update( innerPadAddress, SHA256_BLOCK_SIZE )
    innerHasher.update( dataAddress, dataLength )
    innerHasher.digest( innerDigestAddress )
    innerHasher.destroy()

    Sha256 outerHasher = new Sha256()
    outerHasher.update( outerPadAddress, SHA256_BLOCK_SIZE )
    outerHasher.update( innerDigestAddress, SHA256_DIGEST_SIZE )
    outerHasher.digest( outputAddress )
    outerHasher.destroy()

    dealloc( innerPadAddress )
    dealloc( outerPadAddress )
    dealloc( innerDigestAddress )
    if hashedKeyAddress != 0:
        dealloc( hashedKeyAddress )

public function hmacSha512( I64 keyAddress, I64 keyLength, I64 dataAddress, I64 dataLength, I64 outputAddress ) -> Void:

    """
    Compute HMAC-SHA-512 per RFC 2104. If the key is longer than the
    block size (128 bytes), it is first hashed with SHA-512 to produce
    a 64-byte derived key.

    Parameters:
        keyAddress (I64):
            Base address of the HMAC key.
        keyLength (I64):
            Length of the key in bytes.
        dataAddress (I64):
            Base address of the message data.
        dataLength (I64):
            Length of the message in bytes.
        outputAddress (I64):
            Address to write the 64-byte HMAC result.

    Complexity:
        Time: O(n) where n is keyLength + dataLength
        Space: O(1) (fixed overhead for padding buffers)
    """

    I64 effectiveKeyAddress = keyAddress
    I64 effectiveKeyLength = keyLength
    I64 hashedKeyAddress = 0
    if keyLength > SHA512_BLOCK_SIZE:
        hashedKeyAddress = alloc( SHA512_DIGEST_SIZE )
        Sha512 keyHasher = new Sha512()
        keyHasher.update( keyAddress, keyLength )
        keyHasher.digest( hashedKeyAddress )
        keyHasher.destroy()
        effectiveKeyAddress = hashedKeyAddress
        effectiveKeyLength = SHA512_DIGEST_SIZE

    I64 innerPadAddress = alloc( SHA512_BLOCK_SIZE )
    I64 outerPadAddress = alloc( SHA512_BLOCK_SIZE )
    I64 padIndex = 0
    while padIndex < SHA512_BLOCK_SIZE:
        I64 keyByte = 0
        if padIndex < effectiveKeyLength:
            keyByte = readByteAt( effectiveKeyAddress, padIndex )
        writeByteAt( innerPadAddress, padIndex, ( keyByte ^ IPAD_BYTE ) & 255 )
        writeByteAt( outerPadAddress, padIndex, ( keyByte ^ OPAD_BYTE ) & 255 )
        padIndex = padIndex + 1

    I64 innerDigestAddress = alloc( SHA512_DIGEST_SIZE )
    Sha512 innerHasher = new Sha512()
    innerHasher.update( innerPadAddress, SHA512_BLOCK_SIZE )
    innerHasher.update( dataAddress, dataLength )
    innerHasher.digest( innerDigestAddress )
    innerHasher.destroy()

    Sha512 outerHasher = new Sha512()
    outerHasher.update( outerPadAddress, SHA512_BLOCK_SIZE )
    outerHasher.update( innerDigestAddress, SHA512_DIGEST_SIZE )
    outerHasher.digest( outputAddress )
    outerHasher.destroy()

    dealloc( innerPadAddress )
    dealloc( outerPadAddress )
    dealloc( innerDigestAddress )
    if hashedKeyAddress != 0:
        dealloc( hashedKeyAddress )

function bytesToHex( I64 dataAddress, I64 dataLength ) -> String:

    """
    Convert raw bytes to a lowercase hexadecimal string.

    Parameters:
        dataAddress (I64):
            Address of the byte data.
        dataLength (I64):
            Number of bytes.

    Returns:
        String:
            Hex-encoded string (2 characters per byte).

    Complexity:
        Time: O(n) where n is dataLength
        Space: O(2n)
    """

    I64 hexLength = dataLength * 2
    I64 hexBuffer = alloc( hexLength + 1 )
    I64 byteIndex = 0
    while byteIndex < dataLength:
        I64 byteValue = readByteAt( dataAddress, byteIndex )
        if byteValue < 0:
            byteValue = byteValue + 256
        I64 highNibble = byteValue / 16
        I64 lowNibble = byteValue % 16
        I64 hexOffset = byteIndex * 2
        if highNibble < 10:
            writeByteAt( hexBuffer, hexOffset, 48 + highNibble )
        else:
            writeByteAt( hexBuffer, hexOffset, 87 + highNibble )
        if lowNibble < 10:
            writeByteAt( hexBuffer, hexOffset + 1, 48 + lowNibble )
        else:
            writeByteAt( hexBuffer, hexOffset + 1, 87 + lowNibble )
        byteIndex = byteIndex + 1
    writeByteAt( hexBuffer, hexLength, 0 )
    return ptrToString( hexBuffer )

public function hmacSha256Digest( String key, String data ) -> String:

    """
    Compute HMAC-SHA-256 over string inputs and return the result as
    a 64-character lowercase hexadecimal string.

    Parameters:
        key (String):
            The HMAC key.
        data (String):
            The message to authenticate.

    Returns:
        String:
            The 32-byte MAC as 64 hex characters.

    Complexity:
        Time: O(n) where n is key + data length
        Space: O(1)
    """

    I64 keyAddress = stringToPtr( key )
    I64 keyLength = stringLen( key )
    I64 dataAddress = stringToPtr( data )
    I64 dataLength = stringLen( data )
    I64 outputAddress = alloc( SHA256_DIGEST_SIZE )
    hmacSha256( keyAddress, keyLength, dataAddress, dataLength, outputAddress )
    String result = bytesToHex( outputAddress, SHA256_DIGEST_SIZE )
    dealloc( outputAddress )
    return result

public function hmacSha512Digest( String key, String data ) -> String:

    """
    Compute HMAC-SHA-512 over string inputs and return the result as
    a 128-character lowercase hexadecimal string.

    Parameters:
        key (String):
            The HMAC key.
        data (String):
            The message to authenticate.

    Returns:
        String:
            The 64-byte MAC as 128 hex characters.

    Complexity:
        Time: O(n) where n is key + data length
        Space: O(1)
    """

    I64 keyAddress = stringToPtr( key )
    I64 keyLength = stringLen( key )
    I64 dataAddress = stringToPtr( data )
    I64 dataLength = stringLen( data )
    I64 outputAddress = alloc( SHA512_DIGEST_SIZE )
    hmacSha512( keyAddress, keyLength, dataAddress, dataLength, outputAddress )
    String result = bytesToHex( outputAddress, SHA512_DIGEST_SIZE )
    dealloc( outputAddress )
    return result

export {
    hmacSha256,
    hmacSha256Digest,
    hmacSha512,
    hmacSha512Digest
}
