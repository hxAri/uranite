package uranite.crypto.cipher

from uranite.io.syscall import readByteAt, stringLen, stringToPtr
from uranite.os.crypto.aes import AES_128, AES_256, AES_BLOCK_SIZE, AesContext

public class AesCipher:

    """
    AES block cipher supporting 128-bit and 256-bit key sizes. Provides
    single-block encrypt and decrypt operations. Wraps the kernel AesContext
    with initialization validation.
    """

    protect AesContext context
    protect I64 keyBits

    public function AesCipher( self, I64 keyBits ) -> Void:

        """
        Construct an AES cipher with the specified key size (AES_128 or AES_256).

        Parameters:
            keyBits (I64):
                Key size in bits. Use AES_128 (128) or AES_256 (256).
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.context = new AesContext( keyBits )
        self.keyBits = keyBits

    public function init( self, I64 k0, I64 k1, I64 k2, I64 k3 ) -> Void:

        """
        Initialize the cipher with a key specified as four 64-bit words.
        For AES-128, only k0 and k1 are used. For AES-256, all four words
        form the full key.
        """

        self.context.init( k0, k1, k2, k3 )

    public function initFromBytes( self, String keyBytes ) -> Void:

        """
        Initialize the cipher from a raw byte string. For AES-128, the
        string must be at least 16 bytes; for AES-256, at least 32 bytes.
        Bytes are packed into 64-bit words in little-endian order.

        Parameters:
            keyBytes (String):
                Raw key bytes as a string.

        Complexity:
            Time: O(1)
            Space: O(1)
        """

        I64 keyAddress = stringToPtr( keyBytes )
        I64 keyLength = stringLen( keyBytes )
        I64 k0 = 0
        I64 k1 = 0
        I64 k2 = 0
        I64 k3 = 0
        if keyLength >= 8:
            k0 = readByteAt( keyAddress, 0 )
            k0 = k0 | ( readByteAt( keyAddress, 1 ) << 8 )
            k0 = k0 | ( readByteAt( keyAddress, 2 ) << 16 )
            k0 = k0 | ( readByteAt( keyAddress, 3 ) << 24 )
            k0 = k0 | ( readByteAt( keyAddress, 4 ) << 32 )
            k0 = k0 | ( readByteAt( keyAddress, 5 ) << 40 )
            k0 = k0 | ( readByteAt( keyAddress, 6 ) << 48 )
            k0 = k0 | ( readByteAt( keyAddress, 7 ) << 56 )
        if keyLength >= 16:
            k1 = readByteAt( keyAddress, 8 )
            k1 = k1 | ( readByteAt( keyAddress, 9 ) << 8 )
            k1 = k1 | ( readByteAt( keyAddress, 10 ) << 16 )
            k1 = k1 | ( readByteAt( keyAddress, 11 ) << 24 )
            k1 = k1 | ( readByteAt( keyAddress, 12 ) << 32 )
            k1 = k1 | ( readByteAt( keyAddress, 13 ) << 40 )
            k1 = k1 | ( readByteAt( keyAddress, 14 ) << 48 )
            k1 = k1 | ( readByteAt( keyAddress, 15 ) << 56 )
        if keyLength >= 24:
            k2 = readByteAt( keyAddress, 16 )
            k2 = k2 | ( readByteAt( keyAddress, 17 ) << 8 )
            k2 = k2 | ( readByteAt( keyAddress, 18 ) << 16 )
            k2 = k2 | ( readByteAt( keyAddress, 19 ) << 24 )
            k2 = k2 | ( readByteAt( keyAddress, 20 ) << 32 )
            k2 = k2 | ( readByteAt( keyAddress, 21 ) << 40 )
            k2 = k2 | ( readByteAt( keyAddress, 22 ) << 48 )
            k2 = k2 | ( readByteAt( keyAddress, 23 ) << 56 )
        if keyLength >= 32:
            k3 = readByteAt( keyAddress, 24 )
            k3 = k3 | ( readByteAt( keyAddress, 25 ) << 8 )
            k3 = k3 | ( readByteAt( keyAddress, 26 ) << 16 )
            k3 = k3 | ( readByteAt( keyAddress, 27 ) << 24 )
            k3 = k3 | ( readByteAt( keyAddress, 28 ) << 32 )
            k3 = k3 | ( readByteAt( keyAddress, 29 ) << 40 )
            k3 = k3 | ( readByteAt( keyAddress, 30 ) << 48 )
            k3 = k3 | ( readByteAt( keyAddress, 31 ) << 56 )
        self.context.init( k0, k1, k2, k3 )

    public function hasHardwareSupport( self ) -> Boolean:

        """ Return whether AES-NI hardware acceleration is available. """

        return self.context.hasHardwareSupport()

    public function getRounds( self ) -> I64:

        """ Return the number of AES rounds (10 for 128, 14 for 256). """

        return self.context.getRounds()

    public function getKeySize( self ) -> I64:

        """ Return the configured key size in bits. """

        return self.context.getKeySize()

    public function isInitialized( self ) -> Boolean:

        """ Return whether the cipher has been initialized with a key. """

        return self.context.isInitialized()

    public function destroy( self ) -> Void:

        """
        Securely destroy the cipher context and key material.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.context.destroy()

export {
    AES_128,
    AES_256,
    AES_BLOCK_SIZE,
    AesCipher,
    AesContext
}
