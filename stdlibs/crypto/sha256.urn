package uranite.crypto.sha256

from uranite.encoding.binary import readI32Be, writeI32Be
from uranite.functions.builtin import ptrToString
from uranite.io.syscall import readByteAt, stringLen, stringToPtr, writeByteAt
from uranite.memory.allocator import alloc, dealloc

const I64 SHA256_BLOCK_SIZE = 64
"""SHA-256 processes data in 64-byte (512-bit) blocks."""

const I64 SHA256_DIGEST_SIZE = 32
"""SHA-256 produces a 32-byte (256-bit) digest."""

const I64 MASK32 = 4294967295
"""Bitmask for 32-bit unsigned arithmetic (0xFFFFFFFF)."""

public class Sha256:

    """
    SHA-256 hash computation state. Supports incremental hashing via
    update() calls followed by a final digest() call. The state can be
    reset for reuse without reallocation.
    """

    protect I64 stateAddress
    protect I64 blockAddress
    protect I64 blockLength
    protect I64 totalBytesLow
    protect I64 totalBytesHigh
    protect I64 roundConstantsAddress

    public function Sha256( self ) -> Void:

        """
        Construct a new SHA-256 hasher with initial hash values per
        FIPS 180-4 section 5.3.3 and precomputed round constants.

        Complexity:
            Time: O(1)
            Space: O(1) (360 bytes allocated: 32 state + 64 block + 256 constants)
        """

        self.stateAddress = alloc( 32 )
        self.blockAddress = alloc( SHA256_BLOCK_SIZE )
        self.blockLength = 0
        self.totalBytesLow = 0
        self.totalBytesHigh = 0
        self.roundConstantsAddress = alloc( 256 )
        self.initializeState()
        self.initializeRoundConstants()

    protect function initializeState( self ) -> Void:

        """
        Set the eight 32-bit state words to the SHA-256 initial hash values.
        """

        writeI32Be( self.stateAddress, 0, 1779033703 )
        writeI32Be( self.stateAddress, 4, 3144134277 )
        writeI32Be( self.stateAddress, 8, 1013904242 )
        writeI32Be( self.stateAddress, 12, 2773480762 )
        writeI32Be( self.stateAddress, 16, 1359893119 )
        writeI32Be( self.stateAddress, 20, 2600822924 )
        writeI32Be( self.stateAddress, 24, 528734635 )
        writeI32Be( self.stateAddress, 28, 1541459225 )

    protect function initializeRoundConstants( self ) -> Void:

        """
        Store the 64 SHA-256 round constants (first 32 bits of the fractional
        parts of the cube roots of the first 64 primes) into the constants
        buffer as big-endian I32 values.
        """

        I64 rcAddress = self.roundConstantsAddress
        writeI32Be( rcAddress, 0, 1116352408 )
        writeI32Be( rcAddress, 4, 1899447441 )
        writeI32Be( rcAddress, 8, 3049323471 )
        writeI32Be( rcAddress, 12, 3921009573 )
        writeI32Be( rcAddress, 16, 961987163 )
        writeI32Be( rcAddress, 20, 1508970993 )
        writeI32Be( rcAddress, 24, 2453635748 )
        writeI32Be( rcAddress, 28, 2870763221 )
        writeI32Be( rcAddress, 32, 3624381080 )
        writeI32Be( rcAddress, 36, 310598401 )
        writeI32Be( rcAddress, 40, 607225278 )
        writeI32Be( rcAddress, 44, 1426881987 )
        writeI32Be( rcAddress, 48, 1925078388 )
        writeI32Be( rcAddress, 52, 2162078206 )
        writeI32Be( rcAddress, 56, 2614888103 )
        writeI32Be( rcAddress, 60, 3248222580 )
        writeI32Be( rcAddress, 64, 3835390401 )
        writeI32Be( rcAddress, 68, 4022224774 )
        writeI32Be( rcAddress, 72, 264347078 )
        writeI32Be( rcAddress, 76, 604807628 )
        writeI32Be( rcAddress, 80, 770255983 )
        writeI32Be( rcAddress, 84, 1249150122 )
        writeI32Be( rcAddress, 88, 1555081692 )
        writeI32Be( rcAddress, 92, 1996064986 )
        writeI32Be( rcAddress, 96, 2554220882 )
        writeI32Be( rcAddress, 100, 2821834349 )
        writeI32Be( rcAddress, 104, 2952996808 )
        writeI32Be( rcAddress, 108, 3210313671 )
        writeI32Be( rcAddress, 112, 3336571891 )
        writeI32Be( rcAddress, 116, 3584528711 )
        writeI32Be( rcAddress, 120, 113926993 )
        writeI32Be( rcAddress, 124, 338241895 )
        writeI32Be( rcAddress, 128, 666307205 )
        writeI32Be( rcAddress, 132, 773529912 )
        writeI32Be( rcAddress, 136, 1294757372 )
        writeI32Be( rcAddress, 140, 1396182291 )
        writeI32Be( rcAddress, 144, 1695183700 )
        writeI32Be( rcAddress, 148, 1986661051 )
        writeI32Be( rcAddress, 152, 2177026350 )
        writeI32Be( rcAddress, 156, 2456956037 )
        writeI32Be( rcAddress, 160, 2730485921 )
        writeI32Be( rcAddress, 164, 2820302411 )
        writeI32Be( rcAddress, 168, 3259730800 )
        writeI32Be( rcAddress, 172, 3345764771 )
        writeI32Be( rcAddress, 176, 3516065817 )
        writeI32Be( rcAddress, 180, 3600352804 )
        writeI32Be( rcAddress, 184, 4094571909 )
        writeI32Be( rcAddress, 188, 275423344 )
        writeI32Be( rcAddress, 192, 430227734 )
        writeI32Be( rcAddress, 196, 506948616 )
        writeI32Be( rcAddress, 200, 659060556 )
        writeI32Be( rcAddress, 204, 883997877 )
        writeI32Be( rcAddress, 208, 958139571 )
        writeI32Be( rcAddress, 212, 1322822218 )
        writeI32Be( rcAddress, 216, 1537002063 )
        writeI32Be( rcAddress, 220, 1747873779 )
        writeI32Be( rcAddress, 224, 1955562222 )
        writeI32Be( rcAddress, 228, 2024104815 )
        writeI32Be( rcAddress, 232, 2227730452 )
        writeI32Be( rcAddress, 236, 2361852424 )
        writeI32Be( rcAddress, 240, 2428436474 )
        writeI32Be( rcAddress, 244, 2756734187 )
        writeI32Be( rcAddress, 248, 3204031479 )
        writeI32Be( rcAddress, 252, 3329325298 )

    protect function rightRotate32( self, I64 value, I64 amount ) -> I64:

        """
        Perform a 32-bit right rotation.

        Parameters:
            value (I64):
                The 32-bit value to rotate.
            amount (I64):
                Number of bit positions to rotate right.

        Returns:
            I64:
                The rotated 32-bit value.
        """

        I64 masked = value & MASK32
        return ( ( masked >> amount ) | ( masked << ( 32 - amount ) ) ) & MASK32

    protect function processBlock( self ) -> Void:

        """
        Process a single 64-byte block through the SHA-256 compression
        function. Reads the block from self.blockAddress, reads and updates
        the state at self.stateAddress.

        Complexity:
            Time: O(1) (64 rounds, constant)
            Space: O(1) (256 bytes for message schedule)
        """

        I64 scheduleAddress = alloc( 256 )
        I64 scheduleIndex = 0
        while scheduleIndex < 16:
            I64 word = readI32Be( self.blockAddress, scheduleIndex * 4 )
            writeI32Be( scheduleAddress, scheduleIndex * 4, word & MASK32 )
            scheduleIndex = scheduleIndex + 1
        while scheduleIndex < 64:
            I64 w15 = readI32Be( scheduleAddress, ( scheduleIndex - 15 ) * 4 ) & MASK32
            I64 w2 = readI32Be( scheduleAddress, ( scheduleIndex - 2 ) * 4 ) & MASK32
            I64 w16 = readI32Be( scheduleAddress, ( scheduleIndex - 16 ) * 4 ) & MASK32
            I64 w7 = readI32Be( scheduleAddress, ( scheduleIndex - 7 ) * 4 ) & MASK32
            I64 sigma0 = self.rightRotate32( w15, 7 ) ^ self.rightRotate32( w15, 18 ) ^ ( ( w15 >> 3 ) & 536870911 )
            I64 sigma1 = self.rightRotate32( w2, 17 ) ^ self.rightRotate32( w2, 19 ) ^ ( ( w2 >> 10 ) & 4194303 )
            I64 newWord = ( w16 + sigma0 + w7 + sigma1 ) & MASK32
            writeI32Be( scheduleAddress, scheduleIndex * 4, newWord )
            scheduleIndex = scheduleIndex + 1
        I64 workA = readI32Be( self.stateAddress, 0 ) & MASK32
        I64 workB = readI32Be( self.stateAddress, 4 ) & MASK32
        I64 workC = readI32Be( self.stateAddress, 8 ) & MASK32
        I64 workD = readI32Be( self.stateAddress, 12 ) & MASK32
        I64 workE = readI32Be( self.stateAddress, 16 ) & MASK32
        I64 workF = readI32Be( self.stateAddress, 20 ) & MASK32
        I64 workG = readI32Be( self.stateAddress, 24 ) & MASK32
        I64 workH = readI32Be( self.stateAddress, 28 ) & MASK32
        I64 roundIndex = 0
        while roundIndex < 64:
            I64 bigSigma1 = self.rightRotate32( workE, 6 ) ^ self.rightRotate32( workE, 11 ) ^ self.rightRotate32( workE, 25 )
            I64 choice = ( workE & workF ) ^ ( ( ( workE ^ MASK32 ) & MASK32 ) & workG )
            I64 roundConstant = readI32Be( self.roundConstantsAddress, roundIndex * 4 ) & MASK32
            I64 scheduleWord = readI32Be( scheduleAddress, roundIndex * 4 ) & MASK32
            I64 temp1 = ( workH + bigSigma1 + choice + roundConstant + scheduleWord ) & MASK32
            I64 bigSigma0 = self.rightRotate32( workA, 2 ) ^ self.rightRotate32( workA, 13 ) ^ self.rightRotate32( workA, 22 )
            I64 majority = ( workA & workB ) ^ ( workA & workC ) ^ ( workB & workC )
            I64 temp2 = ( bigSigma0 + majority ) & MASK32
            workH = workG
            workG = workF
            workF = workE
            workE = ( workD + temp1 ) & MASK32
            workD = workC
            workC = workB
            workB = workA
            workA = ( temp1 + temp2 ) & MASK32
            roundIndex = roundIndex + 1
        writeI32Be( self.stateAddress, 0, ( ( readI32Be( self.stateAddress, 0 ) & MASK32 ) + workA ) & MASK32 )
        writeI32Be( self.stateAddress, 4, ( ( readI32Be( self.stateAddress, 4 ) & MASK32 ) + workB ) & MASK32 )
        writeI32Be( self.stateAddress, 8, ( ( readI32Be( self.stateAddress, 8 ) & MASK32 ) + workC ) & MASK32 )
        writeI32Be( self.stateAddress, 12, ( ( readI32Be( self.stateAddress, 12 ) & MASK32 ) + workD ) & MASK32 )
        writeI32Be( self.stateAddress, 16, ( ( readI32Be( self.stateAddress, 16 ) & MASK32 ) + workE ) & MASK32 )
        writeI32Be( self.stateAddress, 20, ( ( readI32Be( self.stateAddress, 20 ) & MASK32 ) + workF ) & MASK32 )
        writeI32Be( self.stateAddress, 24, ( ( readI32Be( self.stateAddress, 24 ) & MASK32 ) + workG ) & MASK32 )
        writeI32Be( self.stateAddress, 28, ( ( readI32Be( self.stateAddress, 28 ) & MASK32 ) + workH ) & MASK32 )
        dealloc( scheduleAddress )

    public function update( self, I64 dataAddress, I64 dataLength ) -> Void:

        """
        Feed data into the hash computation. Can be called multiple times
        to hash data incrementally. Internally buffers partial blocks and
        processes complete 64-byte blocks as they become available.

        Parameters:
            dataAddress (I64):
                Base address of the input data.
            dataLength (I64):
                Number of bytes to process.

        Complexity:
            Time: O(n) where n is dataLength
            Space: O(1)
        """

        I64 inputIndex = 0
        while inputIndex < dataLength:
            I64 spaceInBlock = SHA256_BLOCK_SIZE - self.blockLength
            I64 bytesToCopy = dataLength - inputIndex
            if bytesToCopy > spaceInBlock:
                bytesToCopy = spaceInBlock
            I64 copyIndex = 0
            while copyIndex < bytesToCopy:
                I64 byteValue = readByteAt( dataAddress, inputIndex + copyIndex )
                writeByteAt( self.blockAddress, self.blockLength + copyIndex, byteValue )
                copyIndex = copyIndex + 1
            self.blockLength = self.blockLength + bytesToCopy
            inputIndex = inputIndex + bytesToCopy
            self.totalBytesLow = self.totalBytesLow + bytesToCopy
            if self.totalBytesLow >= 4294967296:
                self.totalBytesHigh = self.totalBytesHigh + 1
                self.totalBytesLow = self.totalBytesLow & MASK32
            if self.blockLength == SHA256_BLOCK_SIZE:
                self.processBlock()
                self.blockLength = 0

    public function updateString( self, String data ) -> Void:

        """
        Feed a string into the hash computation. Convenience wrapper that
        converts the string to a raw address and length internally.

        Parameters:
            data (String):
                The string data to hash.

        Complexity:
            Time: O(n) where n is string length
            Space: O(1)
        """

        I64 dataAddress = stringToPtr( data )
        I64 dataLength = stringLen( data )
        self.update( dataAddress, dataLength )

    public function digest( self, I64 outputAddress ) -> Void:

        """
        Finalize the hash computation and write the 32-byte digest to the
        output address. Applies FIPS 180-4 padding: a 1-bit, zero padding
        to 56 bytes mod 64, then the 64-bit message length in bits.

        After calling digest(), the hasher state is consumed. Call reset()
        before reusing.

        Parameters:
            outputAddress (I64):
                Address to write the 32-byte digest.

        Complexity:
            Time: O(1) (at most 2 block compressions for padding)
            Space: O(1)
        """

        I64 totalBitsLow = ( self.totalBytesLow << 3 ) & MASK32
        I64 totalBitsHigh = ( self.totalBytesHigh << 3 ) | ( ( self.totalBytesLow >> 29 ) & 7 )
        writeByteAt( self.blockAddress, self.blockLength, 128 )
        self.blockLength = self.blockLength + 1
        if self.blockLength > 56:
            while self.blockLength < SHA256_BLOCK_SIZE:
                writeByteAt( self.blockAddress, self.blockLength, 0 )
                self.blockLength = self.blockLength + 1
            self.processBlock()
            self.blockLength = 0
        while self.blockLength < 56:
            writeByteAt( self.blockAddress, self.blockLength, 0 )
            self.blockLength = self.blockLength + 1
        writeI32Be( self.blockAddress, 56, totalBitsHigh & MASK32 )
        writeI32Be( self.blockAddress, 60, totalBitsLow & MASK32 )
        self.processBlock()
        I64 stateIndex = 0
        while stateIndex < 8:
            I64 word = readI32Be( self.stateAddress, stateIndex * 4 )
            writeI32Be( outputAddress, stateIndex * 4, word & MASK32 )
            stateIndex = stateIndex + 1

    public function hexDigest( self ) -> String:

        """
        Finalize the hash and return the digest as a 64-character lowercase
        hexadecimal string. Consumes the hasher state — call reset() before
        reusing.

        Returns:
            String:
                The 32-byte digest encoded as 64 hex characters.

        Complexity:
            Time: O(1)
            Space: O(64) for hex output buffer
        """

        I64 rawDigest = alloc( SHA256_DIGEST_SIZE )
        self.digest( rawDigest )
        I64 hexBuffer = alloc( 65 )
        I64 digestIndex = 0
        while digestIndex < SHA256_DIGEST_SIZE:
            I64 byteValue = readByteAt( rawDigest, digestIndex )
            if byteValue < 0:
                byteValue = byteValue + 256
            I64 highNibble = byteValue / 16
            I64 lowNibble = byteValue % 16
            I64 hexOffset = digestIndex * 2
            if highNibble < 10:
                writeByteAt( hexBuffer, hexOffset, 48 + highNibble )
            else:
                writeByteAt( hexBuffer, hexOffset, 87 + highNibble )
            if lowNibble < 10:
                writeByteAt( hexBuffer, hexOffset + 1, 48 + lowNibble )
            else:
                writeByteAt( hexBuffer, hexOffset + 1, 87 + lowNibble )
            digestIndex = digestIndex + 1
        writeByteAt( hexBuffer, 64, 0 )
        dealloc( rawDigest )
        return ptrToString( hexBuffer )

    public function reset( self ) -> Void:

        """
        Reset the hasher to its initial state for reuse without
        reallocation.

        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.initializeState()
        self.blockLength = 0
        self.totalBytesLow = 0
        self.totalBytesHigh = 0

    public function destroy( self ) -> Void:

        """
        Free all memory allocated by this hasher. Must not be used after.

        Complexity:
            Time: O(1)
            Space: O(1)
        """

        dealloc( self.stateAddress )
        dealloc( self.blockAddress )
        dealloc( self.roundConstantsAddress )

public function sha256( I64 dataAddress, I64 dataLength, I64 outputAddress ) -> Void:

    """
    Compute the SHA-256 hash of dataLength bytes at dataAddress and write
    the 32-byte digest to outputAddress. Convenience function for single-
    shot hashing without manual hasher lifecycle management.

    Parameters:
        dataAddress (I64):
            Base address of the input data.
        dataLength (I64):
            Number of bytes to hash.
        outputAddress (I64):
            Address to write the 32-byte digest.

    Complexity:
        Time: O(n) where n is dataLength
        Space: O(1)
    """

    Sha256 hasher = new Sha256()
    hasher.update( dataAddress, dataLength )
    hasher.digest( outputAddress )
    hasher.destroy()

public function sha256Digest( String data ) -> String:

    """
    Compute the SHA-256 hash of a string and return the result as a
    64-character lowercase hexadecimal string. Single-shot convenience
    function for the most common use case.

    Parameters:
        data (String):
            The string to hash.

    Returns:
        String:
            The 32-byte digest as 64 hex characters.

    Complexity:
        Time: O(n) where n is string length
        Space: O(1)
    """

    Sha256 hasher = new Sha256()
    hasher.updateString( data )
    String result = hasher.hexDigest()
    hasher.destroy()
    return result

export {
    SHA256_BLOCK_SIZE,
    SHA256_DIGEST_SIZE,
    Sha256,
    sha256,
    sha256Digest
}
