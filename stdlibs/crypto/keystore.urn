package uranite.crypto.keystore

from uranite.os.crypto.keystore import KeyState, KeyStore, KeyType

public class SecureKeyStore:

    """
    Managed cryptographic key storage with lifecycle tracking. Keys
    transition through Active → Revoked → Destroyed states. Ownership
    is tracked per-key via owner IDs.
    """

    protect KeyStore store

    public function SecureKeyStore( self, I64 capacity ) -> Void:

        """
        Construct a key store that can hold up to capacity keys.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.store = new KeyStore( capacity )

    public function storeKey( self, I64 keyType, I64 ownerId, I64 d0, I64 d1, I64 d2, I64 d3 ) -> I64:

        """
        Store a new key with the given type and owner. Key material is
        specified as four 64-bit words. Returns the storage slot index.
        """

        return self.store.store( keyType, ownerId, d0, d1, d2, d3 )

    public function revokeKey( self, I64 slot ) -> Boolean:

        """ Revoke the key at the given slot. Returns True on success. """

        return self.store.revoke( slot )

    public function destroyKey( self, I64 slot ) -> Boolean:

        """ Permanently destroy the key at the given slot. Returns True on success. """

        return self.store.destroyKey( slot )

    public function isOwner( self, I64 slot, I64 ownerId ) -> Boolean:

        """ Check whether ownerId is the owner of the key at slot. """

        return self.store.isOwner( slot, ownerId )

    public function getKeyType( self, I64 slot ) -> I64:

        """ Return the type of the key at the given slot. """

        return self.store.getKeyType( slot )

    public function getKeyState( self, I64 slot ) -> I64:

        """ Return the lifecycle state of the key at the given slot. """

        return self.store.getKeyState( slot )

    public function getCount( self ) -> I64:

        """ Return the number of keys currently stored. """

        return self.store.getCount()

    public function destroy( self ) -> Void:

        """
        Release all resources held by the key store.
        
        Complexity:
            Time: O(1)
            Space: O(1)
        """

        self.store.destroy()

export {
    KeyState,
    KeyStore,
    KeyType,
    SecureKeyStore
}
