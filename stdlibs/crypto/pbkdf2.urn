package uranite.crypto.pbkdf2

from uranite.crypto.hmac import hmacSha256, hmacSha512
from uranite.crypto.sha256 import SHA256_DIGEST_SIZE
from uranite.crypto.sha512 import SHA512_DIGEST_SIZE
from uranite.encoding.binary import writeI32Be
from uranite.functions.builtin import ptrToString
from uranite.io.syscall import readByteAt, stringLen, stringToPtr, writeByteAt
from uranite.memory.allocator import alloc, dealloc

public function pbkdf2HmacSha256( I64 passwordAddress, I64 passwordLength, I64 saltAddress, I64 saltLength, I64 iterations, I64 outputAddress, I64 outputLength ) -> Void:

    """
    Derive a key from a password using PBKDF2 with HMAC-SHA-256 as the
    pseudorandom function per RFC 2898 section 5.2.

    For each block of derived key material, computes:
      U1 = HMAC(password, salt || INT(blockIndex))
      U2 = HMAC(password, U1)
      ...
      Ui = HMAC(password, U_{i-1})
      DK_block = U1 ^ U2 ^ ... ^ Ui

    Parameters:
        passwordAddress (I64):
            Base address of the password bytes.
        passwordLength (I64):
            Length of the password in bytes.
        saltAddress (I64):
            Base address of the salt bytes.
        saltLength (I64):
            Length of the salt in bytes.
        iterations (I64):
            Number of HMAC iterations (SCRAM typically uses 4096+).
        outputAddress (I64):
            Address to write the derived key.
        outputLength (I64):
            Desired length of the derived key in bytes.

    Complexity:
        Time: O(iterations * ceil(outputLength / 32))
        Space: O(1) (fixed overhead for intermediate buffers)
    """

    I64 saltPlusBlockAddress = alloc( saltLength + 4 )
    I64 copySaltIndex = 0
    while copySaltIndex < saltLength:
        I64 saltByte = readByteAt( saltAddress, copySaltIndex )
        writeByteAt( saltPlusBlockAddress, copySaltIndex, saltByte )
        copySaltIndex = copySaltIndex + 1

    I64 currentUAddress = alloc( SHA256_DIGEST_SIZE )
    I64 xorAccumulatorAddress = alloc( SHA256_DIGEST_SIZE )
    I64 outputBytesWritten = 0
    I64 blockIndex = 1

    while outputBytesWritten < outputLength:
        writeI32Be( saltPlusBlockAddress, saltLength, blockIndex )
        hmacSha256( passwordAddress, passwordLength, saltPlusBlockAddress, saltLength + 4, currentUAddress )
        I64 initIndex = 0
        while initIndex < SHA256_DIGEST_SIZE:
            writeByteAt( xorAccumulatorAddress, initIndex, readByteAt( currentUAddress, initIndex ) )
            initIndex = initIndex + 1
        I64 iterationIndex = 1
        while iterationIndex < iterations:
            I64 previousUAddress = alloc( SHA256_DIGEST_SIZE )
            I64 copyUIndex = 0
            while copyUIndex < SHA256_DIGEST_SIZE:
                writeByteAt( previousUAddress, copyUIndex, readByteAt( currentUAddress, copyUIndex ) )
                copyUIndex = copyUIndex + 1
            hmacSha256( passwordAddress, passwordLength, previousUAddress, SHA256_DIGEST_SIZE, currentUAddress )
            dealloc( previousUAddress )
            I64 xorIndex = 0
            while xorIndex < SHA256_DIGEST_SIZE:
                I64 accByte = readByteAt( xorAccumulatorAddress, xorIndex )
                I64 uByte = readByteAt( currentUAddress, xorIndex )
                writeByteAt( xorAccumulatorAddress, xorIndex, ( accByte ^ uByte ) & 255 )
                xorIndex = xorIndex + 1
            iterationIndex = iterationIndex + 1
        I64 bytesToCopy = outputLength - outputBytesWritten
        if bytesToCopy > SHA256_DIGEST_SIZE:
            bytesToCopy = SHA256_DIGEST_SIZE
        I64 outputCopyIndex = 0
        while outputCopyIndex < bytesToCopy:
            writeByteAt( outputAddress, outputBytesWritten + outputCopyIndex, readByteAt( xorAccumulatorAddress, outputCopyIndex ) )
            outputCopyIndex = outputCopyIndex + 1
        outputBytesWritten = outputBytesWritten + bytesToCopy
        blockIndex = blockIndex + 1

    dealloc( saltPlusBlockAddress )
    dealloc( currentUAddress )
    dealloc( xorAccumulatorAddress )

public function pbkdf2HmacSha512( I64 passwordAddress, I64 passwordLength, I64 saltAddress, I64 saltLength, I64 iterations, I64 outputAddress, I64 outputLength ) -> Void:

    """
    Derive a key from a password using PBKDF2 with HMAC-SHA-512.
    Same algorithm as pbkdf2HmacSha256 but using SHA-512.

    Parameters:
        passwordAddress (I64):
            Base address of the password bytes.
        passwordLength (I64):
            Length of the password in bytes.
        saltAddress (I64):
            Base address of the salt bytes.
        saltLength (I64):
            Length of the salt in bytes.
        iterations (I64):
            Number of HMAC iterations.
        outputAddress (I64):
            Address to write the derived key.
        outputLength (I64):
            Desired length of the derived key in bytes.

    Complexity:
        Time: O(iterations * ceil(outputLength / 64))
        Space: O(1)
    """

    I64 saltPlusBlockAddress = alloc( saltLength + 4 )
    I64 copySaltIndex = 0
    while copySaltIndex < saltLength:
        I64 saltByte = readByteAt( saltAddress, copySaltIndex )
        writeByteAt( saltPlusBlockAddress, copySaltIndex, saltByte )
        copySaltIndex = copySaltIndex + 1

    I64 currentUAddress = alloc( SHA512_DIGEST_SIZE )
    I64 xorAccumulatorAddress = alloc( SHA512_DIGEST_SIZE )
    I64 outputBytesWritten = 0
    I64 blockIndex = 1

    while outputBytesWritten < outputLength:
        writeI32Be( saltPlusBlockAddress, saltLength, blockIndex )
        hmacSha512( passwordAddress, passwordLength, saltPlusBlockAddress, saltLength + 4, currentUAddress )
        I64 initIndex = 0
        while initIndex < SHA512_DIGEST_SIZE:
            writeByteAt( xorAccumulatorAddress, initIndex, readByteAt( currentUAddress, initIndex ) )
            initIndex = initIndex + 1
        I64 iterationIndex = 1
        while iterationIndex < iterations:
            I64 previousUAddress = alloc( SHA512_DIGEST_SIZE )
            I64 copyUIndex = 0
            while copyUIndex < SHA512_DIGEST_SIZE:
                writeByteAt( previousUAddress, copyUIndex, readByteAt( currentUAddress, copyUIndex ) )
                copyUIndex = copyUIndex + 1
            hmacSha512( passwordAddress, passwordLength, previousUAddress, SHA512_DIGEST_SIZE, currentUAddress )
            dealloc( previousUAddress )
            I64 xorIndex = 0
            while xorIndex < SHA512_DIGEST_SIZE:
                I64 accByte = readByteAt( xorAccumulatorAddress, xorIndex )
                I64 uByte = readByteAt( currentUAddress, xorIndex )
                writeByteAt( xorAccumulatorAddress, xorIndex, ( accByte ^ uByte ) & 255 )
                xorIndex = xorIndex + 1
            iterationIndex = iterationIndex + 1
        I64 bytesToCopy = outputLength - outputBytesWritten
        if bytesToCopy > SHA512_DIGEST_SIZE:
            bytesToCopy = SHA512_DIGEST_SIZE
        I64 outputCopyIndex = 0
        while outputCopyIndex < bytesToCopy:
            writeByteAt( outputAddress, outputBytesWritten + outputCopyIndex, readByteAt( xorAccumulatorAddress, outputCopyIndex ) )
            outputCopyIndex = outputCopyIndex + 1
        outputBytesWritten = outputBytesWritten + bytesToCopy
        blockIndex = blockIndex + 1

    dealloc( saltPlusBlockAddress )
    dealloc( currentUAddress )
    dealloc( xorAccumulatorAddress )

function bytesToHex( I64 dataAddress, I64 dataLength ) -> String:

    """
    Convert raw bytes to a lowercase hexadecimal string.

    Parameters:
        dataAddress (I64):
            Address of the byte data.
        dataLength (I64):
            Number of bytes.

    Returns:
        String:
            Hex-encoded string (2 characters per byte).

    Complexity:
        Time: O(n) where n is dataLength
        Space: O(2n)
    """

    I64 hexLength = dataLength * 2
    I64 hexBuffer = alloc( hexLength + 1 )
    I64 byteIndex = 0
    while byteIndex < dataLength:
        I64 byteValue = readByteAt( dataAddress, byteIndex )
        if byteValue < 0:
            byteValue = byteValue + 256
        I64 highNibble = byteValue / 16
        I64 lowNibble = byteValue % 16
        I64 hexOffset = byteIndex * 2
        if highNibble < 10:
            writeByteAt( hexBuffer, hexOffset, 48 + highNibble )
        else:
            writeByteAt( hexBuffer, hexOffset, 87 + highNibble )
        if lowNibble < 10:
            writeByteAt( hexBuffer, hexOffset + 1, 48 + lowNibble )
        else:
            writeByteAt( hexBuffer, hexOffset + 1, 87 + lowNibble )
        byteIndex = byteIndex + 1
    writeByteAt( hexBuffer, hexLength, 0 )
    return ptrToString( hexBuffer )

public function pbkdf2Sha256Derive( String password, String salt, I64 iterations, I64 outputLength ) -> String:

    """
    Derive a key from a password using PBKDF2-HMAC-SHA-256 and return
    the result as a lowercase hexadecimal string.

    Parameters:
        password (String):
            The password to derive from.
        salt (String):
            The salt value.
        iterations (I64):
            Number of HMAC iterations (typically 4096+).
        outputLength (I64):
            Desired derived key length in bytes.

    Returns:
        String:
            The derived key as a hex string (2 * outputLength characters).

    Complexity:
        Time: O(iterations * ceil(outputLength / 32))
        Space: O(outputLength)
    """

    I64 passwordAddress = stringToPtr( password )
    I64 passwordLength = stringLen( password )
    I64 saltAddress = stringToPtr( salt )
    I64 saltLength = stringLen( salt )
    I64 outputAddress = alloc( outputLength )
    pbkdf2HmacSha256( passwordAddress, passwordLength, saltAddress, saltLength, iterations, outputAddress, outputLength )
    String result = bytesToHex( outputAddress, outputLength )
    dealloc( outputAddress )
    return result

public function pbkdf2Sha512Derive( String password, String salt, I64 iterations, I64 outputLength ) -> String:

    """
    Derive a key from a password using PBKDF2-HMAC-SHA-512 and return
    the result as a lowercase hexadecimal string.

    Parameters:
        password (String):
            The password to derive from.
        salt (String):
            The salt value.
        iterations (I64):
            Number of HMAC iterations.
        outputLength (I64):
            Desired derived key length in bytes.

    Returns:
        String:
            The derived key as a hex string (2 * outputLength characters).

    Complexity:
        Time: O(iterations * ceil(outputLength / 64))
        Space: O(outputLength)
    """

    I64 passwordAddress = stringToPtr( password )
    I64 passwordLength = stringLen( password )
    I64 saltAddress = stringToPtr( salt )
    I64 saltLength = stringLen( salt )
    I64 outputAddress = alloc( outputLength )
    pbkdf2HmacSha512( passwordAddress, passwordLength, saltAddress, saltLength, iterations, outputAddress, outputLength )
    String result = bytesToHex( outputAddress, outputLength )
    dealloc( outputAddress )
    return result

export {
    pbkdf2HmacSha256,
    pbkdf2HmacSha512,
    pbkdf2Sha256Derive,
    pbkdf2Sha512Derive
}
