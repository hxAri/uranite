package uranite.examples.benchmarks.spectral-norm

from uranite.functions.externs import clock, sqrt
from uranite.io.console import puts, putsln
from uranite.language.double import Double
from uranite.language.int import Int
from uranite.memory.memory import Memory

function evaluateMatrixA( Int i, Int j ) -> Double:
    Int sum = i + j
    return 1.0 / ( sum * ( sum + 1 ) / 2 + i + 1 )

function multiplyAv( Int n, Memory<Double> v, Memory<Double> resultAv ) -> Void:
    for Int i = 0; i < n; i++:
        Double sum = 0.0
        for Int j = 0; j < n; j++:
            sum+= evaluateMatrixA( i, j ) * v.get( j )
        resultAv.set( i, sum )

function multiplyAtv( Int n, Memory<Double> v, Memory<Double> resultAtv ) -> Void:
    for Int i = 0; i < n; i++:
        Double sum = 0.0
        for Int j = 0; j < n; j++:
            sum+= evaluateMatrixA( j, i ) * v.get( j )
        resultAtv.set( i, sum )

function multiplyAtAv( Int n, Memory<Double> v, Memory<Double> resultAtAv, Memory<Double> tmpBuffer ) -> Void:
    multiplyAv( n, v, tmpBuffer )
    multiplyAtv( n, tmpBuffer, resultAtAv )

function initializeVectors( Int n, Memory<Double> u, Memory<Double> v ) -> Void:
    for Int i = 0; i < n; i++:
        u.set( i, 1.0 )
        v.set( i, 0.0 )

function runPowerIterations( Int n, Memory<Double> u, Memory<Double> v, Memory<Double> tmpBuffer ) -> Void:
    for Int iter = 0; iter < 10; iter++:
        multiplyAtAv( n, u, v, tmpBuffer )
        multiplyAtAv( n, v, u, tmpBuffer )

function calculateEigenvalue( Int n, Memory<Double> u, Memory<Double> v ) -> Double:
    Double vBv = 0.0
    Double vv = 0.0
    for Int i = 0; i < n; i++:
        Double ui = u.get( i )
        Double vi = v.get( i )
        vBv+= ui * vi
        vv+= vi * vi
    return sqrt( vBv / vv )

public function main() -> I32:
    Int n = 5500
    putsln( "Starting Advanced Spectral Norm Benchmark (n=", n, ")" )
    Memory<Double> u = new Memory<Double>( n )
    Memory<Double> v = new Memory<Double>( n )
    Memory<Double> tmpBuffer = new Memory<Double>( n )
    I64 startTotal = clock()
    I64 startInit = clock()
    initializeVectors( n, u, v )
    I64 endInit = clock()
    Double elapsedInit = ( endInit - startInit ) / 1000000.0
    putsln( "- Initialization elapsed: ", elapsedInit, " seconds" )
    I64 startIters = clock()
    runPowerIterations( n, u, v, tmpBuffer )
    I64 endIters = clock()
    Double elapsedIters = ( endIters - startIters ) / 1000000.0
    putsln( "- Power Iterations elapsed: ", elapsedIters, " seconds" )
    I64 startEval = clock()
    Double result = calculateEigenvalue( n, u, v )
    I64 endEval = clock()
    Double elapsedEval = ( endEval - startEval ) / 1000000.0
    putsln( "- Eigenvalue Evaluation elapsed: ", elapsedEval, " seconds" )
    I64 endTotal = clock()
    Double elapsedTotal = ( endTotal - startTotal ) / 1000000.0
    putsln( "Final Result: ", result )
    putsln( "Total Elapsed time: ", elapsedTotal, " seconds" )
    u.free()
    v.free()
    tmpBuffer.free()
    putsln( "Advanced spectral norm test PASSED" )
    return 0
