package uranite.examples.benchmarks.colorize

from uranite.io.console import puts
from uranite.adelia import Adelia, ColorConverter

public function main() -> Void:
	Adelia adelia = new Adelia( 0xf8f8ff )
	ColorConverter converter = new ColorConverter
	puts( converter.toString() ) # Bugs in `toString()`
	puts( adelia )
