package uranite.examples.benchmarks.mandelbrot

from uranite.functions.externs import clock
from uranite.io.console import puts
from uranite.language.double import Double
from uranite.language.int import Int
from uranite.language.u8 import U8
from uranite.memory.memory import Memory

function computeMandelbrot( Int n, Memory<U8> bitmap, Int bytesPerRow ) -> Void:
    for Int y = 0; y < n; y++:
        Double civ = ( y * 2.0 / n ) - 1.0
        for Int xByte = 0; xByte < bytesPerRow; xByte++:
            U8 res = 0
            for Int bit = 0; bit < 8; bit++:
                Int x = xByte * 8 + bit
                Double crv = ( x * 2.0 / n ) - 1.5
                Double zrv = 0.0
                Double ziv = 0.0
                Double trv = 0.0
                Double tiv = 0.0
                Int i = 0
                while i < 50 and ( trv + tiv <= 4.0 ):
                    ziv = ( zrv * ziv ) + ( zrv * ziv ) + civ
                    zrv = trv - tiv + crv
                    trv = zrv * zrv
                    tiv = ziv * ziv
                    i++
                res = res << 1
                if trv + tiv <= 4.0:
                    res = res | 1
            bitmap.set( y * bytesPerRow + xByte, res )

public function main() -> I32:
    Int n = 3200000000
    puts( "Uranite Extreme Mandelbrot Benchmark (P4 {}:{})".format( n, n ) )
    I64 totalStart = clock()
    Int bytesPerRow = n / 8
    Memory<U8> bitmap = new Memory<U8>( n * bytesPerRow )
    puts( "-   initializing mandelbrot computation" )
    I64 compStart = clock()
    computeMandelbrot( n, bitmap, bytesPerRow )
    I64 compEnd = clock()
    Double compElapsed = ( compEnd - compStart ) / 1000000.0
    puts( "    computation routine elapsed time: {} seconds".format( compElapsed ) )
    I64 totalEnd = clock()
    Double totalElapsed = ( totalEnd - totalStart ) / 1000000.0
    puts( "-   bits calculated: {}".format( ( n as I64 ) * ( n as I64 ) ) )
    puts( "elapsed time: {} seconds".format( totalElapsed ) )
    bitmap.free()
    return 0
