package main

from uranite.io.console import puts
from uranite.memory.memory import Memory
from uranite.language.int import Int
from uranite.language.double import Double
from uranite.language.u8 import U8
from uranite.language.string import String

extern function clock() -> I64;
extern function fwrite( Memory<U8> ptr, Int size, Int nmemb, Int stream ) -> Int;

class Fasta:
    private Int last = 42
    private Int IM = 139968
    private Int IA = 3877
    private Int IC = 29573
    
    public function nextRandom( self, Double max ) -> Double:
        self.last = ( self.last * self.IA + self.IC ) % self.IM
        return max * self.last / self.IM
    
    public function makeCumulative( self, Memory<Double> probs, Int count ) -> Void:
        Double cp = 0.0
        for Int i = 0; i < count; i++:
            cp = cp + probs.get( i )
            probs.set( i, cp )
    
    public function selectSymbol( self, Memory<Double> probs, Memory<U8> symbols, Int count ) -> U8:
        Double r = self.nextRandom( 1.0 )
        for Int i = 0; i < count; i++:
            if r < probs.get( i ):
                return symbols.get( i )
        return symbols.get( count - 1 )

public function main() -> I32:
    Int n = 25000000
    puts( "=== Uranite Extreme Fasta Benchmark (n=", n, ") ===" )
    
    I64 start = clock()
    
    Fasta f = new Fasta()
    
    # IUB probabilities
    Memory<U8> iubSymbols = new Memory<U8>( 15 )
    Memory<Double> iubProbs = new Memory<Double>( 15 )
    # Fill with standard IUB data...
    
    # Homo sapiens probabilities
    Memory<U8> homoSymbols = new Memory<U8>( 4 )
    Memory<Double> homoProbs = new Memory<Double>( 4 )
    homoSymbols.set( 0, 'a' as U8 )
    homoProbs.set( 0, 0.3029549426680 )
    homoSymbols.set( 1, 'c' as U8 )
    homoProbs.set( 1, 0.1979883004921 )
    homoSymbols.set( 2, 'g' as U8 )
    homoProbs.set( 2, 0.1975473066391 )
    homoSymbols.set( 3, 't' as U8 )
    homoProbs.set( 3, 0.3015094502008 )
    
    f.makeCumulative( homoProbs, 4 )
    
    Int LINE_LENGTH = 60
    Memory<U8> buffer = new Memory<U8>( LINE_LENGTH + 1 )
    
    # Simulate generating n characters
    Int generated = 0
    while generated < n:
        Int toGenerate = LINE_LENGTH
        if n - generated < LINE_LENGTH:
            toGenerate = n - generated
            
        for Int i = 0; i < toGenerate; i++:
            buffer.set( i, f.selectSymbol( homoProbs, homoSymbols, 4 ) )
        
        buffer.set( toGenerate, '\n' as U8 )
        # fwrite(buffer, 1, toGenerate + 1, 1) # stdout
        generated = generated + toGenerate
        
    I64 end = clock()
    Double elapsed = ( end - start ) / 1000000.0
    
    puts( "Generated ", n, " base pairs" )
    puts( "Elapsed time: ", elapsed, " seconds" )
    
    homoSymbols.free()
    homoProbs.free()
    buffer.free()
    
    return 0
