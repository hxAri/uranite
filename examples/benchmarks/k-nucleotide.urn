package uranite.examples.benchmarks.k-nucleotide

from uranite.collection.hash-map import HashMap
from uranite.functions.externs import clock
from uranite.io.console import puts
from uranite.language.int import Int
from uranite.language.string import String
from uranite.memory.memory import Memory

public function countSequences( String sequence, Int length ) -> HashMap<String, Int>:
    HashMap<String, Int> counts = new HashMap<String, Int>()
    Int n = sequence.length() - length + 1
    for Int i = 0; i < n; i++:
        String sub = sequence.substring( i, i + length )
        Int current = counts.getOrDefault( sub, 0 )
        counts.put( sub, current + 1 )
    return counts

public function main() -> I32:
    String base = "GGTATTTTAATTTATATTTATATTTTTTTAG"
    String sequence = ""
    for Int i = 0; i < 25000; i++:
        sequence = sequence + base
    puts( "Uranite Extreme K-nucleotide Benchmark (seq length {})".format( sequence.length() ) )
    puts( "-   initializing k-nucleotide" )
    I64 totalStart = clock()
    puts( "-   nucleotide sequence counting" )
    I64 start1 = clock()
    HashMap<String, Int> counts1 = countSequences( sequence, 1 )
    I64 end1 = clock()
    Double elapsed1 = ( end1 - start1 ) / 1000000.0
    puts( "    nucleotide sequence counting elapsed time: {} seconds".format( elapsed1 ) )
    puts( "    nucleotide counts: {} unique".format( counts1.length ) )
    puts( "-   nucleotide sequence counting" )
    I64 start2 = clock()
    HashMap<String, Int> counts2 = countSequences( sequence, 2 )
    I64 end2 = clock()
    Double elapsed2 = ( end2 - start2 ) / 1000000.0
    puts( "    nucleotide sequence counting elapsed time: {} seconds".format( elapsed2 ) )
    puts( "    nucleotide counts: {} unique".format( counts2.length ) )
    puts( "-   nucleotide sequence counting" )
    I64 start3 = clock()
    HashMap<String, Int> counts3 = countSequences( sequence, 3 )
    I64 end3 = clock()
    Double elapsed3 = ( end3 - start3 ) / 1000000.0
    puts( "    nucleotide sequence counting elapsed time: {} seconds".format( elapsed3 ) )
    puts( "    nucleotide counts: {} unique".format( counts3.length ) )
    puts( "-   nucleotide sequence counting" )
    I64 start4 = clock()
    HashMap<String, Int> counts4 = countSequences( sequence, 4 )
    I64 end4 = clock()
    Double elapsed4 = ( end4 - start4 ) / 1000000.0
    puts( "    nucleotide sequence counting elapsed time: {} seconds".format( elapsed4 ) )
    puts( "    nucleotide counts: {} unique".format( counts4.length ) )
    puts( "-   nucleotide sequence counting" )
    I64 start5 = clock()
    HashMap<String, Int> counts5 = countSequences( sequence, 6 )
    I64 end5 = clock()
    Double elapsed5 = ( end5 - start5 ) / 1000000.0
    puts( "    nucleotide sequence counting elapsed time: {} seconds".format( elapsed5 ) )
    puts( "    nucleotide counts: {} unique".format( counts5.length ) )
    puts( "-   nucleotide sequence counting" )
    I64 start6 = clock()
    HashMap<String, Int> counts6 = countSequences( sequence, 6 )
    I64 end6 = clock()
    Double elapsed6 = ( end6 - start6 ) / 1000000.0
    puts( "    nucleotide sequence counting elapsed time: {} seconds".format( elapsed6 ) )
    puts( "    nucleotide counts: {} unique".format( counts6.length ) )
    I64 totalEnd = clock()
    Double totalElapsed = ( totalEnd - totalStart ) / 1000000.0
    puts( "elapsed time: {} seconds".format( totalElapsed ) )
    return 0
