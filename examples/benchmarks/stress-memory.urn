package uranite.examples.benchmarks.stress-memory

from uranite.convert.convert import intToString
from uranite.functions.externs import clock
from uranite.io.console import putsln
from uranite.memory.allocator import alloc, dealloc
from uranite.os.arch.native.memory import readByteAt, writeByteAt

function runRapidCycles() -> I32:
    I64 i = 0
    while i < 250000:
        I64 size = ( i % 1024 ) + 16
        I64 ptr = alloc( size )
        writeByteAt( ptr, 0, 170 )
        writeByteAt( ptr, size / 2, 85 )
        writeByteAt( ptr, size - 1, 255 )
        I64 v1 = readByteAt( ptr, size / 2 )
        dealloc( ptr )
        i = i + 1
    return 0

function runFragmentationPattern() -> I32:
    I64 i = 0
    while i < 5000:
        I64 chunkA = alloc( 128 )
        I64 chunkB = alloc( 256 )
        I64 chunkC = alloc( 512 )
        writeByteAt( chunkA, 127, 1 )
        writeByteAt( chunkB, 255, 2 )
        writeByteAt( chunkC, 511, 3 )
        dealloc( chunkB )
        I64 chunkD = alloc( 1024 )
        I64 chunkE = alloc( 64 )
        writeByteAt( chunkD, 0, 4 )
        writeByteAt( chunkE, 0, 5 )
        dealloc( chunkA )
        dealloc( chunkD )
        dealloc( chunkC )
        dealloc( chunkE )
        i = i + 1
    return 0

function runDeepNesting() -> I32:
    I64 outer = 0
    while outer < 1000:
        I64 p1 = alloc( 2048 )
        writeByteAt( p1, 0, 10 )
        I64 mid = 0
        while mid < 25:
            I64 p2 = alloc( 128 )
            writeByteAt( p2, 0, 20 )
            I64 inner = 0
            while inner < 15:
                I64 p3 = alloc( 32 )
                writeByteAt( p3, 31, 30 )
                dealloc( p3 )
                inner = inner + 1
            dealloc( p2 )
            mid = mid + 1
        dealloc( p1 )
        outer = outer + 1
    return 0

public function main() -> I32:
    putsln( "Starting Advanced Memory Stress Benchmark..." )
    I64 startTotal = clock()
    I64 startRapid = clock()
    runRapidCycles()
    I64 endRapid = clock()
    Double elapsedRapid = ( endRapid - startRapid ) / 1000000.0
    putsln( "- Rapid Cycles elapsed: ", elapsedRapid, " seconds" )
    I64 startFrag = clock()
    runFragmentationPattern()
    I64 endFrag = clock()
    Double elapsedFrag = ( endFrag - startFrag ) / 1000000.0
    putsln( "- Fragmentation elapsed: ", elapsedFrag, " seconds" )
    I64 startNest = clock()
    runDeepNesting()
    I64 endNest = clock()
    Double elapsedNest = ( endNest - startNest ) / 1000000.0
    putsln( "- Deep Nesting elapsed: ", elapsedNest, " seconds" )
    I64 endTotal = clock()
    Double elapsedTotal = ( endTotal - startTotal ) / 1000000.0
    putsln( "Total Elapsed time: ", elapsedTotal, " seconds" )
    putsln( "Advanced stress memory test PASSED" )
    return 0
