package uranite.examples.benchmarks.stress-exceptions

from uranite.convert.convert import intToString
from uranite.errors.error import Error
from uranite.functions.externs import clock
from uranite.io.console import putsln

public class TestError extends Error:
    
    public function TestError( self, String message, I64 code, ?Error cause ) -> Void:
        parent( message, code, cause )

public class NestedError extends Error:
    
    public function NestedError( self, String message, I64 code, ?Error cause ) -> Void:
        parent( message, code, cause )

function throwAtDepth( I64 depth ) -> I64:
    if depth <= 0:
        raise new TestError( "depth reached zero", 0, None )
    return throwAtDepth( depth - 1 )

function throwNestedAtDepth( I64 depth ) -> I64:
    if depth <= 0:
        raise new NestedError( "nested depth reached zero", 1, None )
    return throwNestedAtDepth( depth - 1 )

function runDeepCallStacks() -> I64:
    I64 caught = 0
    I64 i = 0
    while i < 5000:
        try:
            I64 result = throwAtDepth( 50 )
        except TestError as e:
            caught = caught + 1
        i = i + 1
    return caught

function runNestedExceptions() -> I64:
    I64 caught = 0
    I64 i = 0
    while i < 2000:
        try:
            try:
                I64 result = throwNestedAtDepth( 25 )
            except TestError as te:
                caught = caught + 1
        except NestedError as ne:
            caught = caught + 1
        i = i + 1
    return caught

function runVariableDepth() -> I64:
    I64 caught = 0
    I64 i = 1
    while i <= 5000:
        I64 currentDepth = ( i % 30 ) + 1
        try:
            I64 result = throwAtDepth( currentDepth )
        except TestError as e:
            caught = caught + 1
        i = i + 1
    return caught

public function main() -> I32:
    putsln( "Starting Advanced Exceptions Stress Benchmark..." )
    I64 startTotal = clock()
    I64 startDeep = clock()
    I64 caughtDeep = runDeepCallStacks()
    I64 endDeep = clock()
    Double elapsedDeep = ( endDeep - startDeep ) / 1000000.0
    String caughtDeepStr = intToString( caughtDeep )
    putsln( "- Deep Call Stacks caught: " + caughtDeepStr + " in ", elapsedDeep, " seconds" )
    I64 startNested = clock()
    I64 caughtNested = runNestedExceptions()
    I64 endNested = clock()
    Double elapsedNested = ( endNested - startNested ) / 1000000.0
    String caughtNestedStr = intToString( caughtNested )
    putsln( "- Nested Exceptions caught: " + caughtNestedStr + " in ", elapsedNested, " seconds" )
    I64 startVar = clock()
    I64 caughtVar = runVariableDepth()
    I64 endVar = clock()
    Double elapsedVar = ( endVar - startVar ) / 1000000.0
    String caughtVarStr = intToString( caughtVar )
    putsln( "- Variable Depth caught: " + caughtVarStr + " in ", elapsedVar, " seconds" )
    I64 endTotal = clock()
    Double elapsedTotal = ( endTotal - startTotal ) / 1000000.0
    putsln( "Total Elapsed time: ", elapsedTotal, " seconds" )
    putsln( "Advanced stress exceptions test PASSED" )
    return 0
