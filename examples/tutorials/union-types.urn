package main

from uranite.io.console import puts


function acceptUnion( I64 | String value ) -> Void:
    
    """
    Accepts a union of I64 and String.
    
    Parameters:
        value: The union value to receive.
    
    Returns:
        Void
    """
    
    puts( "Union value received" )

function acceptNumber( I64 | F64 number ) -> Void:
    
    """
    Accepts a union of I64 and F64.
    
    Parameters:
        number: The union number to receive.
    
    Returns:
        Void
    """
    
    puts( "Number received" )

public function main() -> I32:
    
    """
    The main entry point for the union type test.
    
    Returns:
        I32 exit code.
    """
    
    puts( "=== Union type parameters ===" )

    acceptUnion( 42 )
    acceptUnion( "hello" )

    acceptNumber( 100 )
    acceptNumber( 3.14 )

    puts( "All union calls succeeded" )
    return 0
