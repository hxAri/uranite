package uranite.examples.tutorials.testing

from uranite.collection import Pair
from uranite.functions.builtin import enumerate
from uranite.io import getpass, input, puts
from uranite.io.stream import Stream

private function writer( I64 targetFileDescriptor, String args[], ?String separator=" ", ?String endline="\n", ?Stream stream=None, Boolean flush=False ) -> Void:
    for Int i, String argument in enumerate<I64>( args, start=1 ):
    # for Pair<Int,I64> pair in enumerate<I64>( args, start=1 ):
        puts( "writter [{}] {}".format( i, argument ) )

private function called( String args[], ?String separator=" ", ?String endline="\n", ?Stream stream=None, Boolean flush=False ) -> Void:
    for Int i, String argument in enumerate<I64>( args, start=1 ):
    # for Pair<Int,I64> pair in enumerate<I64>( args, start=1 ):
        puts( "called [{}] {}".format( i, argument ) )
    writer( 0, args=args, separator=separator, endline=endline, stream=stream, flush=flush )

public function main( I64 argc, ArrayList<String> argv ) -> Void:
    called( "AJG!" )
    called( "X", "Y", "Z" )
    for Int i, String argument in enumerate<String>( argv, 1 ):
        puts( "argument [{}] {}".format( i, argument ) )
