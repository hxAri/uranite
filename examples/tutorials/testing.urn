package uranite.examples.tutorials.testing

from uranite.collection import {
    ArrayList, 
    Generator, 
    HashMap, 
    HashSet, 
    MutableSequence, 
    Map, 
    Pair, 
    Set, 
    Tuple
}
from uranite.errors.exception import Exception
from uranite.functions.externs import clock
from uranite.iterators import Iterable
from uranite.io import puts
from uranite.language.double import Double

enum ResonancePhase backed F64:
    
    unit Quiescent    0.5:
        public override property expand( self ) -> F64:
            return ( self.value * 2 ) + 4
    
    unit Oscillating  1.2
    unit Cascading    2.5
    unit Divergent    0.0
    
    public property expand( self ) -> F64:
        return self.value * 2

enum CardinalDirection backed String:
    unit North  "N"
    unit South  "S"
    unit East   "E"
    unit West   "W"

interface Transmittable:
    
    public function evaluateResonance( self ) -> F64;

interface Displayable:
    
    public function displayInformation( self ) -> Void;

trait SpatialAnalyzer:
    
    public function computeSpatialHash( self ) -> I64:
        puts( "Executing SpatialAnalyzer trait computation" )
        return 1024

abstract class BaseEntity:
    
    public String designation
    
    public function BaseEntity( self, String desig ) -> Void:
        self.designation = desig
        
    public abstract function getEntitySignature( self ) -> String;

class QuantumVertex extends BaseEntity implements Transmittable:
    
    public F64 baselineFrequency
    
    public function QuantumVertex( self, String desig, F64 frequency ) -> Void:
        parent( desig )
        self.baselineFrequency = frequency
    
    public override function getEntitySignature( self ) -> String:
        return self.designation
    
    public function evaluateResonance( self ) -> F64:
        return self.baselineFrequency * ResonancePhase.Oscillating.value

abstract class GeometricShape:
    
    public String shapeKind
    
    public function GeometricShape( self, String kind ) -> Void:
        self.shapeKind = kind
    
    public abstract function calculateArea( self ) -> I64;

class PerfectSquare extends GeometricShape implements Displayable:
    
    public I64 sideLength
    
    public function PerfectSquare( self, I64 side ) -> Void:
        parent( "PerfectSquare" )
        self.sideLength = side
    
    public override function calculateArea( self ) -> I64:
        return self.sideLength * self.sideLength
    
    public function displayInformation( self ) -> Void:
        puts( "Displayable: ", self.shapeKind, " with area ", self.calculateArea() )

class PerfectCircle extends GeometricShape implements Displayable:
    
    public I64 radius
    
    public function PerfectCircle( self, I64 r ) -> Void:
        parent( "PerfectCircle" )
        self.radius = r
        
    public override function calculateArea( self ) -> I64:
        return self.radius * self.radius * 3
        
    public function displayInformation( self ) -> Void:
        puts( "Displayable: ", self.shapeKind, " with area ", self.calculateArea() )

struct Vector2D:
    
    public F64 xAxis
    public F64 yAxis
    
    public function Vector2D( self, F64 x, F64 y ) -> Void:
        self.xAxis = x
        self.yAxis = y
    
    public function computeSquaredLength( self ) -> F64:
        return self.xAxis * self.xAxis + self.yAxis * self.yAxis

Readonly class SystemConfiguration:
    
    public I64 operationalPort
    public String hostAddress
    
    public function SystemConfiguration( self, I64 port, String host ) -> Void:
        self.operationalPort = port
        self.hostAddress = host

class GenericContainer<T>:
    
    public T payloadValue
    
    public function GenericContainer( self, T val ) -> Void:
        self.payloadValue = val
    
    public function retrieve( self ) -> T:
        return self.payloadValue

class SpatialTreeNode:
    
    use SpatialAnalyzer
    
    public GenericContainer<GeometricShape> nodeData
    public ?SpatialTreeNode leftBranch
    public ?SpatialTreeNode rightBranch
    
    public function SpatialTreeNode( self, GeometricShape shapeData ) -> Void:
        self.nodeData = new GenericContainer<GeometricShape>( shapeData )
        self.leftBranch = None
        self.rightBranch = None

class DimensionalCollapseException extends Exception:
    public function DimensionalCollapseException( self, String message, I64 code, ?Exception cause ) -> Void:
        parent( message, code, cause )

private function computeRecursiveFactorial( I64 number ) -> I64:
    if number <= 1:
        return 1
    return number * computeRecursiveFactorial( number - 1 )

private function computeRecursiveFibonacci( I64 position ) -> I64:
    if position <= 0:
        return 0
    if position == 1:
        return 1
    return computeRecursiveFibonacci( position - 1 ) + computeRecursiveFibonacci( position - 2 )

private function enumerate<E>( Iterable<E> elements, Int start=0 ) -> Generator<Pair<Int,E>>:
    Int position = start
    for E element in elements:
        puts( "Loop enumerate: yielding position ", position )
        yield new Pair<>( position++, element )

private function initializeDataWarehouse() -> Map<String, MutableSequence<String>>:
    Map<String,MutableSequence<String>> graph = {
        "Alpha": [
            "Beta",
            "Gamma",
            "Delta"
        ],
        "Beta": [
            "Epsilon",
            "Zeta"
        ],
        "Gamma": [
            "Zeta",
            "Eta"
        ],
        "Delta": [
            "Eta",
            "Theta"
        ],
        "Epsilon": [
            "Iota"
        ],
        "Zeta": [
            "Iota",
            "Kappa"
        ],
        "Eta": [
            "Kappa",
            "Lambda"
        ],
        "Theta": [
            "Lambda"
        ],
        "Iota": [
            "Mu"
        ],
        "Kappa": [
            "Mu"
        ],
        "Lambda": [
            "Mu"
        ],
        "Mu": []
    }
    return graph

private function calculateInDegrees( Map<String, MutableSequence<String>> graph ) -> Map<String, Int>:
    HashMap<String, Int> inDegrees = new HashMap<>()
    for String node, MutableSequence<String> edges in graph:
        if not inDegrees.containsKey( node ):
            inDegrees.put( node, 0 )
        for String target in edges:
            if not inDegrees.containsKey( target ):
                inDegrees.put( target, 0 )
            Int current = inDegrees.get( target )
            inDegrees.put( target, current + 1 )
    return inDegrees

private function performTopologicalSort( Map<String, MutableSequence<String>> graph, Map<String, Int> inDegrees ) -> MutableSequence<String>:
    MutableSequence<String> sortedList = new ArrayList<>()
    MutableSequence<String> queue = new ArrayList<>()
    Int queueSize = 0
    for String node, Int degree in inDegrees:
        if degree == 0:
            queue.add( node )
            queueSize = queueSize + 1
    Int head = 0
    while head < queueSize:
        String current = queue.get( head )
        head = head + 1
        sortedList.add( current )
        MutableSequence<String> neighbors = graph.get( current )
        if neighbors != None:
            for String neighbor in neighbors:
                Int newDegree = inDegrees.get( neighbor ) - 1
                inDegrees.put( neighbor, newDegree )
                if newDegree == 0:
                    queue.add( neighbor )
                    queueSize = queueSize + 1
    return sortedList

private function executeMathematicalAndLexicalStress() -> I64:
    puts( "Initiating Mathematical, Lexical, and Literal Stress Phase" )
    I64 faults = 0
    
    Set<String> uniqueSymbols = { "U", "r", "a", "n", "i", "t", "e" }
    MutableSequence<I64> matrixVector = [ 100, 200, 300 ]
    Map<String, I64> metrics = { "Core": 1, "Edge": 2 }
    
    puts( "Collection literals successfully allocated in memory" )
    
    I64 compoundValue = 5
    compoundValue += 10
    compoundValue -= 3
    compoundValue *= 2
    
    I64 rangeSum = 0
    for I64 iterator in 0..10:
        rangeSum += iterator
        
    I64 oddSum = 0
    for I64 step in 1...15:
        I64 remainder = step - ( step / 2 ) * 2
        if remainder == 0:
            continue
        oddSum += step
        if oddSum > 20:
            break
    
    Callable<I64,<I64>> callback = lambda I64 seed: seed * seed + oddSum
    
    I64 callbackResult = callback( 6 )
    
    function nestedStateMutator( I64 seed ) -> I64:
        return seed * seed + oddSum
    
    I64 nestedResult = nestedStateMutator( 6 )
    
    puts( "Lambda function execution resolved to: ", callbackResult )
    if callbackResult != 61:
        puts( "FAULT: Lambda function capture mismatch" )
        faults += 1
    
    puts( "Nested function execution resolved to: ", nestedResult )
    if nestedResult != 61:
        puts( "FAULT: Nested function capture mismatch" )
        faults += 1
    
    if ResonancePhase.Cascading.name != "Cascading":
        puts( "FAULT: Enum name property evaluation failed" )
        faults += 1
        
    if ResonancePhase.Cascading.value != 2.5:
        puts( "FAULT: Enum backed value property evaluation failed" )
        faults += 1
        
    if CardinalDirection.East.value != "E":
        puts( "FAULT: String-backed Enum value failed" )
        faults += 1

    return faults

private function executePolymorphicTreeStress() -> I64:
    puts( "Initiating Polymorphic Spatial Tree and Abstract Class Stress" )
    I64 faults = 0
    
    SystemConfiguration activeConfig = new SystemConfiguration( 8080, "localhost" )
    Vector2D structuralVector = new Vector2D( 3.0, 4.0 )
    
    PerfectSquare rootSquare = new PerfectSquare( 10 )
    PerfectCircle branchCircle = new PerfectCircle( 5 )
    
    SpatialTreeNode rootNode = new SpatialTreeNode( rootSquare )
    SpatialTreeNode branchLeft = new SpatialTreeNode( branchCircle )
    SpatialTreeNode branchRight = new SpatialTreeNode( new PerfectSquare( 5 ) )
    
    rootNode.leftBranch = branchLeft
    rootNode.rightBranch = branchRight
    
    I64 traitHash = rootNode.computeSpatialHash()
    puts( "Trait method resolution hash: ", traitHash )
    if traitHash != 1024:
        puts( "FAULT: Trait method dispatch failed" )
        faults += 1
        
    GeometricShape polymorphicShape = rootNode.nodeData.retrieve()
    if polymorphicShape.calculateArea() != 100:
        puts( "FAULT: Abstract class polymorphic virtual dispatch failed" )
        faults += 1
        
    delete branchLeft
    delete branchRight
    delete rootNode
    puts( "Spatial tree memory purged successfully" )
    
    return faults

private function performStressTestVolatility() -> I64:
    puts( "Initiating Volatility Stress Test and memory anomaly sequence" )
    I64 faults = 0
    defer puts( "Volatility stress test cleanup operations successfully deferred and completed" )
    ?QuantumVertex unstableNode = new QuantumVertex( "AnomalyMatrix", 999.9 )
    try:
        I64 fluctuationIndex = 0
        while fluctuationIndex < 5:
            fluctuationIndex += 1
            if fluctuationIndex == 4:
                raise new DimensionalCollapseException( "Critical dimensional strain detected at AnomalyMatrix", 101, None )
    except DimensionalCollapseException as ex:
        puts( "Intercepted DimensionalCollapseException, stabilizing memory continuum" )
    finally:
        delete unstableNode
    return faults

public function main() -> Void:
    puts( "Starting Supreme Compiler Verification..." )
    I64 startTotal = clock()
    
    I64 totalFaults = 0

    I64 startInit = clock()
    Map<String, MutableSequence<String>> network = initializeDataWarehouse()
    I64 endInit = clock()
    puts( "Phase 1: Literal Construction complete in {} seconds".format( ( endInit - startInit ) / 1000000.0 ) )

    I64 startDegree = clock()
    Map<String, Int> inDegrees = calculateInDegrees( network )
    I64 endDegree = clock()
    puts( "Phase 2: In-Degree mapping complete in {} seconds".format( ( endDegree - startDegree ) / 1000000.0 ) )

    I64 startSort = clock()
    MutableSequence<String> topologicalOrder = performTopologicalSort( network, inDegrees )
    I64 endSort = clock()
    puts( "Phase 3: Topological Sort complete in {} seconds".format( ( endSort - startSort ) / 1000000.0 ) )

    I64 startMath = clock()
    totalFaults += executeMathematicalAndLexicalStress()
    I64 endMath = clock()
    puts( "Phase 4: Mathematical, Literal & Enum Validation complete in {} seconds".format( ( endMath - startMath ) / 1000000.0 ) )

    I64 startPoly = clock()
    totalFaults += executePolymorphicTreeStress()
    I64 endPoly = clock()
    puts( "Phase 5: Abstract Polymorphism & Traits Validation complete in {} seconds".format( ( endPoly - startPoly ) / 1000000.0 ) )

    I64 startStress = clock()
    totalFaults += performStressTestVolatility()
    I64 endStress = clock()
    puts( "Phase 6: Volatility Sequence complete in {} seconds".format( ( endStress - startStress ) / 1000000.0 ) )

    I64 endTotal = clock()
    Double elapsedTotal = ( endTotal - startTotal ) / 1000000.0
    puts( "Total Analysis Time: {} seconds".format( elapsedTotal ) )
    
    if totalFaults == 0:
        puts( "VERDICT: TEST PASSED" )
    else:
        puts( "VERDICT: COMPILER BUGS PRESENT (Total faults: ", totalFaults, ")" )
