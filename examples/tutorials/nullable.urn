package uranite.examples.tutorials.nullable

from uranite.io.console import puts

public function main() -> I32:
    
    """
    The main entry point for the nullable types demonstration.
    
    Returns:
        I32 exit code.
    """
    
    ?String empty = None
    if empty == None:
        puts( "empty is None" )
    ?String greeting = "Hello"
    if greeting != None:
        puts( "greeting has a value" )
    ?String name = None
    if name == None:
        puts( "name starts as None" )
    name = "Alice"
    if name != None:
        puts( "name is now set" )
    return 0
