package main

from uranite.functions.runtime import uraniteSleep
from uranite.io.console import puts

async function taskA() -> Future<Void>:
    puts( "Task A: starting, sleeping 100ms..." )
    uraniteSleep( 100 )
    puts( "Task A: resumed and finished." )

async function taskB() -> Future<Void>:
    puts( "Task B: starting, sleeping 50ms..." )
    uraniteSleep( 50 )
    puts( "Task B: resumed and finished." )

async function taskC() -> Future<I64>:
    puts( "Task C: computing..." )
    uraniteSleep( 75 )
    puts( "Task C: done computing." )
    return 42

public async function main() -> Future<I32>:
    puts( "=== Uranite Event Loop Test ===" )

    # Spawn tasks without await — get Future handles
    Future<Void> a = taskA()
    Future<Void> b = taskB()
    Future<I64> c = taskC()

    puts( "Tasks spawned, awaiting results..." )

    await a
    puts( "Task A finished." )

    await b
    puts( "Task B finished." )

    I64 result = await c
    puts( "Task C result = ", result )

    puts( "All tasks finished." )
    return 0
