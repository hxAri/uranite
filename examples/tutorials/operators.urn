package main

from uranite.io.console import puts
from uranite.operators.addable import Addable
from uranite.operators.subtractable import Subtractable
from uranite.operators.multipliable import Multipliable
from uranite.operators.equatable import Equatable
from uranite.operators.negatable import Negatable

class Vector2 implements Addable<Vector2>, Subtractable<Vector2>, Multipliable<Vector2>, Equatable<Vector2>, Negatable<Vector2>:
    
    """ A 2D vector class with operator overloading """
    
    public F64 x
    public F64 y
    
    public function Vector2( self, F64 x, F64 y ):
        
        """
        Initializes a new Vector2 instance.
        
        Parameters:
            x: The x coordinate.
            y: The y coordinate.
        """
        
        self.x = x
        self.y = y
    
    public function add( self, Vector2 other ) -> Vector2:
        
        """
        Overloads the '+' operator.
        
        Parameters:
            other: The other Vector2 to add.
        
        Returns:
            A new Vector2 representing the sum.
        """
        
        return new Vector2( self.x + other.x, self.y + other.y )
    
    public function subtract( self, Vector2 other ) -> Vector2:
        
        """
        Overloads the '-' operator.
        
        Parameters:
            other: The other Vector2 to subtract.
        
        Returns:
            A new Vector2 representing the difference.
        """
        
        return new Vector2( self.x - other.x, self.y - other.y )
    
    public function multiply( self, Vector2 other ) -> Vector2:
        
        """
        Overloads the '*' operator.
        
        Parameters:
            other: The other Vector2 to multiply with.
        
        Returns:
            A new Vector2 representing the product.
        """
        
        return new Vector2( self.x * other.x, self.y * other.y )
    
    public function equals( self, Vector2 other ) -> Boolean:
        
        """
        Overloads the '==' operator.
        
        Parameters:
            other: The other Vector2 to compare with.
        
        Returns:
            True if components are equal, False otherwise.
        """
        
        return self.x == other.x and self.y == other.y

    public function notEquals( self, Vector2 other ) -> Boolean:
        return not( self.x == other.x and self.y == other.y )

    public function negate( self ) -> Vector2:
        
        """
        Overloads the unary '-' operator.
        
        Returns:
            A new Vector2 representing the negation.
        """
        
        return new Vector2( 0.0 - self.x, 0.0 - self.y )

public function main() -> I32:
    
    """
    The main entry point for the operator overloading demonstration.
    
    Returns:
        I32 exit code.
    """
    
    Vector2 a = new Vector2( 1.0, 2.0 )
    Vector2 b = new Vector2( 3.0, 4.0 )
    puts( "Operator overloading" )
    Vector2 sum = a + b
    puts( "(1,2) + (3,4) = (", sum.x, ", ", sum.y, ")" )
    Vector2 diff = a - b
    puts( "(1,2) - (3,4) = (", diff.x, ", ", diff.y, ")" )
    Vector2 prod = a * b
    puts( "(1,2) * (3,4) = (", prod.x, ", ", prod.y, ")" )
    Vector2 neg = -a
    puts( "-(1,2) = (", neg.x, ", ", neg.y, ")" )
    Boolean eq = a == b
    if eq:
        puts( "a == b: True" )
    else:
        puts( "a == b: False" )
    Boolean eq2 = a == a
    if eq2:
        puts( "a == a: True" )
    else:
        puts( "a == a: False" )
    return 0
