package main

from uranite.functions.runtime import {
    uraniteThreadCreate, 
    uraniteThreadJoin, 
    uraniteThreadDestroy, 
    uraniteThreadSleep, 
    uraniteMutexCreate, 
    uraniteMutexLock, 
    uraniteMutexUnlock, 
    uraniteMutexDestroy, 
    uraniteAtomicAdd, 
    uraniteAtomicLoad
}
from uranite.io.console import puts

function worker() -> Void:
    
    """ A simple worker function to be run in a separate thread """
    
    puts( "Hello from thread!" )

public function main() -> I32:
    
    """
    The main entry point for the threading test.
    
    Returns:
        I32 exit code.
    """
    
    puts( "=== Threading test ===" )

    # Test sleep
    puts( "Sleeping 50ms..." )
    uraniteThreadSleep( 50 )
    puts( "Awake." )

    return 0
