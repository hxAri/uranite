package fuck.you

from uranite.functions.runtime import uraniteAwaitFD, uraniteSleep
from uranite.io.console import puts

public function main( self ) -> Void:
    
    """
    Description of main.
    
    Parameters:
        self (Any): The self
    Returns:
        Void: Description of return value.
    Complexity:
        Time: O(1)
    """
    
	uraniteSleep( 1000 )
	puts( "Fuck You!" )
