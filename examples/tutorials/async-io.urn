package uranite.examples.tutorials.async-io

from uranite.errors.exception import Exception
from uranite.functions.runtime import uraniteSleep
from uranite.io.console import puts

async function slowCompute( I64 value, U64 delayMs ) -> Future<I64>:
    uraniteSleep( delayMs )
    return value * value

async function computeSum( I64 a, I64 b, U64 delayMs ) -> Future<I64>:
    uraniteSleep( delayMs )
    return a + b

async function pipeline( I64 input ) -> Future<I64>:
    I64 squared = await slowCompute( input, 50 )
    I64 result = await computeSum( squared, 10, 50 )
    return result

async function delayedFailure( U64 delayMs ) -> Future<I64>:
    uraniteSleep( delayMs )
    raise new Exception( "timed out after delay", 0, None )

public async function main() -> Future<I32>:
    I64 result = await slowCompute( 7, 100 )
    puts( "slowCompute(7) = ", result )
    I64 pipeResult = await pipeline( 5 )
    puts( "pipeline(5) = ", pipeResult )
    I64 first = await computeSum( 10, 20, 50 )
    I64 second = await computeSum( first, 5, 50 )
    puts( "chained sum = ", second )
    try:
        I64 value = await delayedFailure( 50 )
    except as catchedException:
        puts( "caught delayed error" )
    puts( "async-io complete" )
    return 0
