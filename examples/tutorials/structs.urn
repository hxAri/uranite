package uranite.examples.testing.structs

from uranite.io.console import puts


struct Vec3:
    
    """ A 3D vector struct with basic mathematical operations """
    
    public F64 x
    public F64 y
    public F64 z

    public function Vec3( self, F64 x, F64 y, F64 z ) -> Void:
        
        """
        Initializes a new Vec3 instance.
        
        Parameters:
            x: The x coordinate.
            y: The y coordinate.
            z: The z coordinate.
        """
        
        self.x = x
        self.y = y
        self.z = z

    public function magnitude_squared( self ) -> F64:
        
        """
        Calculates the squared magnitude of the vector.
        
        Returns:
            The squared magnitude.
        """
        
        return self.x * self.x + self.y * self.y + self.z * self.z

    public function sum( self ) -> F64:
        
        """
        Calculates the sum of the vector's components.
        
        Returns:
            The sum of x, y, and z.
        """
        
        return self.x + self.y + self.z

struct Color:
    
    """ A struct representing an RGB color """
    
    public I64 r
    public I64 g
    public I64 b

    public function Color( self, I64 r, I64 g, I64 b ) -> Void:
        
        """
        Initializes a new Color instance.
        
        Parameters:
            r: The red component (0-255).
            g: The green component (0-255).
            b: The blue component (0-255).
        """
        
        self.r = r
        self.g = g
        self.b = b

struct Rect:
    
    """ A struct representing a rectangle with integer dimensions """
    
    public I64 width
    public I64 height

    public function Rect( self, I64 w, I64 h ) -> Void:
        
        """
        Initializes a new Rect instance.
        
        Parameters:
            w: The width of the rectangle.
            h: The height of the rectangle.
        """
        
        self.width = w
        self.height = h

    public function area( self ) -> I64:
        
        """
        Calculates the area of the rectangle.
        
        Returns:
            The area as an I64.
        """
        
        return self.width * self.height

    public function perimeter( self ) -> I64:
        
        """
        Calculates the perimeter of the rectangle.
        
        Returns:
            The perimeter as an I64.
        """
        
        return 2 * ( self.width + self.height )

public function main() -> I32:
    
    """
    The main entry point for the struct demonstration.
    
    Returns:
        I32 exit code.
    """
    
    Vec3 v = new Vec3( 3.0, 4.0, 0.0 )
    puts( "Vec3(3, 4, 0) sum = ", v.sum() )
    puts( "Vec3(3, 4, 0) mag^2 = ", v.magnitude_squared() )

    Color c = new Color( 255, 128, 0 )
    puts( "Color(", c.r, ", ", c.g, ", ", c.b, ")" )

    Rect r = new Rect( 10, 5 )
    puts( "Rect ", r.width, "x", r.height, " area = ", r.area() )
    puts( "Rect ", r.width, "x", r.height, " perimeter = ", r.perimeter() )

    return 0
