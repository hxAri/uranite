package uranite.examples.tutorials.error

from uranite.errors.exception import Exception
from uranite.io.console import puts

public function safe_divide( I64 a, I64 b ) -> I64:
    if b == 0:
        raise new Exception( "division by zero", 0, None )
    return a / b

public function with_cleanup() -> Void:
    try:
        puts( "doing work..." )
        raise new Exception( "something went wrong", 0, None )
    except as e:
        puts( "error caught" )
    finally:
        puts( "cleanup always runs" )

public function nested_handling() -> Void:
    try:
        try:
            raise new Exception( "inner error", 0, None )
        except as e:
            puts( "inner handler caught it" )
        puts( "after inner try" )
    except as e:
        puts( "outer handler (should not reach)" )

public function main() -> I32:
    try:
        I64 result = safe_divide( 10, 0 )
        puts( "result = ", result )
    except as e:
        puts( "caught: division by zero" )
    try:
        I64 quotient = safe_divide( 100, 5 )
        puts( "100 / 5 = ", quotient )
    except as e:
        puts( "unexpected error" )
    puts( "\nWith cleanup:" )
    with_cleanup()
    puts( "\nNested handling:" )
    nested_handling()
    return 0
