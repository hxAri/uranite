package main

from uranite.errors.exception import Exception
from uranite.io.console import puts

async function fetchValue() -> Future<I64>:
    return 42

async function multiply( I64 a, I64 b ) -> Future<I64>:
    return a * b

async function pipeline( I64 x ) -> Future<I64>:
    I64 doubled = await multiply( x, 2 )
    I64 base = await fetchValue()
    return doubled + base

async function safeDivide( I64 a, I64 b ) -> Future<I64>:
    if b == 0:
        raise new Exception( "division by zero", 0, None )
    return a / b

async function logMessage( String msg ) -> Future<Void>:
    puts( msg )

class DataStore:
    
    public I64 base
    
    public function DataStore( self, I64 base ) -> Void:
        self.base = base
    
    public async function load( self, I64 id ) -> Future<I64>:
        return self.base + id
    
    public async function transform( self, I64 value ) -> Future<I64>:
        I64 loaded = await self.load( value )
        return loaded * 3

public async function main() -> Future<I32>:
    I64 val = await fetchValue()
    puts( "fetchValue = ", val )
    I64 product = await multiply( 6, 7 )
    puts( "multiply(6, 7) = ", product )
    I64 result = await pipeline( 10 )
    puts( "pipeline(10) = ", result )
    I64 nested = await multiply( await fetchValue(), 3 )
    puts( "nested = ", nested )
    await logMessage( "async void works" )
    try:
        I64 good = await safeDivide( 100, 5 )
        puts( "100 / 5 = ", good )
        I64 bad = await safeDivide( 10, 0 )
    except as e:
        puts( "caught async division error" )
    DataStore store = new DataStore( 1000 )
    I64 transformed = await store.transform( 5 )
    puts( "store.transform(5) = ", transformed )
    Future<I64> pending = multiply( 10, 10 )
    I64 pendingResult = await pending
    puts( "pending = ", pendingResult )
    puts( "all async tests passed" )
    return 0
