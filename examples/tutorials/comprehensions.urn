package uranite.examples.tutorials.comprehensions

from uranite.io.console import puts

public function main() -> I32:
    puts( "Basic comprehension" )
    I64 a = [i for I64 i in 0...4][0]
    I64 b = [i for I64 i in 0...4][1]
    I64 c = [i for I64 i in 0...4][2]
    puts( "Identity: ", a, " ", b, " ", c )
    puts( "\nSquares" )
    I64 s0 = [i * i for I64 i in 0...4][0]
    I64 s1 = [i * i for I64 i in 0...4][1]
    I64 s2 = [i * i for I64 i in 0...4][2]
    I64 s3 = [i * i for I64 i in 0...4][3]
    puts( "Squares: ", s0, " ", s1, " ", s2, " ", s3 )
    puts( "\nFiltered (evens only)" )
    I64 e0 = [i for I64 i in 0...9 if i % 2 == 0][0]
    I64 e1 = [i for I64 i in 0...9 if i % 2 == 0][1]
    I64 e2 = [i for I64 i in 0...9 if i % 2 == 0][2]
    puts( "Evens: ", e0, " ", e1, " ", e2 )
    puts( "\nTransformed + filtered" )
    I64 t0 = [i * i for I64 i in 1...10 if i % 3 == 0][0]
    I64 t1 = [i * i for I64 i in 1...10 if i % 3 == 0][1]
    puts( "Squares of multiples of 3: ", t0, " ", t1 )
    return 0
