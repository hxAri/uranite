package uranite.examples.testing

from uranite.collection import ArrayList, Generator, HashMap, HashSet, Pair, Tuple
from uranite.functions.builtin import enumerate
from uranite.io import getpass, input, puts
from uranite.iterators import Iterable

private function generator( Int start, Int end ) -> Generator<Int>:
	for Int i in start..end:
		yield i

private async function printer( Iterable<Int> items ) -> Future<Void>:
	for Int i, Int n in enumerate<Int>( items, 1 ):
		puts( "Item: {} at index {}".format( n, i ) )

public function main() -> Void:
	ArrayList<Int> items = []
	Generator<Int> gen = generator( 1, 10 )
	for Int i in generator( 1, 10 ):
		items.append( i )
	printer( items )
